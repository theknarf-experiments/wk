package wk:sequencer;

/// A step sequencer / piano roll. A grid of pitches × time-steps: click a cell
/// to place a note. The transport has two buttons — Play loops the pattern,
/// emitting the notes in each column out of a wk:midi output port (wire it to a
/// synth to hear it); Record does the same but also listens on the wk:midi
/// input port, quantising every incoming note onto the playhead's step (a live
/// overdub) while passing the notes straight through to the output. The surface
/// draws the roll, the active cells and a moving playhead. Combines wasi-gfx
/// (UI) with wk:midi (note transport in and out) and wk:options (the saved
/// pattern).
world sequencer {
    import wasi:surface/surface@0.0.1;
    import wasi:graphics-context/graphics-context@0.0.1;
    import wasi:frame-buffer/frame-buffer@0.0.1;
    import wk:midi/midi;
    import wk:options/options;

    export run: func();
}
