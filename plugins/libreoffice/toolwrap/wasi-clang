#!/bin/sh
# clang for the LibreOffice wasip2 build, minus two flags wasm-component-ld
# cannot take.
#
# solenv/gbuild/platform/unxgcc.mk:155-166 wraps every link's library list in
# -Wl,--start-group ... -Wl,--end-group. wasm-component-ld rejects both:
#
#     error: unexpected argument '--start-group' found
#
# and no equivalent exists, because wasm-ld resolves archives to a fixpoint
# instead of in command-line order — the circular-dependency problem that
# --start-group solves does not arise. Dropping them is correct, not a
# workaround.
#
# This is a wrapper rather than an override of gb_LinkTarget__command_* in
# WASI_INTEL_GCC.mk so the port does not carry ~60 lines of copied upstream link
# recipe that would drift on every rebase. The cost is that CC/CXX are scripts,
# which configure records verbatim into config_host.mk — hence the absolute path
# resolved at configure time.
# Resolve the SDK ourselves when the environment does not carry it. This is
# not belt-and-braces: configure records CC/CXX into config_host.mk as this
# script's path, so `make` run by hand in a module directory — the normal
# LibreOffice inner loop — invokes it with whatever environment that shell has.
# Failing there would look like a compiler bug rather than a missing variable.
if [ -z "${WASI_SDK:-}" ]; then
    if command -v mise >/dev/null 2>&1; then
        WASI_SDK=$(mise where github:WebAssembly/wasi-sdk 2>/dev/null)
    fi
    : "${WASI_SDK:=$HOME/.local/share/mise/installs/github-web-assembly-wasi-sdk/wasi-sdk-34-rc.2}"
fi
[ -x "$WASI_SDK/bin/clang" ] || {
    echo "wasi-clang: no wasi-sdk at $WASI_SDK (set WASI_SDK, or mise install)" >&2
    exit 1
}
for arg do
    case "$arg" in
    -Wl,--start-group|-Wl,--end-group|--start-group|--end-group) ;;
    # -pthread implies --shared-memory on wasm, which fails outright:
    #   wasm-ld: error: --shared-memory is disallowed by errno.c.obj because it
    #   was not compiled with 'atomics' or 'bulk-memory' features
    # It arrives from PTHREAD_CFLAGS inside unxgcc.mk's gb_OSDEFS and reaches
    # every external's own configure, where no gbuild variable can be cleared
    # to stop it. wasip2 has no threads, so the flag has nothing to mean here.
    -pthread) ;;
    *) set -- "$@" "$arg" ;;
    esac
    shift
done
# wasi-libc keeps mmap, signal, the process clocks and getpid behind opt-in
# shim libraries, and they are needed by whoever LINKS, not by whoever compiles.
# gbuild's own links get them from WASI_INTEL_GCC.mk, but an external's configure
# runs its own link steps that gbuild never sees — libxml2's xmllint fails on
# undefined mmap/munmap — and LDFLAGS cannot be used to reach them, because
# gbuild treats a non-empty LDFLAGS as a REPLACEMENT for its own handling
# rather than an addition.
#
# So they are appended here, and only on a link: a compile-only invocation
# would merely warn that the -l is unused, but the noise would be in every
# build log forever. Duplicates on gbuild's own links are harmless for -l.
link=1
for arg do
    case "$arg" in
    -c|-E|-S|-M|-MM) link=0 ;;
    esac
done
if [ "$link" = 1 ]; then
    set -- "$@" -lwasi-emulated-signal -lwasi-emulated-mman \
        -lwasi-emulated-process-clocks -lwasi-emulated-getpid
fi

exec "$WASI_SDK/bin/clang" "$@"
