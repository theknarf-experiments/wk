diff --git a/vcl/wk/wkcompositor.cxx b/vcl/wk/wkcompositor.cxx
new file mode 100644
index 000000000..0ff5fdf62
--- /dev/null
+++ b/vcl/wk/wkcompositor.cxx
@@ -0,0 +1,142 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * This file is part of the LibreOffice project.
+ *
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/.
+ */
+
+/*
+ * Flattening VCL's frames into wk's one surface.
+ *
+ * A wk node has exactly one surface: no child windows, no popups, no
+ * decorations. VCL has the opposite arrangement -- every menu, tooltip, dialog
+ * and floating toolbar is its own SalFrame with its own cairo surface, placed
+ * in a shared screen coordinate space. Something has to flatten one into the
+ * other, and that is this file. It is the role QFbScreen plays for Qt
+ * (plugins/qt/qpa/qwkcompositor.cpp is the same three steps in Qt's vocabulary).
+ *
+ * Order is creation order, which is also back-to-front: VCL creates a popup
+ * after the window it belongs to, and a dialog after the document window it
+ * covers. That is not guaranteed by anything, but nothing in Impress has yet
+ * produced a counter-example, and the alternative -- tracking z-order through
+ * ToTop and SetAlwaysOnTop -- can wait until something looks wrong.
+ *
+ * Pixels: cairo gives us premultiplied ARGB32, and --enable-cairo-rgba makes
+ * that [r,g,b,a] in memory order, which is exactly what wkgfx_present wants.
+ * So the common case -- an opaque frame, alpha 255 -- is a straight row copy,
+ * and only genuinely translucent pixels need the compositing arithmetic below.
+ */
+
+#include <vcl/wk/wkcompositor.hxx>
+
+#include <headless/svpframe.hxx>
+#include <sal/log.hxx>
+
+#include <cairo.h>
+#include <wkgfx.h>
+
+#include <algorithm>
+#include <cstring>
+
+namespace vcl::wk
+{
+namespace
+{
+// Composite one premultiplied RGBA source row over a destination row.
+// Both are [r,g,b,a]; the destination is opaque, so its alpha stays 255.
+void blendRow(sal_uInt8* pDst, const sal_uInt8* pSrc, int nPixels)
+{
+    for (int i = 0; i < nPixels; ++i, pDst += 4, pSrc += 4)
+    {
+        const sal_uInt8 nAlpha = pSrc[3];
+        if (nAlpha == 255)
+        {
+            pDst[0] = pSrc[0];
+            pDst[1] = pSrc[1];
+            pDst[2] = pSrc[2];
+        }
+        else if (nAlpha != 0)
+        {
+            // Source is premultiplied, so this is src + dst*(1-a).
+            const int nInv = 255 - nAlpha;
+            pDst[0] = static_cast<sal_uInt8>(pSrc[0] + (pDst[0] * nInv + 127) / 255);
+            pDst[1] = static_cast<sal_uInt8>(pSrc[1] + (pDst[1] * nInv + 127) / 255);
+            pDst[2] = static_cast<sal_uInt8>(pSrc[2] + (pDst[2] * nInv + 127) / 255);
+        }
+        pDst[3] = 255;
+    }
+}
+}
+
+void Compositor::composite(const std::vector<SvpSalFrame*>& rFrames)
+{
+    // The surface the host gave us. It is resize-authoritative and may have
+    // changed since the last frame, so this is re-read every time rather than
+    // cached.
+    const int nWidth = static_cast<int>(wkgfx_width());
+    const int nHeight = static_cast<int>(wkgfx_height());
+    if (nWidth <= 0 || nHeight <= 0)
+        return;
+
+    const size_t nNeeded = static_cast<size_t>(nWidth) * nHeight * 4;
+    if (m_aBuffer.size() != nNeeded)
+        m_aBuffer.resize(nNeeded);
+
+    // Opaque mid-grey rather than black: anything that shows through is a
+    // compositing bug, and it should look like one rather than like a border.
+    for (size_t i = 0; i < nNeeded; i += 4)
+    {
+        m_aBuffer[i] = 0x30;
+        m_aBuffer[i + 1] = 0x30;
+        m_aBuffer[i + 2] = 0x30;
+        m_aBuffer[i + 3] = 0xff;
+    }
+
+    for (SvpSalFrame* pFrame : rFrames)
+    {
+        if (!pFrame->isVisible())
+            continue;
+        cairo_surface_t* pSurface = pFrame->GetSurface();
+        if (!pSurface || cairo_surface_status(pSurface) != CAIRO_STATUS_SUCCESS)
+            continue;
+
+        cairo_surface_flush(pSurface);
+        const sal_uInt8* pSrcBase = cairo_image_surface_get_data(pSurface);
+        if (!pSrcBase)
+            continue;
+
+        const int nSrcStride = cairo_image_surface_get_stride(pSurface);
+        const int nSrcWidth = cairo_image_surface_get_width(pSurface);
+        const int nSrcHeight = cairo_image_surface_get_height(pSurface);
+
+        const SalFrameGeometry aGeom = pFrame->GetUnmirroredGeometry();
+        const int nLeft = static_cast<int>(aGeom.x());
+        const int nTop = static_cast<int>(aGeom.y());
+
+        // Clip to the surface. A frame may legitimately hang off the edge --
+        // VCL places popups against a screen whose size it believes, and the
+        // host may have shrunk us since.
+        const int nX0 = std::max(0, nLeft);
+        const int nY0 = std::max(0, nTop);
+        const int nX1 = std::min(nWidth, nLeft + nSrcWidth);
+        const int nY1 = std::min(nHeight, nTop + nSrcHeight);
+        if (nX0 >= nX1 || nY0 >= nY1)
+            continue;
+
+        for (int y = nY0; y < nY1; ++y)
+        {
+            const sal_uInt8* pSrc = pSrcBase + static_cast<size_t>(y - nTop) * nSrcStride
+                                    + static_cast<size_t>(nX0 - nLeft) * 4;
+            sal_uInt8* pDst = m_aBuffer.data() + (static_cast<size_t>(y) * nWidth + nX0) * 4;
+            blendRow(pDst, pSrc, nX1 - nX0);
+        }
+    }
+
+    wkgfx_present(m_aBuffer.data(), static_cast<uint32_t>(nWidth),
+                  static_cast<uint32_t>(nHeight));
+}
+}
+
+/* vim:set shiftwidth=4 softtabstop=4 expandtab: */
diff --git a/vcl/wk/wkinput.cxx b/vcl/wk/wkinput.cxx
new file mode 100644
index 000000000..51f1d7d23
--- /dev/null
+++ b/vcl/wk/wkinput.cxx
@@ -0,0 +1,315 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * This file is part of the LibreOffice project.
+ *
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/.
+ */
+
+/*
+ * wk's input events, in VCL's vocabulary.
+ *
+ * wk delivers one flat event struct per input, pulled rather than pushed, in
+ * ONE surface-local coordinate space -- there are no child windows to address.
+ * VCL wants events delivered to the SalFrame that owns the point, in that
+ * frame's own coordinates, which is why routing is the first thing that
+ * happens here and not an afterthought: a click on an open menu belongs to the
+ * menu's frame, and sending it to the document window instead is how a menu
+ * that draws correctly still cannot be used.
+ *
+ * The key story is two fields, not one. wkgfx gives `key`, which physical key
+ * was pressed (a W3C UIEvents `code` -- WASD stays WASD on AZERTY), and `ch`,
+ * what it types (layout- and shift-aware). VCL wants both as well:
+ * SalKeyEvent::mnCode is the key and mnCharCode is the character. Using `ch`
+ * for both would break every accelerator on a non-US layout; using `key` for
+ * both would type the wrong letters.
+ */
+
+#include <vcl/wk/wkinput.hxx>
+
+#include <headless/svpframe.hxx>
+#include <vcl/event.hxx>
+#include <vcl/keycodes.hxx>
+#include <sal/log.hxx>
+
+#include <cmath>
+
+namespace vcl::wk
+{
+namespace
+{
+/// WKGFX_K_* (W3C UIEvents code names) to VCL's KEY_*.
+///
+/// Transcribed from plugins/qt/qpa/qwkkeytranslator.cpp, which does the same
+/// job for Qt against the same enum. Only keys VCL has a code for appear; the
+/// rest fall through to 0, which is correct -- a key with no VCL code is still
+/// delivered, carrying only its character, which is what typing needs.
+sal_uInt16 toVclKey(int32_t nWkKey)
+{
+    switch (nWkKey)
+    {
+        case WKGFX_K_DIGIT0: return KEY_0;
+        case WKGFX_K_DIGIT1: return KEY_1;
+        case WKGFX_K_DIGIT2: return KEY_2;
+        case WKGFX_K_DIGIT3: return KEY_3;
+        case WKGFX_K_DIGIT4: return KEY_4;
+        case WKGFX_K_DIGIT5: return KEY_5;
+        case WKGFX_K_DIGIT6: return KEY_6;
+        case WKGFX_K_DIGIT7: return KEY_7;
+        case WKGFX_K_DIGIT8: return KEY_8;
+        case WKGFX_K_DIGIT9: return KEY_9;
+
+        case WKGFX_K_KEY_A: return KEY_A;
+        case WKGFX_K_KEY_B: return KEY_B;
+        case WKGFX_K_KEY_C: return KEY_C;
+        case WKGFX_K_KEY_D: return KEY_D;
+        case WKGFX_K_KEY_E: return KEY_E;
+        case WKGFX_K_KEY_F: return KEY_F;
+        case WKGFX_K_KEY_G: return KEY_G;
+        case WKGFX_K_KEY_H: return KEY_H;
+        case WKGFX_K_KEY_I: return KEY_I;
+        case WKGFX_K_KEY_J: return KEY_J;
+        case WKGFX_K_KEY_K: return KEY_K;
+        case WKGFX_K_KEY_L: return KEY_L;
+        case WKGFX_K_KEY_M: return KEY_M;
+        case WKGFX_K_KEY_N: return KEY_N;
+        case WKGFX_K_KEY_O: return KEY_O;
+        case WKGFX_K_KEY_P: return KEY_P;
+        case WKGFX_K_KEY_Q: return KEY_Q;
+        case WKGFX_K_KEY_R: return KEY_R;
+        case WKGFX_K_KEY_S: return KEY_S;
+        case WKGFX_K_KEY_T: return KEY_T;
+        case WKGFX_K_KEY_U: return KEY_U;
+        case WKGFX_K_KEY_V: return KEY_V;
+        case WKGFX_K_KEY_W: return KEY_W;
+        case WKGFX_K_KEY_X: return KEY_X;
+        case WKGFX_K_KEY_Y: return KEY_Y;
+        case WKGFX_K_KEY_Z: return KEY_Z;
+
+        case WKGFX_K_F1: return KEY_F1;
+        case WKGFX_K_F2: return KEY_F2;
+        case WKGFX_K_F3: return KEY_F3;
+        case WKGFX_K_F4: return KEY_F4;
+        case WKGFX_K_F5: return KEY_F5;
+        case WKGFX_K_F6: return KEY_F6;
+        case WKGFX_K_F7: return KEY_F7;
+        case WKGFX_K_F8: return KEY_F8;
+        case WKGFX_K_F9: return KEY_F9;
+        case WKGFX_K_F10: return KEY_F10;
+        case WKGFX_K_F11: return KEY_F11;
+        case WKGFX_K_F12: return KEY_F12;
+
+        case WKGFX_K_ARROW_DOWN: return KEY_DOWN;
+        case WKGFX_K_ARROW_UP: return KEY_UP;
+        case WKGFX_K_ARROW_LEFT: return KEY_LEFT;
+        case WKGFX_K_ARROW_RIGHT: return KEY_RIGHT;
+        case WKGFX_K_HOME: return KEY_HOME;
+        case WKGFX_K_END: return KEY_END;
+        case WKGFX_K_PAGE_UP: return KEY_PAGEUP;
+        case WKGFX_K_PAGE_DOWN: return KEY_PAGEDOWN;
+        case WKGFX_K_ENTER: return KEY_RETURN;
+        case WKGFX_K_NUMPAD_ENTER: return KEY_RETURN;
+        case WKGFX_K_ESCAPE: return KEY_ESCAPE;
+        case WKGFX_K_TAB: return KEY_TAB;
+        case WKGFX_K_BACKSPACE: return KEY_BACKSPACE;
+        case WKGFX_K_SPACE: return KEY_SPACE;
+        case WKGFX_K_INSERT: return KEY_INSERT;
+        case WKGFX_K_DELETE: return KEY_DELETE;
+
+        case WKGFX_K_NUMPAD_ADD: return KEY_ADD;
+        case WKGFX_K_NUMPAD_SUBTRACT: return KEY_SUBTRACT;
+        case WKGFX_K_NUMPAD_MULTIPLY: return KEY_MULTIPLY;
+        case WKGFX_K_NUMPAD_DIVIDE: return KEY_DIVIDE;
+        case WKGFX_K_PERIOD: return KEY_POINT;
+        case WKGFX_K_COMMA: return KEY_COMMA;
+        case WKGFX_K_MINUS: return KEY_SUBTRACT;
+        case WKGFX_K_EQUAL: return KEY_EQUAL;
+        case WKGFX_K_SEMICOLON: return KEY_SEMICOLON;
+        case WKGFX_K_QUOTE: return KEY_QUOTERIGHT;
+        case WKGFX_K_BRACKET_LEFT: return KEY_BRACKETLEFT;
+        case WKGFX_K_BRACKET_RIGHT: return KEY_BRACKETRIGHT;
+        case WKGFX_K_SLASH: return KEY_DIVIDE;
+        case WKGFX_K_BACKQUOTE: return KEY_QUOTELEFT;
+        // No KEY_BACKSLASH in VCL: the physical key has no code of its own, so
+        // it falls through to 0 below and arrives carrying only its character,
+        // which is all that typing one needs.
+
+        default: return 0;
+    }
+}
+
+/// The modifier half of VCL's key code, shared by key and mouse events.
+sal_uInt16 modifiers(const wkgfx_event& rEv)
+{
+    sal_uInt16 nCode = 0;
+    if (rEv.shift)
+        nCode |= KEY_SHIFT;
+    // MOD1 is the accelerator modifier. wk reports ctrl and meta separately and
+    // VCL's MOD1/MOD3 split is per-platform; ctrl is MOD1 here because that is
+    // what the menus this build shows are labelled with.
+    if (rEv.ctrl)
+        nCode |= KEY_MOD1;
+    if (rEv.alt)
+        nCode |= KEY_MOD2;
+    if (rEv.meta)
+        nCode |= KEY_MOD3;
+    return nCode;
+}
+}
+
+SvpSalFrame* Router::frameAt(const std::vector<SvpSalFrame*>& rFrames, double fX, double fY)
+{
+    // Front to back: the compositor paints in creation order, so the last
+    // visible frame containing the point is the one on top and the one that
+    // owns the click.
+    for (auto it = rFrames.rbegin(); it != rFrames.rend(); ++it)
+    {
+        SvpSalFrame* pFrame = *it;
+        if (!pFrame->isVisible())
+            continue;
+        const SalFrameGeometry aGeom = pFrame->GetUnmirroredGeometry();
+        const double fLeft = static_cast<double>(aGeom.x());
+        const double fTop = static_cast<double>(aGeom.y());
+        if (fX >= fLeft && fY >= fTop && fX < fLeft + aGeom.width()
+            && fY < fTop + aGeom.height())
+        {
+            return pFrame;
+        }
+    }
+    return nullptr;
+}
+
+void Router::dispatch(const std::vector<SvpSalFrame*>& rFrames, const wkgfx_event& rEv)
+{
+    switch (rEv.type)
+    {
+        case WKGFX_POINTER_MOVE:
+        case WKGFX_POINTER_DOWN:
+        case WKGFX_POINTER_UP:
+        {
+            SvpSalFrame* pFrame = frameAt(rFrames, rEv.x, rEv.y);
+            if (!pFrame)
+                return;
+            const SalFrameGeometry aGeom = pFrame->GetUnmirroredGeometry();
+
+            // Which buttons are held is state, not part of the event: wk sends
+            // the button that changed, and VCL wants the whole set on every
+            // event including moves.
+            if (rEv.type == WKGFX_POINTER_DOWN || rEv.type == WKGFX_POINTER_UP)
+            {
+                const sal_uInt16 nBit = rEv.button == 0   ? MOUSE_LEFT
+                                        : rEv.button == 1 ? MOUSE_MIDDLE
+                                        : rEv.button == 2 ? MOUSE_RIGHT
+                                                          : 0;
+                if (rEv.type == WKGFX_POINTER_DOWN)
+                    m_nButtons |= nBit;
+                else
+                    m_nButtons &= ~nBit;
+            }
+
+            SalMouseEvent aEvent;
+            aEvent.mnTime = 0;
+            aEvent.mnX = static_cast<tools::Long>(rEv.x) - aGeom.x();
+            aEvent.mnY = static_cast<tools::Long>(rEv.y) - aGeom.y();
+            aEvent.mnCode = m_nButtons | modifiers(rEv);
+            aEvent.mnButton = rEv.type == WKGFX_POINTER_MOVE
+                                  ? 0
+                                  : (rEv.button == 0   ? MOUSE_LEFT
+                                     : rEv.button == 1 ? MOUSE_MIDDLE
+                                     : rEv.button == 2 ? MOUSE_RIGHT
+                                                       : 0);
+
+            // A frame that has just been entered gets the focus. wk has no
+            // focus event of its own -- there is one surface and it either has
+            // the host's focus or the node is not being interacted with -- so
+            // the frame under the pointer standing in for it is the closest
+            // thing to what VCL expects, and it is what makes a menu take key
+            // input once opened.
+            if (pFrame != m_pMouseFrame)
+            {
+                if (m_pMouseFrame)
+                    m_pMouseFrame->CallCallback(SalEvent::MouseLeave, &aEvent);
+                m_pMouseFrame = pFrame;
+            }
+
+            const SalEvent eType = rEv.type == WKGFX_POINTER_MOVE ? SalEvent::MouseMove
+                                   : rEv.type == WKGFX_POINTER_DOWN
+                                       ? SalEvent::MouseButtonDown
+                                       : SalEvent::MouseButtonUp;
+            pFrame->CallCallback(eType, &aEvent);
+            break;
+        }
+
+        case WKGFX_SCROLL:
+        {
+            SvpSalFrame* pFrame = frameAt(rFrames, rEv.x, rEv.y);
+            if (!pFrame)
+                return;
+            const SalFrameGeometry aGeom = pFrame->GetUnmirroredGeometry();
+
+            // wk's deltas are in lines, which is what VCL calls a notch. Both
+            // axes can move in one event; VCL takes one axis per event.
+            auto send = [&](double fDelta, bool bHorz) {
+                if (fDelta == 0.0)
+                    return;
+                SalWheelMouseEvent aEvent;
+                aEvent.mnTime = 0;
+                aEvent.mnX = static_cast<tools::Long>(rEv.x) - aGeom.x();
+                aEvent.mnY = static_cast<tools::Long>(rEv.y) - aGeom.y();
+                aEvent.mnCode = m_nButtons | modifiers(rEv);
+                aEvent.mnDelta = static_cast<tools::Long>(fDelta * -120.0);
+                aEvent.mnNotchDelta = fDelta < 0 ? 1 : -1;
+                aEvent.mnScrollLines = std::abs(fDelta);
+                aEvent.mbHorz = bHorz;
+                aEvent.mbDeltaIsPixel = false;
+                pFrame->CallCallback(SalEvent::WheelMouse, &aEvent);
+            };
+            send(rEv.dy, false);
+            send(rEv.dx, true);
+            break;
+        }
+
+        case WKGFX_KEY_DOWN:
+        case WKGFX_KEY_UP:
+        {
+            // To the frame the pointer last visited, which for a menu is the
+            // menu. Falls back to the last visible frame, so a keystroke before
+            // the mouse has ever moved still lands somewhere sensible.
+            SvpSalFrame* pFrame = m_pMouseFrame;
+            if (!pFrame)
+            {
+                for (auto it = rFrames.rbegin(); it != rFrames.rend(); ++it)
+                {
+                    if ((*it)->isVisible())
+                    {
+                        pFrame = *it;
+                        break;
+                    }
+                }
+            }
+            if (!pFrame)
+                return;
+
+            SalKeyEvent aEvent;
+            aEvent.mnCode = toVclKey(rEv.key) | modifiers(rEv);
+            // Not the character when a command modifier is held: Ctrl+S must
+            // arrive as the S key and not as U+0013, or every accelerator turns
+            // into a control character in the document.
+            aEvent.mnCharCode = (rEv.ctrl || rEv.meta) ? 0 : static_cast<sal_uInt16>(rEv.ch);
+            aEvent.mnRepeat = 0;
+            pFrame->CallCallback(rEv.type == WKGFX_KEY_DOWN ? SalEvent::KeyInput
+                                                            : SalEvent::KeyUp,
+                                 &aEvent);
+            break;
+        }
+
+        case WKGFX_RESIZE:
+        case WKGFX_NONE:
+        default:
+            break;
+    }
+}
+}
+
