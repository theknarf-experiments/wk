@@ -0,0 +1,33 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * This file is part of the LibreOffice project.
+ *
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/.
+ */
+
+#pragma once
+
+#include <sal/types.h>
+
+#include <vector>
+
+class SvpSalFrame;
+
+namespace vcl::wk
+{
+/** Flattens VCL's per-frame cairo surfaces into the single RGBA8 buffer a wk
+    node presents. See wkcompositor.cxx for why that is necessary at all. */
+class Compositor
+{
+    std::vector<sal_uInt8> m_aBuffer;
+
+public:
+    /** Composite every visible frame, back to front, and present the result.
+        @param rFrames frames in creation order, which is the paint order. */
+    void composite(const std::vector<SvpSalFrame*>& rFrames);
+};
+}
