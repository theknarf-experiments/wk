--- /dev/null
+++ b/vcl/wk/wkinst.cxx
@@ -0,0 +1,273 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * This file is part of the LibreOffice project.
+ *
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/.
+ */
+
+/*
+ * The VCL backend for wk, LibreOffice running as a wasm component.
+ *
+ * It is built into libvcl rather than loaded as a plugin, the way iOS and
+ * Android are: there is no dlopen on wasip2, so configure names this the one
+ * and only VCL plugin (VCL_PLUGIN_INFO=wk) and salplug.cxx reaches it through
+ * the STATIC_SAL_INSTANCE path -- a direct call to create_SalInstance() below.
+ *
+ * It descends from SvpSalInstance because vcl/headless is already almost all of
+ * what a wasm component needs: cairo drawing into an image surface, freetype
+ * and fontconfig for glyphs, and no assumption of a windowing system. What
+ * headless does not have is anywhere to put the pixels or anywhere to get input
+ * from. This file is growing into that.
+ *
+ * What is here now is the frame register: every SalFrame LibreOffice creates,
+ * in creation order, with the surface it draws into. A compositor needs exactly
+ * that list -- VCL gives each menu, tooltip and dialog its own frame, so
+ * presenting "the window" means presenting a stack of them -- and so does
+ * hit-testing input, which arrives in one surface-local coordinate space and has
+ * to be routed to whichever frame owns that point.
+ *
+ * Until the wk surface is wired up, the register can be dumped to PNG:
+ *
+ *     WK_LO_DUMP_FRAMES=/work/frame   write /work/frame-N.png per visible frame
+ *     WK_LO_DUMP_AFTER=<n>            do it after n yields, then quit
+ *
+ * which is how this backend is tested at all before it can present anything.
+ */
+
+#include <headless/svpinst.hxx>
+#include <headless/svpframe.hxx>
+#include <headless/svpdummies.hxx>
+#include <headless/svpdata.hxx>
+
+#include <vcl/svapp.hxx>
+#include <sal/log.hxx>
+#include <rtl/ustrbuf.hxx>
+
+#include <vcl/wk/wkcompositor.hxx>
+#include <vcl/wk/wkinput.hxx>
+
+#include <cairo.h>
+#include <wkgfx.h>
+
+#include <algorithm>
+#include <cstdlib>
+#include <vector>
+
+namespace
+{
+class WkSalInstance : public SvpSalInstance
+{
+    // Creation order, which is also back-to-front order: VCL creates a popup
+    // after the window it belongs to. Good enough to composite by until
+    // something proves otherwise.
+    std::vector<SvpSalFrame*> m_aFrames;
+
+    vcl::wk::Compositor m_aCompositor;
+    vcl::wk::Router m_aRouter;
+    bool m_bSurfaceOpen = false;
+    bool m_bPresented = false;
+
+    OString m_aDumpPath;
+    int m_nDumpAfter = 0;
+    int m_nYields = 0;
+
+public:
+    explicit WkSalInstance(std::unique_ptr<SalYieldMutex> pMutex)
+        : SvpSalInstance(std::move(pMutex))
+    {
+        if (const char* pPath = std::getenv("WK_LO_DUMP_FRAMES"))
+            m_aDumpPath = OString(pPath, strlen(pPath));
+        if (const char* pAfter = std::getenv("WK_LO_DUMP_AFTER"))
+            m_nDumpAfter = std::atoi(pAfter);
+    }
+
+    virtual SalFrame* CreateFrame(SalFrame* pParent, SalFrameStyleFlags nStyle) override;
+    virtual SalFrame* CreateChildFrame(SystemParentData* pParent,
+                                       SalFrameStyleFlags nStyle) override;
+    virtual void DestroyFrame(SalFrame* pFrame) override;
+    virtual bool DoYield(bool bWait, bool bHandleAllCurrentEvents) override;
+
+    virtual SalSystem* CreateSalSystem() override;
+
+    const std::vector<SvpSalFrame*>& frames() const { return m_aFrames; }
+
+private:
+    void dumpFrames();
+    void present();
+    void resizeTo(uint32_t nWidth, uint32_t nHeight);
+};
+
+class WkSalSystem : public SvpSalSystem
+{
+public:
+    WkSalSystem()
+        : SvpSalSystem()
+    {
+    }
+
+    virtual int ShowNativeDialog(const OUString& rTitle, const OUString& rMessage,
+                                 const std::vector<OUString>& rButtons) override
+    {
+        // Nowhere to show it yet. Logged rather than ignored because a native
+        // dialog here is always an error LibreOffice wanted a human to read --
+        // a broken user profile, an unreadable install -- and silently
+        // returning 0 turns that into behaviour with no explanation.
+        (void)rButtons;
+        SAL_WARN("vcl.wk", "native dialog, unshown: '" << rTitle << "': '" << rMessage << "'");
+        return 0;
+    }
+};
+
+SalSystem* WkSalInstance::CreateSalSystem() { return new WkSalSystem(); }
+
+SalFrame* WkSalInstance::CreateFrame(SalFrame* pParent, SalFrameStyleFlags nStyle)
+{
+    SalFrame* pFrame = SvpSalInstance::CreateFrame(pParent, nStyle);
+    m_aFrames.push_back(static_cast<SvpSalFrame*>(pFrame));
+    SAL_INFO("vcl.wk", "frame " << pFrame << " created, style " << static_cast<sal_uInt64>(nStyle)
+                                << ", " << m_aFrames.size() << " now live");
+    return pFrame;
+}
+
+SalFrame* WkSalInstance::CreateChildFrame(SystemParentData* pParent, SalFrameStyleFlags nStyle)
+{
+    SalFrame* pFrame = SvpSalInstance::CreateChildFrame(pParent, nStyle);
+    m_aFrames.push_back(static_cast<SvpSalFrame*>(pFrame));
+    return pFrame;
+}
+
+void WkSalInstance::DestroyFrame(SalFrame* pFrame)
+{
+    std::erase(m_aFrames, static_cast<SvpSalFrame*>(pFrame));
+    m_aRouter.forget(static_cast<SvpSalFrame*>(pFrame));
+    SAL_INFO("vcl.wk", "frame " << pFrame << " destroyed, " << m_aFrames.size() << " left");
+    SvpSalInstance::DestroyFrame(pFrame);
+}
+
+void WkSalInstance::dumpFrames()
+{
+    int nIndex = 0;
+    for (const SvpSalFrame* pFrame : m_aFrames)
+    {
+        cairo_surface_t* pSurface = pFrame->GetSurface();
+        tools::Long nWidth = 0, nHeight = 0;
+        const_cast<SvpSalFrame*>(pFrame)->GetClientSize(nWidth, nHeight);
+        SAL_WARN("vcl.wk", "frame " << nIndex << ": " << nWidth << "x" << nHeight << " visible="
+                                    << pFrame->isVisible() << " surface=" << pSurface);
+        if (pSurface && pFrame->isVisible())
+        {
+            OString aName = m_aDumpPath + "-" + OString::number(nIndex) + ".png";
+            cairo_status_t eStatus = cairo_surface_write_to_png(pSurface, aName.getStr());
+            SAL_WARN("vcl.wk",
+                     "  wrote " << aName << ": " << cairo_status_to_string(eStatus));
+        }
+        ++nIndex;
+    }
+}
+
+void WkSalInstance::resizeTo(uint32_t nWidth, uint32_t nHeight)
+{
+    // The host is resize-authoritative: a wk node is sized on the canvas, and
+    // the guest is told what it got. Only top-level frames follow it -- a menu
+    // or a tooltip is sized by its content and would be destroyed by this.
+    for (SvpSalFrame* pFrame : m_aFrames)
+    {
+        if (pFrame->GetParent() != nullptr)
+            continue;
+        pFrame->SetPosSize(0, 0, static_cast<tools::Long>(nWidth),
+                           static_cast<tools::Long>(nHeight),
+                           SAL_FRAME_POSSIZE_X | SAL_FRAME_POSSIZE_Y | SAL_FRAME_POSSIZE_WIDTH
+                               | SAL_FRAME_POSSIZE_HEIGHT);
+    }
+    SAL_INFO("vcl.wk", "surface resized to " << nWidth << "x" << nHeight);
+}
+
+void WkSalInstance::present()
+{
+    if (m_aFrames.empty())
+        return;
+
+    if (!m_bSurfaceOpen)
+    {
+        // Opened on the first frame rather than at startup, so that a
+        // --headless conversion -- which creates no frames -- never asks the
+        // host for a surface it will not draw on.
+        const SalFrameGeometry aGeom = m_aFrames.front()->GetUnmirroredGeometry();
+        if (wkgfx_open(static_cast<uint32_t>(aGeom.width()),
+                       static_cast<uint32_t>(aGeom.height()))
+            != 0)
+        {
+            SAL_WARN("vcl.wk", "wkgfx_open failed");
+            return;
+        }
+        m_bSurfaceOpen = true;
+        SAL_INFO("vcl.wk", "surface opened, " << wkgfx_width() << "x" << wkgfx_height());
+    }
+
+    m_aCompositor.composite(m_aFrames);
+
+    if (!m_bPresented)
+    {
+        m_bPresented = true;
+        // Every frame, with what the compositor sees of it. PORTING.md's E6
+        // census in one line per frame: this is how a window that draws but
+        // looks wrong -- two top-levels stacked, a popup at the wrong place --
+        // is told apart from one that draws wrong.
+        for (const SvpSalFrame* p : m_aFrames)
+        {
+            const SalFrameGeometry aGeom = p->GetUnmirroredGeometry();
+            SAL_INFO("vcl.wk", "  frame " << p << " style "
+                                          << static_cast<sal_uInt64>(p->style()) << " visible "
+                                          << p->isVisible() << " at " << aGeom.x() << ","
+                                          << aGeom.y() << " " << aGeom.width() << "x"
+                                          << aGeom.height());
+        }
+    }
+}
+
+bool WkSalInstance::DoYield(bool bWait, bool bHandleAllCurrentEvents)
+{
+    const bool bAny = SvpSalInstance::DoYield(bWait, bHandleAllCurrentEvents);
+
+    // Input first: wk's queue is drained without blocking, the events are
+    // delivered as VCL events, and the present below then shows what they did.
+    // Draining before the present rather than after is the difference between
+    // a click being visible this frame and next.
+    if (m_bSurfaceOpen)
+    {
+        wkgfx_event ev;
+        while (wkgfx_poll_event(&ev))
+        {
+            if (ev.type == WKGFX_RESIZE)
+                resizeTo(ev.width, ev.height);
+            else
+                m_aRouter.dispatch(m_aFrames, ev);
+        }
+    }
+
+    // Present after dispatching, so what goes to the host is the state the
+    // events just produced rather than the one before them.
+    present();
+
+    if (m_nDumpAfter > 0 && ++m_nYields >= m_nDumpAfter)
+    {
+        m_nDumpAfter = 0; // once
+        if (!m_aDumpPath.isEmpty())
+            dumpFrames();
+        Application::Quit();
+    }
+
+    return bAny;
+}
+}
+
+extern "C" SalInstance* create_SalInstance()
+{
+    WkSalInstance* pInstance = new WkSalInstance(std::make_unique<SvpSalYieldMutex>());
+    new SvpSalData();
+    return pInstance;
+}
+
