diff --git a/include/vcl/wk/wkinput.hxx b/include/vcl/wk/wkinput.hxx
new file mode 100644
index 000000000..4b97f5c69
--- /dev/null
+++ b/include/vcl/wk/wkinput.hxx
@@ -0,0 +1,51 @@
+/* -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * This file is part of the LibreOffice project.
+ *
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/.
+ */
+
+#pragma once
+
+#include <sal/types.h>
+
+// wkgfx.h declares wkgfx_event as a typedef of an ANONYMOUS struct, which is
+// exactly the shape that cannot be forward-declared -- so the header comes in
+// here rather than only in the .cxx.
+#include <wkgfx.h>
+
+#include <vector>
+
+class SvpSalFrame;
+
+namespace vcl::wk
+{
+/** Turns wk's input events into VCL's, and decides which SalFrame each one
+    belongs to. See wkinput.cxx for why the routing is the hard part. */
+class Router
+{
+    /// Buttons currently held. wk sends the one that changed; VCL wants the
+    /// whole set on every event, moves included.
+    sal_uInt16 m_nButtons = 0;
+    /// The frame the pointer is over, which is also where key events go.
+    SvpSalFrame* m_pMouseFrame = nullptr;
+
+public:
+    /** Deliver one wk event, back-to-front hit-tested against @p rFrames. */
+    void dispatch(const std::vector<SvpSalFrame*>& rFrames, const wkgfx_event& rEv);
+
+    /** The topmost visible frame containing the surface-local point, or null. */
+    static SvpSalFrame* frameAt(const std::vector<SvpSalFrame*>& rFrames, double fX, double fY);
+
+    /** Forget a frame that is going away, so a stale pointer is never used. */
+    void forget(const SvpSalFrame* pFrame)
+    {
+        if (m_pMouseFrame == pFrame)
+            m_pMouseFrame = nullptr;
+    }
+};
+}
+
+/* vim:set shiftwidth=4 softtabstop=4 expandtab: */
