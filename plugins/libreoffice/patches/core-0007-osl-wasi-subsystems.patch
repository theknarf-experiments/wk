diff --git a/include/osl/process.h b/include/osl/process.h
index 14b9c2028..6f1daf207 100644
--- a/include/osl/process.h
+++ b/include/osl/process.h
@@ -66,6 +66,13 @@ typedef enum {
     osl_Process_E_NoPermission,         /* permission denied */
     osl_Process_E_Unknown,              /* unknown error */
     osl_Process_E_InvalidError,         /* unmapped error */
+    /* This platform cannot start a process at all. Distinct from
+       osl_Process_E_NotFound, which claims the image is missing and would send
+       whoever reads the log looking for a file that is present and fine.
+       Returned by every spawning entry point on WASI (sal/osl/unx/process_wasi.cxx),
+       where there is no fork, no exec and no second process to become.
+       Appended AFTER the existing values so none of them is renumbered. */
+    osl_Process_E_NotSupported,         /* no process execution on this platform */
     osl_Process_E_FORCE_EQUAL_SIZE = SAL_MAX_ENUM
 } oslProcessError;
 
