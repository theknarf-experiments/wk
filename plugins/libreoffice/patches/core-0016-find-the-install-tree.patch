diff --git a/cppuhelper/source/paths.cxx b/cppuhelper/source/paths.cxx
index 0a4ccf76e..f953747c3 100644
--- a/cppuhelper/source/paths.cxx
+++ b/cppuhelper/source/paths.cxx
@@ -34,7 +34,10 @@
 
 namespace {
 
-#if !(defined ANDROID || defined EMSCRIPTEN)
+// WASI joins them: get_this_libpath asks dladdr where this function came from,
+// and a statically linked component has no dynamic loader to ask -- the call
+// returns false and the URI comes out empty.
+#if !(defined ANDROID || defined EMSCRIPTEN || defined WASI)
 OUString get_this_libpath() {
     static OUString s_uri = []() {
         OUString uri;
@@ -61,7 +64,13 @@ OUString cppu::getUnoIniUri() {
     // and since rtlBootstrapHandle is not ref-counted doing anything
     // clean here is hardish.
     OUString uri("file:///assets/program");
-#elif defined(EMSCRIPTEN)
+#elif defined(EMSCRIPTEN) || defined(WASI)
+    // Hard-coded for the same reason as ANDROID above, and to the same place
+    // Emscripten uses. Nothing softer is available: wasmtime hands a component
+    // only the basename in argv[0], wasi-libc's realpath always fails, and
+    // there is no dladdr -- so the install tree cannot be discovered at all,
+    // only agreed on. wk mounts it at /instdir, which is also where the
+    // fontconfig paths in ExternalProject_fontconfig.mk point.
     OUString uri("file:///instdir/program");
 #else
     OUString uri(get_this_libpath());
diff --git a/desktop/source/app/sofficemain.cxx b/desktop/source/app/sofficemain.cxx
