+// failure is harmless; not asking at all is the same harmlessness.
+#if defined UNX && !defined EMSCRIPTEN && !defined WASI
     // Try to set RLIMIT_NOFILE as large as possible (failure is harmless):
     rlimit lim;
     if (getrlimit(RLIMIT_NOFILE, &lim) == 0)
