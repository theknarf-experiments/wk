diff --git a/static/Module_static.mk b/static/Module_static.mk
index 4c57b94d7..db0b25eef 100644
--- a/static/Module_static.mk
+++ b/static/Module_static.mk
@@ -27,9 +27,18 @@ endif
 
 endif
 
+# embindmaker generates Emscripten embind/JS bindings and is meaningless
+# without a JS runtime; wasmbridgegen generates the UNO C++/wasm bridge and is
+# needed by every wasm platform. Emscripten builds both, WASM (wasi) only the
+# second.
 ifneq ($(filter EMSCRIPTEN,$(BUILD_TYPE_FOR_HOST)),)
 $(eval $(call gb_Module_add_targets,static, \
     Executable_embindmaker \
+))
+endif
+
+ifneq ($(filter EMSCRIPTEN WASM,$(BUILD_TYPE_FOR_HOST)),)
+$(eval $(call gb_Module_add_targets,static, \
     Executable_wasmbridgegen \
 ))
 endif
