diff --git a/bridges/Library_cpp_uno.mk b/bridges/Library_cpp_uno.mk
index 94f17f014..1cb27ebc4 100644
--- a/bridges/Library_cpp_uno.mk
+++ b/bridges/Library_cpp_uno.mk
@@ -81,7 +81,12 @@ else ifeq ($(COM),MSC)
 bridges_SELECTED_BRIDGE := msvc_win32_intel
 bridge_exception_objects := cpp2uno uno2cpp
 bridge_noopt_objects := except
-else ifeq ($(OS),EMSCRIPTEN)
+else ifneq ($(filter EMSCRIPTEN WASI,$(OS)),)
+# Shared with Emscripten unchanged. The bridge is chosen by *architecture* —
+# wasm32 vtables and calling convention, generated by wasmbridgegen — and
+# nothing in it is specific to the JS runtime. `emscriptencxxabi` likewise: it
+# is a demangler for Itanium-mangled type names, which is what wasi-sdk's
+# libc++abi emits too; only its name suggests otherwise.
 bridges_SELECTED_BRIDGE := gcc3_wasm
 bridge_exception_objects := abi cpp2uno uno2cpp
 $(eval $(call gb_Library_add_generated_asmobjects,$(CPPU_ENV)_uno, \
