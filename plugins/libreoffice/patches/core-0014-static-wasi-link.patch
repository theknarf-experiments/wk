+# cmdmail and friends exist to hand a document to the desktop's mail client,
+# and cmdmailsuppl.cxx does it with popen("xdg-email ..."). A component has no
+# process to spawn and no desktop to spawn it into, so the feature has nothing
+# to do on WASI -- senddoc is a shell script and uri_encode is the helper it
+# calls. xmlparser above stays: it is a plain XML reader that CppunitTest_shell_zip
+# links, and has nothing to do with any of this.
+ifneq ($(OS),WASI)
+
+$(eval $(call gb_Module_add_targets,shell,\
 	Executable_uri_encode \
 	Library_cmdmail \
 	$(if $(ENABLE_MACOSX_SANDBOX),,Package_senddoc) \
@@ -114,6 +125,8 @@ endif
 
