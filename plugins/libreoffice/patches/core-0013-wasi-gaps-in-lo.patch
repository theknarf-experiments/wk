+/* The same kind of spell, for wasi-libc. <langinfo.h> defines ERA — and 58
+ * other names — as plain numbers, and libc++'s <locale> support header pulls
+ * it into practically every translation unit. glibc's langinfo.h writes those
+ * same names as `enum { ERA, ... }; #define ERA ERA`, a macro that expands to
+ * itself and so leaves an unrelated `Something::ERA` alone; musl's does not,
+ * and com::sun::star::i18n::CalendarFieldIndex::ERA stops parsing.
+ *
+ * Include it here, first, and take the name back. Nothing in LibreOffice calls
+ * nl_langinfo, so nothing loses anything. The other 58 are the same hazard
+ * waiting for the same kind of collision; add them here when one lands.
+ */
+#ifdef WASI
+#include <langinfo.h>
+#undef ERA
+#endif
