+                   "extern \"C\" void * wasm_getRttiSymbol(char const * name) {\n"
+                   "    std::size_t lo = 0, hi = sizeof entries / sizeof entries[0];\n"
+                   "    while (lo < hi) {\n"
+                   "        std::size_t const mid = lo + (hi - lo) / 2;\n"
