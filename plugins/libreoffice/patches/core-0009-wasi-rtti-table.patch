index 000a364e0..cee3593d2 100644
--- a/bridges/source/cpp_uno/gcc3_wasm/cpp2uno.cxx
+++ b/bridges/source/cpp_uno/gcc3_wasm/cpp2uno.cxx
@@ -12,7 +12,9 @@
 #include <cstring>
 #include <typeinfo>
 
+#if defined EMSCRIPTEN
 #include <emscripten.h>
+#endif
 
 #include <com/sun/star/uno/RuntimeException.hpp>
 #include <o3tl/string_view.hxx>
@@ -29,6 +31,8 @@
 
 #include "abi.hxx"
 
+#if defined EMSCRIPTEN
+
 EM_JS(void*, jsGetExportedSymbol, (char const* name),
       // clang-format off
 {
@@ -38,6 +42,32 @@ EM_JS(void*, jsGetExportedSymbol, (char const* name),
       // clang-format on
 );
 
+#else
+
+// No JS runtime to ask, so the answer is decided at link time instead:
+// wasmbridgegen emits generated-rtti.cxx, a table of every UNO exception type's
+// _ZTI symbol taken as a WEAK reference. Weak means an entry for a type this
+// binary does not link resolves to null rather than failing the link, which is
+// the same contract jsGetExportedSymbol has — so the fallback below stays
+// reachable, unchanged, for exactly the types it was reachable for before.
+//
+// Do NOT be tempted to skip the table and let the fallback synthesize RTTI for
+// everything. It compiles, links, and silently does not work: wasi-sdk's
+// <typeinfo> selects the "unique" comparison implementation, which compares
+// type_info by ADDRESS, so a synthesized type_info with a byte-identical
+// mangled name matches nothing. Verified by running: a throw with synthesized
+// RTTI falls through catch (Derived&) AND catch (Base&) into catch (...),
+// while the same throw with the real RTTI is caught normally. Every
+// catch (css::uno::Exception&) in LibreOffice would quietly stop firing.
+extern "C" void* wasm_getRttiSymbol(char const* name);
+
+namespace
+{
+void* jsGetExportedSymbol(char const* name) { return wasm_getRttiSymbol(name); }
+}
+
+#endif
+
