diff --git a/external/argon2/ar-from-environment.patch.0 b/external/argon2/ar-from-environment.patch.0
new file mode 100644
index 000000000..ed7a0e89b
--- /dev/null
+++ b/external/argon2/ar-from-environment.patch.0
@@ -0,0 +1,19 @@
+-*- Mode: Diff -*-
+
+argon2's Makefile spells the archiver as a literal `ar`, so a cross build gets
+whichever one the PATH happens to reach first. On macOS that is /usr/bin/ar,
+which writes a BSD archive whose members are padded to eight bytes with
+newlines; wasm-ld reads the padded length and stops with "argon2.o: section too
+large". Every other tool in the file already comes from a variable.
+
+--- Makefile
++++ Makefile
+@@ -183,7 +183,7 @@
+ 		$(CC) $(CFLAGS) $(LIB_CFLAGS) $(LDFLAGS) $(SO_LDFLAGS) $^ -o $@
+ 
+ $(LIB_ST): 	$(OBJ)
+-		ar rcs $@ $^
++		$(AR) rcs $@ $^
+ 
+ .PHONY: clean
+ clean:
