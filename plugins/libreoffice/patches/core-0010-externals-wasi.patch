diff --git a/external/liborcus/wasi-no-mmap.patch.0 b/external/liborcus/wasi-no-mmap.patch.0
new file mode 100644
index 000000000..4e7aa5f81
--- /dev/null
+++ b/external/liborcus/wasi-no-mmap.patch.0
@@ -0,0 +1,66 @@
+--- src/parser/stream.cpp
++++ src/parser/stream.cpp
+@@ -21,10 +21,15 @@
+ 
+ #include "filesystem_env.hpp"
+ 
++// boost::uintmax_t below came in transitively through interprocess.
++#include <boost/cstdint.hpp>
++
++#ifndef __wasi__
+ #include <boost/interprocess/file_mapping.hpp>
+ #include <boost/interprocess/mapped_region.hpp>
+ 
+ namespace bip = boost::interprocess;
++#endif
+ 
+ namespace orcus {
+ 
+@@ -160,15 +165,39 @@
+ struct file_content::impl
+ {
+     boost::uintmax_t content_size;
++#ifndef __wasi__
+     bip::file_mapping mapped_file;
+     bip::mapped_region mapped_region;
++#endif
+ 
+     std::string buffer; // its own buffer in case of stream conversion.
+ 
+     const char* content;
+ 
+     impl() : content_size(0), content(nullptr) {}
++
++#ifdef __wasi__
++    // Read rather than map. Boost.Interprocess refuses to build for wasi at
++    // all -- no sys/shm.h, and it will not accept a platform without one --
++    // and there is nothing to gain by insisting: a component's file is served
++    // by the host through wk's vfs, so a mapping would be a copy wearing a
++    // pointer. `buffer` is the same member the encoding-conversion path
++    // already loads into, and every accessor reads through `content`, so this
++    // is the only place that differs.
++    impl(const fs::path& filepath) :
++        content_size(fs::file_size(filepath)),
++        content(nullptr)
++    {
++        std::ifstream is(filepath.string(), std::ios::binary);
++        if (!is)
++            throw general_error("failed to open file: " + filepath.string());
+ 
++        buffer.resize(content_size);
++        if (content_size)
++            is.read(buffer.data(), content_size);
