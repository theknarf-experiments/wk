diff --git a/external/icu/icu4c-wasi-cross.patch.1 b/external/icu/icu4c-wasi-cross.patch.1
new file mode 100644
index 000000000..eb30f477d
--- /dev/null
+++ b/external/icu/icu4c-wasi-cross.patch.1
@@ -0,0 +1,48 @@
+Teach ICU's configure about a WASI host.
+
+ICU picks a host fragment and a platform name from $host, and knows neither
+wasm32-unknown-wasip2 nor any wasi triple: configure dies with "ERROR -
+configure could not detect your platform". LibreOffice already carries the
+same patch for Emscripten (icu4c-emscripten-cross.patch.1), which is the
+shape this follows.
+
+Both point at the Linux answers rather than a fragment of their own. From
+ICU's point of view wasi-libc IS the Linux case -- POSIX headers, little
+endian, no dylibs -- and everything the emscripten fragment adds beyond
+mh-linux is either about emcc's driver or about shared libraries, which this
+build does not produce (--disable-shared --enable-static, forced by
+DISABLE_DYNLOADING).
+
+--- icu/source/acinclude.m4
++++ icu/source/acinclude.m4
+@@ -85,6 +85,7 @@
+ *-*-nto*)	icu_cv_host_frag=mh-qnx ;;
+ *-ncr-*)	icu_cv_host_frag=mh-mpras ;;
+ wasm*-*-emscripten*)	icu_cv_host_frag=mh-emscripten ;;
++wasm*-*-wasi*)	icu_cv_host_frag=mh-linux ;;
+ *) 		icu_cv_host_frag=mh-unknown ;;
+ esac
+ 		]
+--- icu/source/configure.ac
++++ icu/source/configure.ac
+@@ -1122,6 +1122,7 @@
+ case "${host}" in
+ 	*-*-solaris*) 	platform=U_SOLARIS ;;
+ 	*-*-linux*|*-*-gnu|*-*-k*bsd*-gnu|*-*-kopensolaris*-gnu)        platform=U_LINUX ;;
++	wasm*-*-wasi*)	platform=U_LINUX ;;
+ 	*-*-*bsd*|*-*-dragonfly*) 	platform=U_BSD ;;
+ 	*-*-aix*) 	platform=U_AIX ;;
+ 	*-*-hpux*) 	platform=U_HPUX ;;
+--- icu/source/common/putilimp.h
++++ icu/source/common/putilimp.h
+@@ -147,6 +147,10 @@
+    /* not defined */
+ #elif U_PLATFORM == U_PF_HAIKU
+     /* not defined, (well it is but a loop back to icu) */
++#elif defined(__wasi__)
++    /* not defined: wasi-libc has no timezone database and so no tzname. ICU
++       treats an undefined U_TZNAME as "this platform cannot name its zone",
++       which is the truth here rather than a workaround. */
+ #else
+ #   define U_TZNAME tzname
+ #endif
