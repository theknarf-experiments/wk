diff --git a/external/redland/raptor/raptor-wasi.patch.1 b/external/redland/raptor/raptor-wasi.patch.1
new file mode 100644
index 000000000..deabd9cee
--- /dev/null
+++ b/external/redland/raptor/raptor-wasi.patch.1
@@ -0,0 +1,18 @@
+-*- Mode: Diff -*-
+
+wasi-libc is musl-derived and has the glibc-shaped qsort_r, so raptor's Linux
+arm is the right one. It defines none of the macros that arm tests for, which
+is why an unpatched build stops at "Cannot detect operating system" rather than
+picking something wrong.
+
+--- raptor/src/sort_r.h
++++ raptor/src/sort_r.h
+@@ -28,7 +28,7 @@
+ #  define _SORT_R_BSD
+ #elif (defined _GNU_SOURCE || defined __gnu_hurd__ || defined __GNU__ || \
+        defined __linux__ || defined __MINGW32__ || defined __GLIBC__ || \
+-       defined __CYGWIN__ || defined __EMSCRIPTEN__)
++       defined __CYGWIN__ || defined __EMSCRIPTEN__ || defined __wasi__)
+ #  define _SORT_R_LINUX
+ #elif (defined _WIN32 || defined _WIN64 || defined __WINDOWS__)
+ #  define _SORT_R_WINDOWS
diff --git a/external/redland/redland/redland-wasi.patch.1 b/external/redland/redland/redland-wasi.patch.1
new file mode 100644
index 000000000..42f5354c6
--- /dev/null
+++ b/external/redland/redland/redland-wasi.patch.1
@@ -0,0 +1,25 @@
+-*- Mode: Diff -*-
+
+wasi-libc declares mkstemp, mktemp, mkstemps and tmpnam but implements none of
+them -- they are stubbed out of the sysroot, so a link test finds no symbol and
+configure correctly answers no to all four. redland's remaining branch is a
+literal `HELP`, left there for a platform nobody expected to meet.
+
+The function is deprecated ("Do not use this, it is unsafe"), documented to
+return NULL on failure, and every caller checks. NULL is the honest answer for
+a component that has no temporary directory of its own.
+
+--- redland/src/rdf_files.c
++++ redland/src/rdf_files.c
+@@ -118,7 +118,11 @@
+ 
+   return name;
+ #else /* not tmpnam(), mkstemp() or mktemp() */
++#ifdef __wasi__
++  return NULL;
++#else
+ HELP
++#endif
+ #endif
+ #endif
+ }
