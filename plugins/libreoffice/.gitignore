# libreoffice (real LibreOffice Impress as a wk node, via a wk VCL backend).
#
# NOTE ON PLACEMENT: every other plugin declares its derived paths in the repo
# root .gitignore. This port keeps its rules here instead, because the tree it
# guards is by far the largest in the repo -- a LibreOffice core checkout plus
# its external tarballs plus a native bootstrap build plus a wasip2 build is
# tens of gigabytes -- and a nested .gitignore is in force the moment the
# directory exists, with no window in which a `git add -A` from the repo root
# could sweep it in. Fold these into the root file later if you prefer the
# convention; do not delete them.
#
# Upstream LibreOffice is FETCHED, never vendored. Only the build scripts, the
# wk VCL backend sources, patches/, mise.toml, the example workspace and the
# porting notes belong in git.

# The upstream core checkout (git clone --depth 1 of a release tag). ~2 GB.
src/

# External dependency tarballs that LO's download.sh pulls (boost, icu, curl,
# harfbuzz, poppler, ...). Tens of them, hundreds of MB.
tarballs/
external/

# Native bootstrap build: LO cross-compiles by first building a host-native
# LibreOffice to get its own code generators (idlc, cppumaker, saxparser, the
# `Executable_*` tools gbuild invokes at build time). Same split as
# plugins/qt/host + plugins/qt/build-host.
host/
build-host/

# The wasm32-wasip2 build tree and its install prefix.
build/
build-target/
sysroot/
instdir/
workdir/

# wit-bindgen output for the wk interfaces the backend imports (gfx, tty,
# clipboard, ...), regenerated by the build.
gen/

# Symlink farm of resolved host tools (gmake, gperf, meson, ...), rebuilt by
# common.sh on every run. It exists so BUILD_PATH can stay narrow -- notably
# free of any wasm-opt, which clang would run as an optional post-link pass and
# which cannot parse exnref. Machine-specific by construction.
.toolbin/

# Host tools this port builds for itself because macOS ships versions
# LibreOffice's configure rejects outright (GNU Make 3.81, gperf 3.0.3) and
# neither is available through mise. `mise run deps` rebuilds both in ~2 min
# from the pinned tarballs, so there is nothing here worth tracking.
.hosttools/
.hosttools-build/

# Build logs (each stage tees one; they are large and machine-specific).
logs/
*.log

# The node component and any intermediate core module.
*.wasm
*.a
*.o

# Rust test harness build output, if this port grows one like the Qt ports did.
harness/target/
harness/Cargo.lock

# A copy of somebody else's font, staged by the build from whatever the machine
# has (DejaVu, Liberation, ...). A wk node has no host font directory, so the
# fonts LO needs get compiled/staged into the image -- but the files themselves
# are not ours to commit.
fonts/
