" wk's system vimrc (installed at $VIM/vimrc by the container build).
" The terminal is alacritty-backed and speaks 256-colour SGR; vim's builtin
" termcap can't know that, so declare it — defaults.vim then turns syntax
" highlighting on.
set t_Co=256

" That builtin termcap also leaves the ANSI colour-set entries (t_AF/t_AB)
" empty, so vim can't emit ANY foreground/background colour — syntax
" highlighting and the Visual selection would show nothing. Declare the
" standard xterm-256colour sequences (\e = ESC); the Visual group's ctermbg
" then renders, as do syntax colours.
let &t_AF = "\e[38;5;%dm"
let &t_AB = "\e[48;5;%dm"

" Route :w through writefile() instead of vim's normal save. Two wasi problems
" this sidesteps at once:
"   1. wasi has no file permission bits, and wasi:filesystem has no field to
"      carry them, so wasi-libc reports every file with st_mode perms = 0. Vim's
"      write path (buf_write -> check_file_readonly(fname, mch_getperm(fname)))
"      then hits `(perm & 0222) == 0` == true and declares the file read-only,
"      demanding :w!. It's the mode bits, not access() (which works) — so
"      'noreadonly'/'writeany' can't bypass it, and wk can't fix it host-side.
"   2. The normal save renames a fresh file over the original, which severs a
"      single-file mount (a wk file node, like a Docker bind-mount of one file)
"      so the edit never reaches the backing file or nodes sharing it.
" writefile() writes the buffer straight to the file, in place, with no readonly
" check and no rename — so :w just works and propagates. BufWriteCmd covers the
" buffer's own file; FileWriteCmd covers `:w {file}` and range writes.
" (Line endings are always unix here, which is what wk files use.)
function! s:WkWrite(fname) abort
    if a:fname ==# ''
        echohl ErrorMsg | echo 'E32: No file name' | echohl NONE
        return
    endif
    if writefile(getline(1, '$'), a:fname, &binary ? 'b' : '') == 0
        if a:fname ==# expand('%:p')
            setlocal nomodified
        endif
    else
        echohl ErrorMsg | echo 'wk: could not write ' . a:fname | echohl NONE
    endif
endfunction
autocmd BufWriteCmd  * call s:WkWrite(expand('<afile>'))
autocmd FileWriteCmd * call s:WkWrite(expand('<afile>'))

" wk's vfs reports no permission bits, so vim also flags every file [readonly]
" via its read-time `!(perm & 0222)` check. Every file here is writable (layer
" files copy-up on write), so clear the spurious flag — cosmetic, now that the
" write itself goes through writefile() above.
autocmd BufReadPost,BufNewFile * setlocal noreadonly
