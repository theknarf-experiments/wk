index 0000000..2b9b176
--- /dev/null
+++ b/library/rt-backends/wk-in/CMakeLists.txt
@@ -0,0 +1,42 @@
+# The wk:midi input backend. net-in/CMakeLists.txt with Qt::Network swapped for
+# the wk:midi shim; see wk-out/CMakeLists.txt for why QT_STATICPLUGIN is the
+# line that matters.
+#
+# ../common/midiparser.{h,cpp} is COMPILED IN here, the same way net-in and
+# oss-in compile it in, rather than reimplemented: it is drumstick's own MIDI
+# byte-stream state machine, it emits all ten MIDIInput signals, and it
+# implements MIDI-thru. This backend therefore contains no MIDI parsing of its
+# own at all. It is moc'd as well as compiled because MIDIParser is a QObject.
+
+set(CMAKE_INCLUDE_CURRENT_DIR ON)
+
+set(drumstick-rt-wk-in_QTOBJ_SRCS
+    ../common/midiparser.h
+    wkmidiinput.h
+)
+
+set(drumstick-rt-wk-in_SRCS
+    ../common/midiparser.cpp
+    wkmidiinput.cpp
+)
+
+qt_wrap_cpp(drumstick-rt-wk-in_MOC_SRCS ${drumstick-rt-wk-in_QTOBJ_SRCS}
+    OPTIONS -I ${Drumstick_SOURCE_DIR}/library/include)
+
+add_library(drumstick-rt-wk-in STATIC
+    ${drumstick-rt-wk-in_MOC_SRCS}
+    ${drumstick-rt-wk-in_SRCS})
+
+target_compile_definitions(drumstick-rt-wk-in PRIVATE QT_STATICPLUGIN)
+
+target_include_directories(drumstick-rt-wk-in PRIVATE
+    ${Drumstick_SOURCE_DIR}/library/include
+    ../common
+    ../wk-common)
+
+target_link_libraries(drumstick-rt-wk-in PRIVATE
+    Qt${QT_VERSION_MAJOR}::Core
+    Drumstick::RT
+    drumstick-rt-wk-shim)
+
+# No install(): see wk-out/CMakeLists.txt.
diff --git a/library/rt-backends/wk-in/wkmidiinput.cpp b/library/rt-backends/wk-in/wkmidiinput.cpp
new file mode 100644
index 0000000..b4cc0bd
--- /dev/null
+++ b/library/rt-backends/wk-in/wkmidiinput.cpp
@@ -0,0 +1,199 @@
+/*
+    Drumstick RT backend for the wk runtime's wk:midi port (input half)
+    Copyright (C) 2026 the wk project
+
+    Modelled on drumstick's own rt-backends/dummy-in and net-in, which are
+    Copyright (C) 2009-2026 Pedro Lopez-Cabanillas <plcl@users.sf.net>.
+
+    This program is free software; you can redistribute it and/or modify
+    it under the terms of the GNU General Public License as published by
+    the Free Software Foundation; either version 3 of the License, or
+    (at your option) any later version.
+
+    This program is distributed in the hope that it will be useful,
+    but WITHOUT ANY WARRANTY; without even the implied warranty of
+    MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+    GNU General Public License for more details.
+
+    You should have received a copy of the GNU General Public License
+    along with this program. If not, see <http://www.gnu.org/licenses/>.
+*/
+
+#include "wkmidiinput.h"
+#include "wkconnection.h"
+#include "midiparser.h"
+
+#include <QByteArray>
+#include <QTimerEvent>
+#include <QtGlobal>
+
+extern "C" {
+#include "wkmidiio.h"
+}
+
+namespace drumstick {
+namespace rt {
+
+// How often the pump runs, in milliseconds. 1 ms is the default because it is
+// below the threshold where a played note feels late (human timing is ±10 ms)
+// and because the poll it shortens is one the event dispatcher was making
+// anyway. Raise it from the node's environment on a machine where the extra
+// wakeups matter -- the cost is latency, not correctness, and 0 disables the
+// pump entirely, which is useful for proving that a test is really watching
+// the input path.
+static int pollIntervalMs()
+{
+    bool ok = false;
+    const int ms = qEnvironmentVariableIntValue("WK_MIDI_POLL_MS", &ok);
+    return ok ? qBound(0, ms, 1000) : 1;
+}
+
+WkMIDIInput::WkMIDIInput(QObject *parent)
+    : MIDIInput(parent)
+    , m_publicName(QStringLiteral("MIDI In"))
+    , m_parser(new MIDIParser(this, this))
+    , m_thru(false)
+    , m_timerId(0)
+{
+}
+
+WkMIDIInput::~WkMIDIInput()
+{
+    close();
+}
+
+void WkMIDIInput::initialize(QSettings *settings)
+{
+    Q_UNUSED(settings)
+    // Nothing to configure: what feeds this node's inbox is a "midi" wire on
+    // the wk canvas, not a setting inside the guest.
+}
+
+QString WkMIDIInput::backendName()
+{
+    return QStringLiteral("wk");
+}
+
+QString WkMIDIInput::publicName()
+{
+    return m_publicName;
+}
+
+void WkMIDIInput::setPublicName(QString name)
+{
+    m_publicName = name;
+}
+
+QList<MIDIConnection> WkMIDIInput::connections(bool advanced)
+{
+    Q_UNUSED(advanced)
+    // The same single port the output half reports, and named identically, so
+    // the Connections dialog reads as one device rather than two coincidences.
+    return QList<MIDIConnection>{wkConnection()};
+}
+
+void WkMIDIInput::setExcludedConnections(QStringList conns)
+{
+    Q_UNUSED(conns)
+}
+
+void WkMIDIInput::open(const MIDIConnection &conn)
+{
+    Q_UNUSED(conn)
+    wkmidi_open_in();
+    m_currentConnection = wkConnection();
+    if (m_timerId == 0) {
+        const int ms = pollIntervalMs();
+        if (ms > 0) {
+            // PreciseTimer: a CoarseTimer is allowed to drift by 5% of its
+            // interval, which at 1 ms Qt rounds into "whenever", and the
+            // whole point of the interval is that it is short.
+            m_timerId = startTimer(ms, Qt::PreciseTimer);
+        }
+    }
+}
+
+void WkMIDIInput::close()
+{
+    if (m_timerId != 0) {
+        killTimer(m_timerId);
+        m_timerId = 0;
+    }
+    // As in wk-out: the wk:midi resource itself is the node's and outlives
+    // this object. Stopping the pump is the whole of "closed".
+    m_currentConnection = MIDIConnection();
+}
+
+MIDIConnection WkMIDIInput::currentConnection()
+{
+    return m_currentConnection;
+}
+
+void WkMIDIInput::setMIDIThruDevice(MIDIOutput *device)
+{
+    // Thru is implemented by the parser, not here: it forwards each decoded
+    // message to this device before emitting the corresponding signal, so
+    // enabling it costs this class nothing (see
+    // rt-backends/common/midiparser.cpp, which checks isEnabledMIDIThru()).
+    m_parser->setMIDIThruDevice(device);
+}
+
+void WkMIDIInput::enableMIDIThru(bool enable)
+{
+    m_thru = enable;
+}
+
+bool WkMIDIInput::isEnabledMIDIThru()
+{
+    return m_thru;
+}
+
+void WkMIDIInput::timerEvent(QTimerEvent *event)
+{
+    if (event->timerId() != m_timerId) {
+        MIDIInput::timerEvent(event);
+        return;
+    }
+
+    // Drain the WHOLE queue each tick, not one message. The host bounds the
+    // inbox at 1024 messages and silently drops beyond it
+    // (crates/wk-server/src/midi.rs), and the most visible symptom of a drop
+    // is a stuck note -- a note-off that never arrived. A burst (a chord, a
+    // sysex dump, a sequencer starting) must therefore never be spread across
+    // ticks. The bound is the queue emptying, so this terminates.
+    uint8_t msg[WKMIDI_MAX_MSG];
+    int n;
+    while ((n = wkmidi_recv(msg, sizeof msg)) > 0) {
+        // MIDIParser::parse(QByteArray) runs the same state machine as the
+        // byte-at-a-time overload, so a message split across wk:midi sends
+        // (which the interface permits) still decodes correctly.
+        m_parser->parse(QByteArray(reinterpret_cast<const char *>(msg), n));
+    }
+}
+
+// --- the Q_PROPERTY answers vpiano reads -----------------------------------
+
+QStringList WkMIDIInput::getDiagnostics()
+{
+    return QStringList();
+}
+
+QString WkMIDIInput::getLibVersion()
+{
+    return QT_STRINGIFY(VERSION);
+}
+
+bool WkMIDIInput::getStatus()
+{
+    // A node's inbox always exists; nothing here can fail to open. vpiano
+    // prints the diagnostics list when this is false, so returning true and
+    // an empty list is the consistent pair.
+    return true;
+}
+
+bool WkMIDIInput::getConfigurable()
+{
+    return false;
+}
+
+}} // namespace drumstick::rt
diff --git a/library/rt-backends/wk-in/wkmidiinput.h b/library/rt-backends/wk-in/wkmidiinput.h
new file mode 100644
index 0000000..e0688b4
--- /dev/null
+++ b/library/rt-backends/wk-in/wkmidiinput.h
@@ -0,0 +1,114 @@
+/*
+    Drumstick RT backend for the wk runtime's wk:midi port (input half)
+    Copyright (C) 2026 the wk project
+
+    Modelled on drumstick's own rt-backends/dummy-in and net-in, which are
+    Copyright (C) 2009-2026 Pedro Lopez-Cabanillas <plcl@users.sf.net>.
+
+    This program is free software; you can redistribute it and/or modify
+    it under the terms of the GNU General Public License as published by
+    the Free Software Foundation; either version 3 of the License, or
+    (at your option) any later version.
+
+    This program is distributed in the hope that it will be useful,
+    but WITHOUT ANY WARRANTY; without even the implied warranty of
+    MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+    GNU General Public License for more details.
+
+    You should have received a copy of the GNU General Public License
+    along with this program. If not, see <http://www.gnu.org/licenses/>.
+*/
+
+#ifndef WKMIDIINPUT_H
+#define WKMIDIINPUT_H
+
+#include <QObject>
+#include <drumstick/rtmidiinput.h>
+
+namespace drumstick {
+namespace rt {
+
+class MIDIParser;
+
+/**
+ * @brief MIDI input over wk's `wk:midi/midi` input resource.
+ *
+ * WHY THERE IS NO THREAD, AND NO SOCKET NOTIFIER.
+ *
+ * Every other Drumstick input backend either blocks a thread on a device
+ * (alsa-in runs a QThread over snd_seq_event_input) or hangs a QSocketNotifier
+ * off a descriptor (net-in, oss-in). Neither is available here:
+ *
+ *   * this Qt is built FEATURE_thread=OFF, so a QThread would link and never
+ *     run -- there is exactly one thread and it is the one painting;
+ *   * `wk:midi/midi` has no descriptor and no pollable. Its input resource is
+ *     `receive: func() -> option<list<u8>>`, a non-blocking pop off a queue
+ *     the host owns (crates/wk-server/src/midi.rs). There is nothing to give
+ *     the QPA's one wasi:io/poll call to wait on.
+ *
+ * So this backend polls, on a Qt::PreciseTimer. That is NOT the "wrap the
+ * missing capability in a QTimer" anti-pattern the wk Qt port forbids
+ * elsewhere -- that rule is about a descriptor that HAS a pollable and wants
+ * a socket notifier. Polling is the only mechanism this interface offers, and
+ * it is what every existing wk MIDI guest already does (plugins/fluidsynth,
+ * plugins/arp, plugins/synth). The interval is settable from the environment
+ * (WK_MIDI_POLL_MS, default 1) and costs one extra deadline on a poll the
+ * dispatcher was going to make anyway: QWkEventDispatcher already folds
+ * m_timers.timerWait() into the frame wait, so a running timer only shortens
+ * a block that already existed.
+ *
+ * The bytes themselves are handed straight to drumstick's own MIDIParser,
+ * which emits all ten MIDIInput signals and implements MIDI-thru. This class
+ * parses nothing.
+ */
+class WkMIDIInput : public MIDIInput
+{
+    Q_OBJECT
+    Q_PLUGIN_METADATA(IID "net.sourceforge.drumstick.rt.MIDIInput/2.0")
+    Q_INTERFACES(drumstick::rt::MIDIInput)
+    Q_PROPERTY(QStringList diagnostics READ getDiagnostics)
+    Q_PROPERTY(QString libversion READ getLibVersion)
+    Q_PROPERTY(bool status READ getStatus)
+    Q_PROPERTY(bool isconfigurable READ getConfigurable)
+
+public:
+    explicit WkMIDIInput(QObject *parent = nullptr);
+    virtual ~WkMIDIInput();
+
+    // MIDIInput interface
+public:
+    void initialize(QSettings *settings) override;
+    QString backendName() override;
+    QString publicName() override;
+    void setPublicName(QString name) override;
+    QList<MIDIConnection> connections(bool advanced) override;
+    void setExcludedConnections(QStringList conns) override;
+    void open(const MIDIConnection &conn) override;
+    void close() override;
+    MIDIConnection currentConnection() override;
+
+    void setMIDIThruDevice(MIDIOutput *device) override;
+    void enableMIDIThru(bool enable) override;
+    bool isEnabledMIDIThru() override;
+
+protected:
+    /** The pump. Drains the node's inbox into the parser; see the class
+     *  comment for why this is a timer and not a notifier. */
+    void timerEvent(QTimerEvent *event) override;
+
+private:
+    QStringList getDiagnostics();
+    QString getLibVersion();
+    bool getStatus();
+    bool getConfigurable();
+
+    QString m_publicName;
+    MIDIConnection m_currentConnection;
+    MIDIParser *m_parser;
+    bool m_thru;
+    int m_timerId;
+};
+
+}} // namespace drumstick::rt
+
+#endif // WKMIDIINPUT_H
diff --git a/library/rt-backends/wk-out/CMakeLists.txt b/library/rt-backends/wk-out/CMakeLists.txt
new file mode 100644
index 0000000..c21d791
--- /dev/null
+++ b/library/rt-backends/wk-out/CMakeLists.txt
@@ -0,0 +1,46 @@
+# The wk:midi output backend. A copy of net-out/CMakeLists.txt with Qt::Network
+# swapped for the wk:midi shim -- nothing else about the shape is ours.
+#
+# The load-bearing line is QT_STATICPLUGIN. There is no dlopen on wasm, so this
+# plugin can only ever be linked in and named with Q_IMPORT_PLUGIN
+# (utils/vpiano/vpianomain.cpp); QT_STATICPLUGIN is what makes moc emit the
+# static registration function that Q_IMPORT_PLUGIN references and
+# QPluginLoader::staticInstances() -- which is how BackendManager::refresh()
+# finds it -- returns. Without it the app links, BackendManager finds nothing,
+# and VPiano::initialize() reaches qFatal("Unable to find a suitable output
+# backend").
+
+set(CMAKE_INCLUDE_CURRENT_DIR ON)
+
+set(drumstick-rt-wk-out_QTOBJ_SRCS
+    wkmidioutput.h
+)
+
