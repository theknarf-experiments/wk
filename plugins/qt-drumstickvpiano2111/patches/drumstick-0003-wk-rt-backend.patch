+++ b/library/rt-backends/wk-out/wkmidioutput.cpp
@@ -0,0 +1,207 @@
+/*
+    Drumstick RT backend for the wk runtime's wk:midi port (output half)
+    Copyright (C) 2026 the wk project
+
+    Modelled on drumstick's own rt-backends/dummy-out and net-out, which are
