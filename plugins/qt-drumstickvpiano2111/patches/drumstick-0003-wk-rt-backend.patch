+    along with this program. If not, see <http://www.gnu.org/licenses/>.
+*/
+
+#ifndef WKCONNECTION_H
+#define WKCONNECTION_H
+
+#include <drumstick/rtmidioutput.h> // for MIDIConnection
+
+namespace drumstick {
+namespace rt {
+
+/**
+ * The single MIDI port a wk node has, reported identically by the input and
+ * the output backend so that a Connections dialog reads as one device rather
+ * than two coincidences.
+ *
+ * Inline, in a header both plugins include, rather than a static on either
+ * class: wk-in and wk-out are separate static archives and neither should
+ * have to be linked to get the other's name.
+ *
+ * The name is deliberately self-explanatory. The dialog will list exactly ONE
+ * port, which looks like a broken driver until the name says what it is --
+ * the port is not a device, it is this node's edge on the wk canvas, and
+ * where its bytes go is decided by the wires drawn there.
+ */
+inline MIDIConnection wkConnection()
+{
+    return MIDIConnection(QStringLiteral("wk fabric"), QStringLiteral("wk"));
+}
+
+}} // namespace drumstick::rt
+
+#endif // WKCONNECTION_H
diff --git a/library/rt-backends/wk-in/CMakeLists.txt b/library/rt-backends/wk-in/CMakeLists.txt
