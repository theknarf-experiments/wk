+    the Free Software Foundation; either version 3 of the License, or
+    (at your option) any later version.
+
+    This program is distributed in the hope that it will be useful,
+    but WITHOUT ANY WARRANTY; without even the implied warranty of
+    MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+    GNU General Public License for more details.
+
+    You should have received a copy of the GNU General Public License
+    along with this program. If not, see <http://www.gnu.org/licenses/>.
+*/
+
+#include "wkmidioutput.h"
+#include "wkconnection.h"
+
+extern "C" {
+#include "wkmidiio.h"
+}
+
+namespace drumstick {
+namespace rt {
+
+WkMIDIOutput::WkMIDIOutput(QObject *parent)
+    : MIDIOutput(parent)
+    , m_publicName(QStringLiteral("MIDI Out"))
+{
+}
+
+void WkMIDIOutput::initialize(QSettings *settings)
+{
+    Q_UNUSED(settings)
+    // Nothing to configure: which nodes receive these bytes is a property of
+    // the wk canvas (a "midi" wire), not of any setting inside the guest.
+}
+
+QString WkMIDIOutput::backendName()
+{
+    return QStringLiteral("wk");
+}
+
+QString WkMIDIOutput::publicName()
+{
+    return m_publicName;
+}
+
+void WkMIDIOutput::setPublicName(QString name)
+{
+    m_publicName = name;
+}
+
+QList<MIDIConnection> WkMIDIOutput::connections(bool advanced)
+{
+    Q_UNUSED(advanced)
+    return QList<MIDIConnection>{wkConnection()};
+}
+
+void WkMIDIOutput::setExcludedConnections(QStringList conns)
+{
+    // The exclusion list exists so a backend does not offer the application
+    // its own ports back (an ALSA app would otherwise see itself). There is
+    // one port here and it is not ours to loop back -- the host router
+    // decides where it goes -- so there is nothing to exclude.
+    Q_UNUSED(conns)
+}
+
+void WkMIDIOutput::open(const MIDIConnection &conn)
+{
+    Q_UNUSED(conn)
+    // The connection argument is ignored on purpose: connections() offers
+    // exactly one, and wkmidi_open_out() is idempotent-by-returning--1, so
+    // reopening after a Connections-dialog round trip costs nothing.
+    wkmidi_open_out();
+    m_currentConnection = wkConnection();
+}
+
+void WkMIDIOutput::close()
+{
+    // The wk:midi output resource lives for the guest's lifetime (see
+    // shim/wkmidiio.h); "closed" here means only that this backend will
+    // report no current connection. Dropping the resource would buy nothing
+    // -- a node has one outbox and it is the node's, not this object's.
+    m_currentConnection = MIDIConnection();
+}
+
+MIDIConnection WkMIDIOutput::currentConnection()
+{
+    return m_currentConnection;
+}
+
+// --- the encoders ----------------------------------------------------------
+//
+// MIDI 1.0 wire format, one message per call, status byte always present.
+// wk:midi delivers messages, not a byte stream, so running status would be
+// meaningless here and every message is self-contained.
+
+void WkMIDIOutput::sendNoteOff(int chan, int note, int vel)
+{
+    const uint8_t m[3] = { uint8_t(MIDI_STATUS_NOTEOFF | (chan & MIDI_CHANNEL_MASK)),
+                           uint8_t(note & 0x7f), uint8_t(vel & 0x7f) };
+    wkmidi_send(m, sizeof m);
+}
+
+void WkMIDIOutput::sendNoteOn(int chan, int note, int vel)
+{
+    const uint8_t m[3] = { uint8_t(MIDI_STATUS_NOTEON | (chan & MIDI_CHANNEL_MASK)),
+                           uint8_t(note & 0x7f), uint8_t(vel & 0x7f) };
+    wkmidi_send(m, sizeof m);
+}
+
+void WkMIDIOutput::sendKeyPressure(int chan, int note, int value)
+{
+    const uint8_t m[3] = { uint8_t(MIDI_STATUS_KEYPRESURE | (chan & MIDI_CHANNEL_MASK)),
+                           uint8_t(note & 0x7f), uint8_t(value & 0x7f) };
+    wkmidi_send(m, sizeof m);
+}
+
+void WkMIDIOutput::sendController(int chan, int control, int value)
+{
+    const uint8_t m[3] = { uint8_t(MIDI_STATUS_CONTROLCHANGE | (chan & MIDI_CHANNEL_MASK)),
+                           uint8_t(control & 0x7f), uint8_t(value & 0x7f) };
+    wkmidi_send(m, sizeof m);
+}
+
+void WkMIDIOutput::sendProgram(int chan, int program)
+{
+    const uint8_t m[2] = { uint8_t(MIDI_STATUS_PROGRAMCHANGE | (chan & MIDI_CHANNEL_MASK)),
+                           uint8_t(program & 0x7f) };
+    wkmidi_send(m, sizeof m);
+}
+
+void WkMIDIOutput::sendChannelPressure(int chan, int value)
+{
+    const uint8_t m[2] = { uint8_t(MIDI_STATUS_CHANNELPRESSURE | (chan & MIDI_CHANNEL_MASK)),
+                           uint8_t(value & 0x7f) };
+    wkmidi_send(m, sizeof m);
+}
+
+void WkMIDIOutput::sendPitchBend(int chan, int value)
+{
+    // Drumstick's `value` is SIGNED, -8192..8191, and the wire wants an
+    // unsigned 14-bit number centred on 0x2000, LSB first. Getting this wrong
+    // is silent -- every bend just lands an octave off -- so it is written the
+    // way net-out and oss-out write it, and it is the exact inverse of what
+    // rt-backends/common/midiparser.cpp does on the way back in
+    // (`v = m1 + m2 * 0x80 - 0x2000`).
+    const int centred = 8192 + value;
+    const uint8_t m[3] = { uint8_t(MIDI_STATUS_PITCHBEND | (chan & MIDI_CHANNEL_MASK)),
+                           uint8_t(MIDI_LSB(centred)), uint8_t(MIDI_MSB(centred)) };
+    wkmidi_send(m, sizeof m);
+}
+
+void WkMIDIOutput::sendSysex(const QByteArray &data)
+{
+    // Verbatim: drumstick's callers pass the complete F0..F7 message, and the
+    // host queues it as one message rather than a stream, so there is nothing
+    // to frame.
+    if (data.isEmpty())
+        return;
+    wkmidi_send(reinterpret_cast<const uint8_t *>(data.constData()), size_t(data.size()));
+}
+
+void WkMIDIOutput::sendSystemMsg(const int status)
+{
+    const uint8_t m[1] = { uint8_t(status & 0xff) };
+    wkmidi_send(m, sizeof m);
+}
+
+// --- the Q_PROPERTY answers vpiano reads -----------------------------------
+
+QStringList WkMIDIOutput::getDiagnostics()
+{
+    return QStringList();
+}
+
+QString WkMIDIOutput::getLibVersion()
+{
+    return QT_STRINGIFY(VERSION);
+}
+
+bool WkMIDIOutput::getStatus()
+{
+    // Always true: there is no device to fail to open. A wk node's outbox
+    // exists whether or not anything is wired to it, and sending into an
+    // unwired node is a no-op in the host router, not an error.
+    return true;
+}
+
+bool WkMIDIOutput::getConfigurable()
+{
+    // False, and this is the honest answer rather than a stub: the only thing
+    // there would be to configure is where the MIDI goes, and that lives on
+    // the wk canvas. Drumstick's configureOutputDriver() checks this property
+    // AND the existence of a configure(QWidget*) slot, so returning false and
+    // declaring no such slot are consistent.
+    return false;
+}
+
+}} // namespace drumstick::rt
