+*/
+
+#ifndef WKMIDIOUTPUT_H
+#define WKMIDIOUTPUT_H
+
+#include <QObject>
+#include <drumstick/rtmidioutput.h>
+
+namespace drumstick {
+namespace rt {
+
+/**
+ * @brief MIDI output over wk's `wk:midi/midi` output resource.
+ *
+ * A wk node has exactly ONE MIDI outbox, and where its bytes go is decided
+ * on the wk canvas, not here: the host router (crates/wk-server/src/midi.rs)
+ * forwards whatever this node sends to the inbox of every node a "midi" wire
+ * connects it to. So the whole Drumstick connection model -- enumerate ports,
+ * pick one, open it -- collapses to a single fixed connection, and this class
+ * is a state machine with one state plus a byte assembler.
+ *
+ * Assembling raw bytes is the entire job. Drumstick's MIDIOutput interface is
+ * nine typed slots; wk:midi carries MIDI 1.0 wire bytes. Each slot below is
+ * the one-line encoding from the spec -- no running status (every message
+ * carries its status byte, because the host queues messages, not a stream),
+ * and no timestamps (a message's arrival IS its time; wk:midi has no clock).
+ */
+class WkMIDIOutput : public MIDIOutput
+{
+    Q_OBJECT
+    Q_PLUGIN_METADATA(IID "net.sourceforge.drumstick.rt.MIDIOutput/2.0")
+    Q_INTERFACES(drumstick::rt::MIDIOutput)
+    Q_PROPERTY(QStringList diagnostics READ getDiagnostics)
+    Q_PROPERTY(QString libversion READ getLibVersion)
+    Q_PROPERTY(bool status READ getStatus)
+    Q_PROPERTY(bool isconfigurable READ getConfigurable)
+
+public:
+    explicit WkMIDIOutput(QObject *parent = nullptr);
+    virtual ~WkMIDIOutput() = default;
+
+    // MIDIOutput interface
+public:
+    void initialize(QSettings *settings) override;
+    QString backendName() override;
+    QString publicName() override;
+    void setPublicName(QString name) override;
+    QList<MIDIConnection> connections(bool advanced) override;
+    void setExcludedConnections(QStringList conns) override;
+    void open(const MIDIConnection &conn) override;
+    void close() override;
+    MIDIConnection currentConnection() override;
+
+public Q_SLOTS:
+    void sendNoteOff(int chan, int note, int vel) override;
+    void sendNoteOn(int chan, int note, int vel) override;
+    void sendKeyPressure(int chan, int note, int value) override;
+    void sendController(int chan, int control, int value) override;
+    void sendProgram(int chan, int program) override;
+    void sendChannelPressure(int chan, int value) override;
+    void sendPitchBend(int chan, int value) override;
+    void sendSysex(const QByteArray &data) override;
+    void sendSystemMsg(const int status) override;
+
+private:
+    QStringList getDiagnostics();
+    QString getLibVersion();
+    bool getStatus();
+    bool getConfigurable();
+
+    QString m_publicName;
+    MIDIConnection m_currentConnection;
+};
+
+}} // namespace drumstick::rt
+
+#endif // WKMIDIOUTPUT_H
