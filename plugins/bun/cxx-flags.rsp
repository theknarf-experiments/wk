--target=wasm32-wasip2
-std=c++23
-fno-exceptions
-O2
-mllvm
-wasm-enable-sjlj
-mllvm
-wasm-use-legacy-eh=false
-DNDEBUG
-DSIMDE_FLOAT16_API=1
-D_WASI_EMULATED_SIGNAL
-D_WASI_EMULATED_GETPID
-D_WASI_EMULATED_MMAN
-D_WASI_EMULATED_PROCESS_CLOCKS
-DU_STATIC_IMPLEMENTATION
-DBUILDING_JSCONLY__
-DBUILDING_WITH_CMAKE=1
-I$BUN_NATIVE/jsc-build
-I$BUN_NATIVE/jsc-build/JavaScriptCore/Headers
-I$BUN_NATIVE/jsc-build/JavaScriptCore/Headers/JavaScriptCore
-I$BUN_NATIVE/jsc-build/WTF/Headers
-I$BUN_NATIVE/jsc-build/bmalloc/Headers
-I$BUN_NATIVE/jsc-build/JavaScriptCore/PrivateHeaders
-Isrc/jsc/bindings
-Isrc/jsc/bindings/webcore
-Isrc/jsc/bindings/webcrypto
-Isrc/jsc/bindings/node/crypto
-Isrc/jsc/bindings/node/http
-Isrc/jsc/bindings/sqlite
-Isrc/jsc/bindings/v8
-Isrc/jsc/bindings/libuv
-Isrc/jsc/modules
-Isrc/js/builtins
-Isrc/runtime/napi
-Isrc/uws_sys
-Ipackages
-Ipackages/bun-usockets/src
-I$BUN_CODEGEN
-Ivendor
-Ivendor/picohttpparser
-Ivendor/zlib
-isystem
$BUN_NATIVE/icu-wasi/install/include
-I$BUN_NATIVE/mimalloc/include
-I$BUN_NATIVE/highway
-I$BUN_NATIVE/boringssl/include
-I$BUN_NATIVE/nodejs-headers/include/node
-I$BUN_NATIVE/libdeflate
-I$BUN_NATIVE/hdrhistogram/include
-I$BUN_NATIVE/cares/include
-I$BUN_NATIVE/brotli/c/include
-I$BUN_NATIVE/jsc-build/JavaScriptCore/PrivateHeaders/JavaScriptCore
-idirafter $BUN_PLUGIN/wasi-compat
-I$BUN_NATIVE/lshpack
-I$BUN_NATIVE/zstd/lib
-I$BUN_NATIVE/libarchive/libarchive
-idirafter
$BUN_NATIVE/lshpack/compat/queue
-DREPORTED_NODEJS_VERSION=\"26.3.0\"
-DREPORTED_NODEJS_ABI_VERSION=137
-DREPORTED_NODEJS_V8_VERSION=\"13.6.233.10\"
-I$BUN_NATIVE/nodejs-headers/include
-fno-rtti
