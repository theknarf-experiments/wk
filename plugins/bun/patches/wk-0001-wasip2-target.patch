+// ── base64 (simdutf's default = padded `+/`, url = unpadded `-_`) ─────────
+
+const B64_STD: &[u8; 64] = b"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+const B64_URL: &[u8; 64] = b"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_";
+
+#[unsafe(no_mangle)]
+unsafe extern "C" fn simdutf__base64_length_from_binary(length: usize, is_urlsafe: c_int) -> usize {
+    if is_urlsafe != 0 {
+        (length * 4).div_ceil(3)
+    } else {
+        length.div_ceil(3) * 4
+    }
+}
+
+#[unsafe(no_mangle)]
+unsafe extern "C" fn simdutf__base64_encode(
+    input: *const u8,
+    length: usize,
+    output: *mut u8,
+    is_urlsafe: c_int,
+) -> usize {
+    let src = unsafe { core::slice::from_raw_parts(input, length) };
+    let alphabet = if is_urlsafe != 0 { B64_URL } else { B64_STD };
+    let mut written = 0usize;
+    let mut push = |b: u8| {
+        // SAFETY: caller sized the buffer via base64_length_from_binary.
+        unsafe { *output.add(written) = b };
+        written += 1;
+    };
+    for chunk in src.chunks(3) {
+        let b = [chunk[0], *chunk.get(1).unwrap_or(&0), *chunk.get(2).unwrap_or(&0)];
+        let v = (u32::from(b[0]) << 16) | (u32::from(b[1]) << 8) | u32::from(b[2]);
+        let syms = [(v >> 18) & 63, (v >> 12) & 63, (v >> 6) & 63, v & 63];
+        let keep = chunk.len() + 1;
+        for (j, &sym) in syms.iter().enumerate() {
+            if j < keep {
+                push(alphabet[sym as usize]);
+            } else if is_urlsafe == 0 {
+                push(b'=');
+            }
+        }
+    }
+    written
+}
+
+/// `simdutf::base64_to_binary_safe` — whitespace-tolerant strict decode.
+/// Invalid character: `{ INVALID_BASE64_CHARACTER (= 7), index }`.
+#[unsafe(no_mangle)]
+unsafe extern "C" fn simdutf__base64_decode_from_binary(
+    input: *const u8,
+    length: usize,
+    output: *mut u8,
+    outlen: usize,
+    is_urlsafe: c_int,
+) -> SimdutfResult {
+    let src = unsafe { core::slice::from_raw_parts(input, length) };
+    let alphabet = if is_urlsafe != 0 { B64_URL } else { B64_STD };
+    let mut rev = [255u8; 256];
+    for (i, &c) in alphabet.iter().enumerate() {
+        rev[c as usize] = i as u8;
+    }
+    let mut acc: u32 = 0;
+    let mut bits = 0u32;
+    let mut written = 0usize;
+    for (i, &c) in src.iter().enumerate() {
+        if c.is_ascii_whitespace() || c == b'=' {
+            continue;
+        }
+        let v = rev[c as usize];
+        if v == 255 {
+            return SimdutfResult {
+                status: 7,
+                count: i,
+            };
+        }
+        acc = (acc << 6) | u32::from(v);
+        bits += 6;
+        if bits >= 8 {
+            bits -= 8;
+            if written >= outlen {
+                // simdutf reports OUTPUT_BUFFER_TOO_SMALL; callers size
+                // exactly, so any code != SUCCESS suffices.
+                return SimdutfResult {
+                    status: 8,
+                    count: written,
+                };
+            }
+            // SAFETY: bounds-checked against outlen above.
+            unsafe { *output.add(written) = (acc >> bits) as u8 };
+            written += 1;
+        }
+    }
+    SimdutfResult {
+        status: 0,
+        count: written,
+    }
+}
