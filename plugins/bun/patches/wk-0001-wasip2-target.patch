+    unsafe extern "C" {
+        fn isatty(fd: c_int) -> c_int;
+        safe static bun_stdio_tty: [core::sync::atomic::AtomicI32; 3];
+    }
+    for fd in 0..3 {
+        // SAFETY: isatty only queries the descriptor.
+        let tty = unsafe { isatty(fd) };
+        bun_stdio_tty[fd as usize].store(tty, core::sync::atomic::Ordering::Relaxed);
+    }
+}
+
+// ── libc gaps in rustc's bundled wasi-libc ────────────────────────────────
+// rustc links its own wasi-libc snapshot, which predates `dup` and doesn't
+// pull the emulation libs mimalloc's stats/snapshot paths want. (Do NOT fix
+// this by putting the wasi-sdk lib dir on the search path — its libc.a then
+// preempts rustc's and breaks `__wasi_init_tp` in rust's crt1.)
+
+/// wasi-libc's own `dup` is `fcntl(fd, F_DUPFD, 0)` over the descriptor
+/// table. rustc's bundled wasi-libc predates F_DUPFD (returns EINVAL), so
+/// callers that can reopen instead do (see bun_sys's dir iterator); this
+/// forwards for the day the bundled libc catches up.
+#[unsafe(no_mangle)]
+extern "C" fn dup(fd: c_int) -> c_int {
+    const F_DUPFD: c_int = 5; // <__header_fcntl.h>
+    unsafe { libc::fcntl(fd, F_DUPFD, 0) }
+}
+
+/// `clock(3)` for mimalloc's stats. wasi CLOCKS_PER_SEC is 1e9, so the
+/// monotonic clock in nanoseconds IS the right unit.
+#[unsafe(no_mangle)]
+extern "C" fn clock() -> i64 {
+    let mut ts = libc::timespec {
+        tv_sec: 0,
+        tv_nsec: 0,
+    };
+    // SAFETY: valid out-pointer; wasi-libc's monotonic clock always exists.
+    unsafe { libc::clock_gettime(libc::CLOCK_MONOTONIC, &mut ts) };
+    ts.tv_sec * 1_000_000_000 + i64::from(ts.tv_nsec)
+}
+
+/// `getpid` for mimalloc's heap-snapshot filename; same placeholder the
+/// `-lwasi-emulated-getpid` library would return.
+#[unsafe(no_mangle)]
+extern "C" fn getpid() -> c_int {
+    42
+}
+
+/// zlib `compress2` — referenced by the sourcemap gzip path, which the
+/// transform pipeline doesn't take. Real zlib arrives with the runtime port.
+#[unsafe(no_mangle)]
+extern "C" fn compress2(
+    _dest: *mut u8,
+    _dest_len: *mut usize,
+    _src: *const u8,
+    _src_len: usize,
+    _level: c_int,
+) -> c_int {
+    unreachable!("zlib not linked on wasm yet (sourcemap gzip)");
+}
+
+// ── BoringSSL X.509 pretty-printing (unreachable from a transpile) ────────
+
+macro_rules! ssl_abort_stubs {
+    ($($name:ident($($arg:ty),*) -> $ret:ty;)+) => {$(
+        #[unsafe(no_mangle)]
+        extern "C" fn $name($(_: $arg),*) -> $ret {
+            unreachable!("BoringSSL is not linked on wasm; no TLS/cert paths exist")
+        }
+    )+};
+}
+ssl_abort_stubs! {
+    ASN1_STRING_to_UTF8(*mut *mut u8, *const c_void) -> c_int;
+    GENERAL_NAME_free(*mut c_void) -> ();
+    OPENSSL_free(*mut c_void) -> ();
+    sk_num(*const c_void) -> usize;
+    sk_pop_free_ex(*mut c_void, *const c_void, *const c_void) -> ();
+    sk_value(*const c_void, usize) -> *mut c_void;
+    X509_get_ext(*const c_void, c_int) -> *mut c_void;
+    X509_get_ext_by_NID(*const c_void, c_int, c_int) -> c_int;
+    X509_get_subject_name(*const c_void) -> *mut c_void;
+    X509_NAME_ENTRY_get_data(*const c_void) -> *mut c_void;
+    X509_NAME_get_entry(*const c_void, c_int) -> *mut c_void;
+    X509_NAME_get_index_by_NID(*const c_void, c_int, c_int) -> c_int;
+    X509V3_EXT_d2i(*const c_void) -> *mut c_void;
+    X509V3_EXT_get(*const c_void) -> *mut c_void;
+    X509V3_EXT_get_nid(c_int) -> *mut c_void;
+}
