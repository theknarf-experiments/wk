diff --git a/src/watcher/WasiWatcher.rs b/src/watcher/WasiWatcher.rs
new file mode 100644
index 00000000..26430da0
--- /dev/null
+++ b/src/watcher/WasiWatcher.rs
@@ -0,0 +1,30 @@
+//! WASI backend: watchlist bookkeeping only, events never fire. WASI has no
+//! file change notification (and a wk guest's vfs none yet either), so
+//! `--watch` degrades to "runs once" instead of failing to start. Per-file
+//! OS registration is a per-backend concern (the linux/macos arms in
+//! `Watcher.rs` are cfg'd to their platforms); this backend has none.
+
+use crate::Watcher;
+
+pub(crate) type Platform = WasiWatcher;
+
+pub struct WasiWatcher;
+
+impl WasiWatcher {
+    pub(crate) fn new(_root: &[u8]) -> crate::Result<Self> {
+        Ok(WasiWatcher)
+    }
+
+    pub(crate) fn stop(&mut self) {}
+}
+
+/// Repeatedly called by the main watcher until the watcher is terminated.
+pub(crate) fn watch_loop_cycle(this: &mut Watcher) -> bun_sys::Result<()> {
+    // No event source: dispatch the (always empty) batch — keeping the shared
+    // trace/callback path live — then terminate the loop.
+    this.dispatch_file_updates(0, 0);
+    Err(bun_sys::Error::from_code_int(
+        bun_errno::SystemErrno::ENOSYS as i32,
+        bun_sys::Tag::TODO,
+    ))
+}
