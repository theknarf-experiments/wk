+/// First char the printer must escape inside a `quote_char` string:
+/// DEL/non-ascii (>= 127), control, backslash, the quote itself, and `$`
+/// inside template literals.
+#[unsafe(no_mangle)]
+unsafe extern "C" fn highway_index_of_needs_escape_for_javascript_string(
+    text: *const u8,
+    text_len: usize,
+    quote_char: u8,
