+// WASI errno table. Values come from wasi-libc's `__errno_values.h`
+// (wasm32-wasip2 sysroot) — WASI inherited CloudABI's alphabetically-ordered
+// errno space, so NO value below matches Linux/Darwin/FreeBSD.
+//
+// `EWOULDBLOCK`/`EOPNOTSUPP` are #define-aliases of `EAGAIN`/`ENOTSUP` in the
+// header; Rust enums need unique discriminants, so they (and the errnos WASI
+// lacks entirely but shared code names, e.g. `ESHUTDOWN`) get synthetic
+// values past the real range — decoding never produces them, mirroring how
+// linux_errno.rs uniquifies `EWOULDBLOCK`.
+pub use crate::posix::E;
+pub use crate::posix::S;
+pub use crate::posix::mode_t as Mode;
+
+#[repr(u16)]
+#[derive(
+    Copy, Clone, Eq, PartialEq, Hash, Debug, strum::IntoStaticStr, strum::EnumString, enum_map::Enum,
+)]
+pub enum SystemErrno {
+    SUCCESS = 0,
+    E2BIG = 1,
+    EACCES = 2,
+    EADDRINUSE = 3,
+    EADDRNOTAVAIL = 4,
+    EAFNOSUPPORT = 5,
+    EAGAIN = 6,
+    EALREADY = 7,
+    EBADF = 8,
+    EBADMSG = 9,
+    EBUSY = 10,
+    ECANCELED = 11,
+    ECHILD = 12,
+    ECONNABORTED = 13,
+    ECONNREFUSED = 14,
+    ECONNRESET = 15,
+    EDEADLK = 16,
+    EDESTADDRREQ = 17,
+    EDOM = 18,
+    EDQUOT = 19,
+    EEXIST = 20,
+    EFAULT = 21,
+    EFBIG = 22,
+    EHOSTUNREACH = 23,
+    EIDRM = 24,
+    EILSEQ = 25,
+    EINPROGRESS = 26,
+    EINTR = 27,
+    EINVAL = 28,
+    EIO = 29,
+    EISCONN = 30,
+    EISDIR = 31,
+    ELOOP = 32,
+    EMFILE = 33,
+    EMLINK = 34,
+    EMSGSIZE = 35,
+    EMULTIHOP = 36,
+    ENAMETOOLONG = 37,
+    ENETDOWN = 38,
+    ENETRESET = 39,
+    ENETUNREACH = 40,
+    ENFILE = 41,
+    ENOBUFS = 42,
+    ENODEV = 43,
+    ENOENT = 44,
+    ENOEXEC = 45,
+    ENOLCK = 46,
+    ENOLINK = 47,
+    ENOMEM = 48,
+    ENOMSG = 49,
+    ENOPROTOOPT = 50,
+    ENOSPC = 51,
+    ENOSYS = 52,
+    ENOTCONN = 53,
+    ENOTDIR = 54,
+    ENOTEMPTY = 55,
+    ENOTRECOVERABLE = 56,
+    ENOTSOCK = 57,
+    ENOTSUP = 58,
+    ENOTTY = 59,
+    ENXIO = 60,
+    EOVERFLOW = 61,
+    EOWNERDEAD = 62,
+    EPERM = 63,
+    EPIPE = 64,
+    EPROTO = 65,
+    EPROTONOSUPPORT = 66,
+    EPROTOTYPE = 67,
+    ERANGE = 68,
+    EROFS = 69,
+    ESPIPE = 70,
+    ESRCH = 71,
+    ESTALE = 72,
+    ETIMEDOUT = 73,
+    ETXTBSY = 74,
+    EXDEV = 75,
+    ENOTCAPABLE = 76,
+    // Synthetic (not real WASI errnos; see header comment).
+    EWOULDBLOCK = 77,
+    EOPNOTSUPP = 78,
+    ESHUTDOWN = 79,
+    EHOSTDOWN = 80,
+    ESOCKTNOSUPPORT = 81,
+    ENODATA = 82,
+    EFTYPE = 83,
+}
+
+impl SystemErrno {
+    pub const MAX: u16 = 84;
+}
+
+#[allow(non_upper_case_globals)]
+pub mod uv_e {
+    // Native `SystemErrno::$e as i32`; libuv-synthetic fallback for the codes
+    // WASI lacks (the four every-POSIX synthetics plus the BSD/SysV strays).
+    macro_rules! __v {
+        (CHARSET,        $e:tt, $uv:tt) => { -::bun_libuv_sys::$uv };
+        (NONET,          $e:tt, $uv:tt) => { -::bun_libuv_sys::$uv };
+        (REMOTEIO,       $e:tt, $uv:tt) => { -::bun_libuv_sys::$uv };
+        (UNATCH,         $e:tt, $uv:tt) => { -::bun_libuv_sys::$uv };
+        (SHUTDOWN,       $e:tt, $uv:tt) => { -::bun_libuv_sys::$uv };
+        (HOSTDOWN,       $e:tt, $uv:tt) => { -::bun_libuv_sys::$uv };
+        (SOCKTNOSUPPORT, $e:tt, $uv:tt) => { -::bun_libuv_sys::$uv };
+        (NODATA,         $e:tt, $uv:tt) => { -::bun_libuv_sys::$uv };
+        (FTYPE,          $e:tt, $uv:tt) => { -::bun_libuv_sys::$uv };
+        ($i:tt,          $e:tt, $uv:tt) => { super::SystemErrno::$e as i32 };
+    }
+    crate::__uv_e_rows!(__v);
+}
+
+// wasi-libc follows the Darwin/FreeBSD convention: every failure returns the
+// all-ones sentinel with the real code in the thread-local errno slot.
+impl_get_errno_libc!(i32, u32, isize, usize, i64);
