+#[unsafe(no_mangle)]
+unsafe extern "C" fn highway_memrmem(
+    haystack: *const u8,
+    haystack_len: usize,
+    needle: *const u8,
+    needle_len: usize,
+) -> usize {
+    let (h, n) = unsafe {
+        (
+            core::slice::from_raw_parts(haystack, haystack_len),
+            core::slice::from_raw_parts(needle, needle_len),
+        )
+    };
+    if n.is_empty() {
+        return h.len();
+    }
+    if h.len() < n.len() {
+        return usize::MAX;
