diff --git a/src/wk_cli/jsc_api.rs b/src/wk_cli/jsc_api.rs
new file mode 100644
index 00000000..5ed1bbba
--- /dev/null
+++ b/src/wk_cli/jsc_api.rs
@@ -0,0 +1,139 @@
+//! Minimal bindings to JavaScriptCore's C API (the wasi cloop build from
+//! plugins/bun/build-jsc.sh) — enough to evaluate the transpiler's output
+//! and print. This is the interim execution path; bun's real `*_jsc` bridge
+//! (which speaks the C++ additions layer, not the C API) replaces it as the
+//! port advances.
+
+#![allow(non_snake_case)]
+
+use core::ffi::{c_char, c_uint, c_void};
+
+pub(crate) type JSContextRef = *const c_void;
+pub(crate) type JSGlobalContextRef = *mut c_void;
+pub(crate) type JSValueRef = *const c_void;
+pub(crate) type JSObjectRef = *mut c_void;
+pub(crate) type JSStringRef = *mut c_void;
+type JSObjectCallAsFunctionCallback = unsafe extern "C" fn(
+    ctx: JSContextRef,
+    function: JSObjectRef,
+    this_object: JSObjectRef,
+    argument_count: usize,
+    arguments: *const JSValueRef,
+    exception: *mut JSValueRef,
+) -> JSValueRef;
+
+unsafe extern "C" {
+    fn JSGlobalContextCreate(global_object_class: *mut c_void) -> JSGlobalContextRef;
+    fn JSContextGetGlobalObject(ctx: JSContextRef) -> JSObjectRef;
+    fn JSEvaluateScript(
+        ctx: JSContextRef,
+        script: JSStringRef,
+        this_object: JSObjectRef,
+        source_url: JSStringRef,
+        starting_line_number: i32,
+        exception: *mut JSValueRef,
+    ) -> JSValueRef;
+    fn JSStringCreateWithUTF8CString(string: *const c_char) -> JSStringRef;
+    fn JSStringRelease(string: JSStringRef);
+    fn JSStringGetMaximumUTF8CStringSize(string: JSStringRef) -> usize;
+    fn JSStringGetUTF8CString(string: JSStringRef, buffer: *mut c_char, buffer_size: usize) -> usize;
+    fn JSValueToStringCopy(ctx: JSContextRef, value: JSValueRef, exception: *mut JSValueRef) -> JSStringRef;
+    fn JSValueMakeUndefined(ctx: JSContextRef) -> JSValueRef;
+    fn JSObjectMakeFunctionWithCallback(
+        ctx: JSContextRef,
+        name: JSStringRef,
+        callback: JSObjectCallAsFunctionCallback,
+    ) -> JSObjectRef;
+    fn JSObjectSetProperty(
+        ctx: JSContextRef,
+        object: JSObjectRef,
+        property_name: JSStringRef,
+        value: JSValueRef,
+        attributes: c_uint,
+        exception: *mut JSValueRef,
+    );
+    fn JSObjectMake(ctx: JSContextRef, class: *mut c_void, data: *mut c_void) -> JSObjectRef;
+}
+
+fn js_string(s: &str) -> JSStringRef {
+    let c = std::ffi::CString::new(s).expect("no interior NULs in source");
+    // SAFETY: valid NUL-terminated pointer for the duration of the call.
+    unsafe { JSStringCreateWithUTF8CString(c.as_ptr()) }
+}
+
+fn to_rust_string(ctx: JSContextRef, value: JSValueRef) -> String {
+    // SAFETY: ctx/value are live; a failed copy yields null, mapped to "".
+    unsafe {
+        let js = JSValueToStringCopy(ctx, value, core::ptr::null_mut());
+        if js.is_null() {
+            return String::new();
+        }
+        let cap = JSStringGetMaximumUTF8CStringSize(js);
+        let mut buf = vec![0u8; cap.max(1)];
+        let written = JSStringGetUTF8CString(js, buf.as_mut_ptr().cast(), buf.len());
+        JSStringRelease(js);
+        buf.truncate(written.saturating_sub(1)); // drop the NUL
+        String::from_utf8_lossy(&buf).into_owned()
+    }
+}
+
+unsafe extern "C" fn print_callback(
+    ctx: JSContextRef,
+    _function: JSObjectRef,
+    _this: JSObjectRef,
+    argument_count: usize,
+    arguments: *const JSValueRef,
+    _exception: *mut JSValueRef,
+) -> JSValueRef {
+    use std::io::Write;
+    let mut out = std::io::stdout();
+    for i in 0..argument_count {
+        // SAFETY: JSC passes `argument_count` valid values.
+        let arg = unsafe { *arguments.add(i) };
+        if i > 0 {
+            let _ = out.write_all(b" ");
+        }
+        let _ = out.write_all(to_rust_string(ctx, arg).as_bytes());
+    }
+    let _ = out.write_all(b"\n");
+    let _ = out.flush();
+    // SAFETY: ctx is live.
+    unsafe { JSValueMakeUndefined(ctx) }
+}
+
+/// Evaluate `source` in a fresh global context with `print`/`console.log`
+/// wired to stdout. Returns the uncaught-exception text, if any.
+pub(crate) fn evaluate(source: &str, source_url: &str) -> Result<(), String> {
+    // SAFETY: straight-line C API use; every ref we create is either
+    // released or owned by the context, which lives for the process.
+    unsafe {
+        let ctx = JSGlobalContextCreate(core::ptr::null_mut());
+        let global = JSContextGetGlobalObject(ctx);
+
+        let print_name = js_string("print");
+        let print_fn = JSObjectMakeFunctionWithCallback(ctx, print_name, print_callback);
+        JSObjectSetProperty(ctx, global, print_name, print_fn.cast_const(), 0, core::ptr::null_mut());
+
+        let console = JSObjectMake(ctx, core::ptr::null_mut(), core::ptr::null_mut());
+        for method in ["log", "error", "warn", "info", "debug"] {
+            let name = js_string(method);
+            JSObjectSetProperty(ctx, console, name, print_fn.cast_const(), 0, core::ptr::null_mut());
+            JSStringRelease(name);
+        }
+        let console_name = js_string("console");
+        JSObjectSetProperty(ctx, global, console_name, console.cast_const(), 0, core::ptr::null_mut());
+        JSStringRelease(console_name);
+
+        let script = js_string(source);
+        let url = js_string(source_url);
+        let mut exception: JSValueRef = core::ptr::null();
+        let result = JSEvaluateScript(ctx, script, core::ptr::null_mut(), url, 1, &mut exception);
+        JSStringRelease(script);
+        JSStringRelease(url);
+
+        if result.is_null() && !exception.is_null() {
+            return Err(to_rust_string(ctx, exception));
+        }
+        Ok(())
+    }
+}
diff --git a/src/wk_cli/main.rs b/src/wk_cli/main.rs
new file mode 100644
index 00000000..e9caf1c0
--- /dev/null
+++ b/src/wk_cli/main.rs
@@ -0,0 +1,82 @@
+#![allow(non_snake_case)]
+//! `bun-transpile` — real Bun transpiling TS/TSX/JSX to stdout inside a wk
+//! wasm node. Drives the same `Transpiler::transform` pipeline as
+//! `bun build --no-bundle`, minus the CLI/JSC tiers that can't exist on
+//! wasm yet. Mirrors `Cli::start`'s minimal init: one process-lifetime
+//! `Log` + `Arena`, then transform each entry point to stdout.
+
+mod jsc_api;
+mod wasi_shims;
+
+use bun_options_types::schema::api;
+
+fn main() {
+    let mut args: Vec<String> = std::env::args().collect();
+    // --run: transpile, then execute the result on JSC (the wasi cloop build)
+    // instead of printing it.
+    let run_mode = args.iter().any(|a| a == "--run");
+    args.retain(|a| a != "--run");
+    if args.len() < 2 {
+        bun_core::pretty_errorln!("usage: bun-transpile [--run] FILE.ts [FILE...]");
+        std::process::exit(2);
+    }
+
+    bun_core::output::stdio::init();
+
+    // Process-lifetime, same as the real CLI (`exec` diverges there; we exit).
+    let arena: &'static bun_alloc::Arena = Box::leak(Box::new(bun_alloc::Arena::new()));
+    let log: &'static mut bun_ast::Log = Box::leak(Box::new(bun_ast::Log::init()));
+    let log_ptr: *mut bun_ast::Log = log;
+
+    let mut opts = api::TransformOptions::default();
+    opts.entry_points = args[1..]
+        .iter()
+        .map(|a| a.as_bytes().to_vec().into_boxed_slice())
+        .collect();
+
+    let result = bun_transpiler::Transpiler::init(arena, log_ptr, opts.clone(), None).and_then(|t| {
+        let t = arena.alloc(t);
+        // Same order as BuildCommand::exec.
+        t.configure_defines()?;
+        t.configure_linker();
+        t.transform(log_ptr, opts)
+    });
+
+    if let Ok(result) = &result {
+        if run_mode {
+            for f in &result.output_files {
+                if let bun_bundler::options::OutputFileValue::Buffer { bytes } = &f.value {
+                    let source = String::from_utf8_lossy(bytes);
+                    if let Err(exception) = jsc_api::evaluate(&source, &args[1]) {
+                        bun_core::pretty_errorln!("uncaught: {}", exception);
+                        bun_core::Output::flush();
+                        std::process::exit(1);
+                    }
+                }
+            }
+        } else {
+            // Same as BuildCommand's no-outdir path: buffer-valued outputs go
+            // straight to stdout.
+            use std::io::Write;
+            let mut out = std::io::stdout();
+            for f in &result.output_files {
+                if let bun_bundler::options::OutputFileValue::Buffer { bytes } = &f.value {
+                    let _ = out.write_all(bytes);
+                }
+            }
+            let _ = out.flush();
+        }
+    }
+
+    if log.errors > 0 || result.is_err() {
+        let _ = log.print(std::ptr::from_mut::<bun_core::io::Writer>(
+            bun_core::Output::error_writer(),
+        ));
+        if let Err(err) = result {
+            bun_core::pretty_errorln!("<red>error<r>: {:?}", err);
+        }
+        bun_core::Output::flush();
+        std::process::exit(1);
+    }
+    bun_core::Output::flush();
+}
diff --git a/src/wk_cli/wasi_shims.rs b/src/wk_cli/wasi_shims.rs
new file mode 100644
index 00000000..059ea47c
--- /dev/null
+++ b/src/wk_cli/wasi_shims.rs
@@ -0,0 +1,695 @@
+//! Native symbols the transpiler slice references but which live in tiers
+//! that don't exist on wasm yet, in three classes:
+//!
+//! * **WebKit/WTF number machinery** — runtime-reachable from the printer and
+//!   constant folder, so these are real (approximate) implementations, not
+//!   aborts. They come with the JSC port later.
+//! * **JSC/dispatch/package-manager hooks** — referenced but unreachable in a
+//!   transform-only run (`ALLOW_MACROS` is false on wasm, no VM exists);
+//!   no-ops or aborts.
+//! * **BoringSSL X.509 helpers** — cert pretty-printing paths that a
+//!   transpile can't reach; aborts.
+//!
+//! mimalloc / highway / simdutf are NOT stubbed — build.sh compiles the real
+//! libraries with wasi-sdk.
+
+use core::ffi::{c_int, c_void};
+
+// ── WTF number machinery (approximations; JSC port replaces these) ────────
+
+/// `WTF::numberToString` — ES `ToString(Number)`: shortest round-trip
+/// digits, exponent form outside [1e-6, 1e21). Rust's shortest-round-trip
+/// formatter provides the digits; the exponent styling is applied here.
+#[unsafe(no_mangle)]
+extern "C" fn WTF__dtoa(buf: &mut [u8; 124], number: f64) -> usize {
+    let s = if number.is_nan() {
+        "NaN".to_string()
+    } else if number.is_infinite() {
+        if number < 0.0 { "-Infinity" } else { "Infinity" }.to_string()
+    } else if number == 0.0 {
+        "0".to_string()
+    } else if number.abs() >= 1e21 || number.abs() < 1e-6 {
+        // "1.5e30" → "1.5e+30" (ES always signs the exponent).
+        let e = format!("{:e}", number);
+        match e.find('e') {
+            Some(i) if e.as_bytes().get(i + 1) != Some(&b'-') => {
+                format!("{}e+{}", &e[..i], &e[i + 1..])
+            }
+            _ => e,
+        }
+    } else {
+        format!("{}", number)
+    };
+    let n = s.len().min(buf.len());
+    buf[..n].copy_from_slice(&s.as_bytes()[..n]);
+    n
+}
+
+/// `WTF::parseDouble` — JS-semantics prefix parse of a Latin-1 decimal.
+/// Callers feed lexer-validated numeric text, so a longest-valid-prefix
+/// retry loop is enough.
+#[unsafe(no_mangle)]
+unsafe extern "C" fn WTF__parseDouble(bytes: *const u8, length: usize, counted: *mut usize) -> f64 {
+    let s = unsafe { core::slice::from_raw_parts(bytes, length) };
+    let mut end = s.len();
+    while end > 0 {
+        if let Ok(text) = core::str::from_utf8(&s[..end])
+            && let Ok(v) = text.parse::<f64>()
+        {
+            unsafe { *counted = end };
+            return v;
+        }
+        end -= 1;
+    }
+    unsafe { *counted = 0 };
+    f64::NAN
+}
+
+/// JSC's `operationMathPow` — ES `**`: like `powf` except `±1 ** ±Infinity`
+/// is NaN (IEEE says 1).
+#[unsafe(no_mangle)]
+extern "C" fn Bun__JSC__operationMathPow(x: f64, y: f64) -> f64 {
+    if y.is_infinite() && x.abs() == 1.0 {
+        return f64::NAN;
+    }
+    x.powf(y)
+}
+
+/// JSC's `jsToNumber(String)` — ES `ToNumber(string)` for constant folding:
+/// trimmed empty → 0, hex/octal/binary prefixes, `Infinity`, else decimal.
+#[unsafe(no_mangle)]
+unsafe extern "C" fn JSC__jsToNumber(ptr: *const u8, len: usize) -> f64 {
+    let s = unsafe { core::slice::from_raw_parts(ptr, len) };
+    let Ok(s) = core::str::from_utf8(s) else {
+        return f64::NAN;
+    };
+    let t = s.trim_matches(|c: char| c.is_whitespace() || c == '\u{feff}');
+    if t.is_empty() {
+        return 0.0;
+    }
+    let radix = |p: &str, r: u32| i64::from_str_radix(p, r).map(|v| v as f64).ok();
+    if let Some(hex) = t.strip_prefix("0x").or_else(|| t.strip_prefix("0X")) {
+        return radix(hex, 16).unwrap_or(f64::NAN);
+    }
+    if let Some(oct) = t.strip_prefix("0o").or_else(|| t.strip_prefix("0O")) {
+        return radix(oct, 8).unwrap_or(f64::NAN);
+    }
+    if let Some(bin) = t.strip_prefix("0b").or_else(|| t.strip_prefix("0B")) {
+        return radix(bin, 2).unwrap_or(f64::NAN);
+    }
+    match t {
+        "Infinity" | "+Infinity" => f64::INFINITY,
+        "-Infinity" => f64::NEG_INFINITY,
+        _ => t.parse::<f64>().unwrap_or(f64::NAN),
+    }
+}
+
+/// Same probe trick as `bun_parsers::native_test_shims` — the caller treats
+/// the result as the recursion floor.
+#[unsafe(no_mangle)]
+extern "C" fn Bun__StackCheck__getMaxStack() -> *mut c_void {
+    let probe: u8 = 0;
+    let approx_sp = (&raw const probe) as usize;
+    (approx_sp.saturating_sub(512 * 1024)) as *mut c_void
+}
+
+// ── Scalar fallbacks for the SIMD kernels the linker kept ─────────────────
+// Same shapes as `bun_parsers::native_test_shims` (which is `cfg(test)`-only).
+// A real highway/simdutf wasi build can replace these later.
+
