+/// Strict UTF-8 → UTF-16LE. Success: `{ SUCCESS, units written }`; invalid
+/// input reports TOO_SHORT (= 2) at the end of the valid prefix — callers
+/// only branch on SUCCESS.
+#[unsafe(no_mangle)]
+unsafe extern "C" fn simdutf__convert_utf8_to_utf16le_with_errors(
+    buf: *const u8,
+    len: usize,
+    utf16_output: *mut u16,
+) -> SimdutfResult {
+    let s = unsafe { core::slice::from_raw_parts(buf, len) };
+    match core::str::from_utf8(s) {
+        Ok(text) => {
+            let mut written = 0usize;
+            for c in text.chars() {
+                let mut units = [0u16; 2];
+                for &u in c.encode_utf16(&mut units).iter() {
+                    // SAFETY: caller sized the buffer via utf16_length_from_utf8.
+                    unsafe { *utf16_output.add(written) = u };
+                    written += 1;
+                }
+            }
+            SimdutfResult {
+                status: 0,
+                count: written,
+            }
+        }
+        Err(e) => SimdutfResult {
+            status: 2,
+            count: e.valid_up_to(),
+        },
+    }
+}
+
+/// Strict UTF-16LE → UTF-8. Unpaired surrogate: `{ SURROGATE (= 6), index }`.
+#[unsafe(no_mangle)]
+unsafe extern "C" fn simdutf__convert_utf16le_to_utf8_with_errors(
+    buf: *const u16,
+    len: usize,
+    utf8_buffer: *mut u8,
+) -> SimdutfResult {
+    let units = unsafe { core::slice::from_raw_parts(buf, len) };
+    let mut written = 0usize;
+    let mut i = 0usize;
+    for c in char::decode_utf16(units.iter().copied()) {
+        match c {
+            Ok(c) => {
+                let mut bytes = [0u8; 4];
+                let n = c.encode_utf8(&mut bytes).len();
+                // SAFETY: caller sized the buffer via utf8_length_from_utf16le.
+                unsafe {
+                    core::ptr::copy_nonoverlapping(bytes.as_ptr(), utf8_buffer.add(written), n)
+                };
+                written += n;
+                i += c.len_utf16();
+            }
+            Err(_) => {
+                return SimdutfResult {
+                    status: 6,
+                    count: i,
+                };
+            }
+        }
+    }
+    SimdutfResult {
+        status: 0,
+        count: written,
+    }
+}
