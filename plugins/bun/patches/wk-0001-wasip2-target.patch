+/// wasi-libc has no mkdtemp; fill the trailing `XXXXXX` from the monotonic
+/// clock and mkdir the result (single-threaded guest — no races). Returns the
+/// input pointer on success, null on failure (matching mkdtemp's contract).
+#[cfg(target_os = "wasi")]
+pub fn mkdtemp_shim(template: *mut core::ffi::c_char) -> *mut core::ffi::c_char {
+    // SAFETY: caller passes a NUL-terminated writable C string ending in Xs.
+    unsafe {
+        let mut len = 0usize;
+        while *template.add(len) != 0 {
+            len += 1;
+        }
+        let mut ts = libc::timespec { tv_sec: 0, tv_nsec: 0 };
+        libc::clock_gettime(libc::CLOCK_MONOTONIC, &mut ts);
+        let mut stamp = (ts.tv_sec as u64).wrapping_mul(1_000_000_000).wrapping_add(ts.tv_nsec as u64);
+        let mut i = len;
+        while i > 0 && *template.add(i - 1) == b'X' as core::ffi::c_char {
+            *template.add(i - 1) = (b'a' + (stamp % 26) as u8) as core::ffi::c_char;
+            stamp /= 26;
+            i -= 1;
+        }
+        if libc::mkdir(template, 0o700) == 0 {
+            template
+        } else {
+            core::ptr::null_mut()
+        }
+    }
