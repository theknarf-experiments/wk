+    let t = unsafe { core::slice::from_raw_parts(text, text_len) };
+    let is_backtick = quote_char == b'`';
+    t.iter()
+        .position(|&c| {
+            c >= 127 || c < 0x20 || c == b'\\' || c == quote_char || (is_backtick && c == b'$')
