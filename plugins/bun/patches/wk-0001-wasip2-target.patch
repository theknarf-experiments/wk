+// ── libc gaps in rustc's bundled wasi-libc ────────────────────────────────
+// rustc links its own wasi-libc snapshot, which predates `dup` and doesn't
+// pull the emulation libs mimalloc's stats/snapshot paths want. (Do NOT fix
+// this by putting the wasi-sdk lib dir on the search path — its libc.a then
+// preempts rustc's and breaks `__wasi_init_tp` in rust's crt1.)
+
+/// wasi-libc's own `dup` is `fcntl(fd, F_DUPFD, 0)` over the descriptor
+/// table. rustc's bundled wasi-libc predates F_DUPFD (returns EINVAL), so
+/// callers that can reopen instead do (see bun_sys's dir iterator); this
+/// forwards for the day the bundled libc catches up.
+#[unsafe(no_mangle)]
+extern "C" fn dup(fd: c_int) -> c_int {
+    const F_DUPFD: c_int = 5; // <__header_fcntl.h>
+    unsafe { libc::fcntl(fd, F_DUPFD, 0) }
+}
+
+/// `clock(3)` for mimalloc's stats. wasi CLOCKS_PER_SEC is 1e9, so the
+/// monotonic clock in nanoseconds IS the right unit.
+#[unsafe(no_mangle)]
+extern "C" fn clock() -> i64 {
+    let mut ts = libc::timespec {
+        tv_sec: 0,
+        tv_nsec: 0,
+    };
+    // SAFETY: valid out-pointer; wasi-libc's monotonic clock always exists.
+    unsafe { libc::clock_gettime(libc::CLOCK_MONOTONIC, &mut ts) };
+    ts.tv_sec * 1_000_000_000 + i64::from(ts.tv_nsec)
+}
