+/// Pairing-aware UTF-8 byte count for UTF-16LE; unpaired surrogates count 3
+/// bytes — which also matches the `_with_replacement` variant (U+FFFD is 3).
+fn utf8_len_from_utf16(units: &[u16]) -> usize {
+    let mut n = 0usize;
+    let mut i = 0usize;
+    while i < units.len() {
+        let u = units[i];
+        if u < 0x80 {
+            n += 1;
+        } else if u < 0x800 {
+            n += 2;
+        } else if (0xD800..0xDC00).contains(&u)
+            && i + 1 < units.len()
+            && (0xDC00..0xE000).contains(&units[i + 1])
+        {
+            n += 4;
+            i += 1;
+        } else {
+            n += 3;
+        }
+        i += 1;
+    }
+    n
+}
+
+#[unsafe(no_mangle)]
+unsafe extern "C" fn simdutf__utf8_length_from_utf16le(input: *const u16, length: usize) -> usize {
+    utf8_len_from_utf16(unsafe { core::slice::from_raw_parts(input, length) })
+}
+
+#[unsafe(no_mangle)]
+unsafe extern "C" fn simdutf__utf8_length_from_utf16le_with_replacement(
+    input: *const u16,
+    length: usize,
+) -> usize {
+    utf8_len_from_utf16(unsafe { core::slice::from_raw_parts(input, length) })
+}
