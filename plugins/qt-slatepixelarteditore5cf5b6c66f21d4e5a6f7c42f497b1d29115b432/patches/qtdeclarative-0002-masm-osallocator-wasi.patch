+namespace WTF {
+
+void* OSAllocator::reserveUncommitted(size_t bytes, Usage usage, bool writable, bool executable)
+{
+    return reserveAndCommit(bytes, usage, writable, executable);
+}
+
+void* OSAllocator::reserveAndCommit(size_t bytes, Usage usage, bool writable, bool executable, bool includesGuardPages)
+{
+    UNUSED_PARAM(usage);
+    UNUSED_PARAM(writable);
+    UNUSED_PARAM(executable);
+    // Guard pages would need PROT_NONE, which linear memory cannot express.
+    // Only the executable allocator asks for them, and there is no executable
+    // memory here (see canAllocateExecutableMemory below).
+    UNUSED_PARAM(includesGuardPages);
+
+    const size_t alignment = pageSize();
+    const size_t size = (bytes + alignment - 1) & ~(alignment - 1);
+    void* result = std::aligned_alloc(alignment, size);
+    if (!result)
+        CRASH();
+    std::memset(result, 0, size);
+    return result;
+}
+
+void OSAllocator::commit(void* address, size_t bytes, bool writable, bool executable)
+{
+    UNUSED_PARAM(address);
+    UNUSED_PARAM(bytes);
+    UNUSED_PARAM(writable);
+    UNUSED_PARAM(executable);
+}
 
+void OSAllocator::decommit(void* address, size_t bytes)
+{
+    UNUSED_PARAM(address);
+    UNUSED_PARAM(bytes);
+}
+
+void OSAllocator::releaseDecommitted(void* address, size_t bytes)
+{
+    UNUSED_PARAM(bytes);
+    std::free(address);
+}
+
+bool OSAllocator::canAllocateExecutableMemory()
+{
+    // No, and it is important to say so rather than probe for it: wasm code is
+    // not data, there is no way to make linear memory executable, and
+    // wasi-libc's mprotect() is a stub that returns 0 -- so the POSIX probe
+    // below (mmap RW, then mprotect PROT_EXEC) would report SUCCESS.
+    return false;
+}
+
