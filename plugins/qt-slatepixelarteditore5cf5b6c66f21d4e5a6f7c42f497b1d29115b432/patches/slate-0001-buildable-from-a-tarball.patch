+# and git never carries it). BUILD_VERSION can be supplied by the packager
+# instead; it only ever reaches the About box.
+if(NOT BUILD_VERSION AND EXISTS ${CMAKE_SOURCE_DIR}/.git)
     find_package(Git)
     if(GIT_FOUND)
         EXECUTE_PROCESS(
@@ -264,15 +269,13 @@
             OUTPUT_VARIABLE BUILD_VERSION
             OUTPUT_STRIP_TRAILING_WHITESPACE
             )
-
-        configure_file(
-            ${CMAKE_CURRENT_SOURCE_DIR}/vcs-repo-state.h.in
-            ${CMAKE_CURRENT_BINARY_DIR}/vcs-repo-state.h
-            )
-    else()
-        message(FATAL_ERROR "Can not find Git")
     endif()
-else()
-    message(FATAL_ERROR "Can not find .git repo")
 endif()
+if(NOT BUILD_VERSION)
+    set(BUILD_VERSION "unknown")
+endif()
+configure_file(
+    ${CMAKE_CURRENT_SOURCE_DIR}/vcs-repo-state.h.in
+    ${CMAKE_CURRENT_BINARY_DIR}/vcs-repo-state.h
+    )
 
