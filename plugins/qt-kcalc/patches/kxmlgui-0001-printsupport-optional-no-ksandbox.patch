 #include <KAdjustingScrollArea>
 #include <KLocalizedString>
+// KSandbox answers "am I inside a Flatpak or a Snap?". KCoreAddons does not
+// build it on WASI (or on iOS) because ksandbox.h:7 includes <QProcess> and
+// FEATURE_process=OFF -- so the header is not installed and this include
+// fails. A wk node IS a sandbox, a stricter one than either, but it is
+// neither of the two this asks about, so "no" is the correct answer and the
+// packaging line is simply absent from the About dialog.
