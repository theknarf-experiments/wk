 // Qt
@@ -132,12 +140,14 @@ QWidget *KAbstractAboutDialogPrivate::createComponentWidget(const QList<KAboutCo
                                          KAboutLicense::LGPL_V3));
 
     QString packageText;
+#ifndef Q_OS_WASI
     if (KSandbox::isFlatpak()) {
         packageText = i18nc("Linux packaging format", "Flatpak");
     }
     if (KSandbox::isSnap()) {
         packageText = i18nc("Linux packaging format", "Snap");
     }
+#endif
     if (qEnvironmentVariableIsSet("APPIMAGE")) {
         packageText = i18nc("Linux packaging format", "AppImage");
     }
