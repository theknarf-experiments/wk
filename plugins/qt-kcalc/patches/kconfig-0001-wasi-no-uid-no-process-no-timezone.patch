     const QString cfg_id = updateFile + QLatin1Char(':') + id;
     const QStringList ids = cg.readEntry("update_info", QStringList());
     if (!ids.contains(cfg_id)) {
+#if QT_CONFIG(process)
         QProcess::execute(QStringLiteral(KCONF_UPDATE_INSTALL_LOCATION), QStringList{QStringLiteral("--check"), updateFile});
+#else
+        // FEATURE_process=OFF: no fork/exec across a WASI component boundary,
+        // so kconf_update -- a separate BINARY that migrates old config files
+        // in place -- cannot be run. reparseConfiguration() still happens, so
+        // an already-current config is read normally; only the migration of a
+        // stale one is skipped. A wk node's config lives in its own vfs and
+        // starts empty, so there is nothing there to migrate.
+        qCDebug(KCONFIG_CORE_LOG) << "kconf_update cannot be run on this platform (no QProcess); skipping" << updateFile;
+#endif
         reparseConfiguration();
     }
 }
