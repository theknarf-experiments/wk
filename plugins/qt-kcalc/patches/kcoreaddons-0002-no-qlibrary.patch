             qCWarning(KCOREADDONS_DEBUG) << result.errorText;
             return result;
         }
+#if !QT_CONFIG(library)
+        // wk's qtbase is FEATURE_library=OFF: wasm has no dlopen, so a plugin
+        // that is not a STATIC plugin cannot be loaded, ever. Fail with the
+        // ordinary error rather than pretending. Plugins that reach a wk node
+        // do so through Q_IMPORT_PLUGIN and take the isStaticPlugin() branch
+        // above.
+        result.errorString = tr("Could not load plugin from %1: %2")
+                                 .arg(data.fileName(), tr("this build of Qt has no support for loading libraries at runtime"));
+        result.errorText = QStringLiteral("Could not load plugin from %1: no QLibrary support (wasm has no dlopen)").arg(data.fileName());
+        result.errorReason = INVALID_PLUGIN;
+        qCWarning(KCOREADDONS_DEBUG) << result.errorText;
+        return result;
+#else
         QPluginLoader loader(data.fileName());
         obj = loader.instance();
         if (!obj) {
@@ -45,6 +58,7 @@ KPluginFactory::Result<KPluginFactory> KPluginFactory::loadFactory(const KPlugin
             qCWarning(KCOREADDONS_DEBUG) << result.errorText;
             return result;
         }
+#endif
     }
 
     KPluginFactory *factory = qobject_cast<KPluginFactory *>(obj);
