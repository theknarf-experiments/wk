     CoreAddons
-    Crash
     ColorScheme
     Config
     ConfigWidgets
@@ -105,6 +121,19 @@ target_sources(kcalc PRIVATE
    kcalc_numeralsystem_view.h
    kcalc.qrc )
 
+# --- wk node: fonts ---------------------------------------------------------
+# Qt 6 ships no fonts and a wk node has no host font directory to fall back on:
+# with none, the app runs, QFontDatabase is empty and every string renders as
+# nothing at all. build.sh stages one TTF and generates this .qrc beside it
+# (which font exists depends on the machine), and the wk QPA plugin's font
+# database falls back to :/fonts after looking in QT_QPA_FONTDIR and the usual
+# VFS directories. A node that bind-mounts a real font directory can still set
+# QT_QPA_FONTDIR and never touch this copy.
+set(WK_FONTS_QRC "" CACHE FILEPATH "generated .qrc holding one staged TTF under :/fonts")
+if(WK_FONTS_QRC)
+  target_sources(kcalc PRIVATE "${WK_FONTS_QRC}")
+endif()
+
 if(CMAKE_BUILD_TYPE MATCHES "Release")
    add_definitions(-DQT_NO_DEBUG_OUTPUT)
 endif()
@@ -142,10 +171,55 @@ target_link_libraries(kcalc
     KF6::IconThemes
     KF6::Notifications
     KF6::XmlGui
-    KF6::Crash
     knumber
 )
 
+# --- wk node: the platform plugin, the icon engine, the component's imports --
+# There is no dlopen on wasm, so every Qt/KF plugin is an ARCHIVE linked into
+# the binary and named once with Q_IMPORT_PLUGIN (see kcalc.cpp's main).
+#
+#   WK_QPA_LIB              plugins/qt/sysroot/lib/libqwk.a -- the wk QPA
+#                           plugin. It also carries the gfx-compat shim
+#                           objects, so the app needs no other wasi-gfx code.
+#   WK_SVG_PLUGINS          the qsvg imageformat + iconengine plugins from this
+#                           port's own qtsvg build. KIconThemes REQUIRES
+#                           Qt6::Svg and Breeze's icons are SVG, so without
+#                           these no QImageReader knows what an .svg is and
+#                           every themed icon comes out null.
+#   WK_ICON_ENGINE_PLUGIN   KIconThemes' KIconEnginePlugin, built STATIC by
+#                           patches/kiconthemes-0001. This is what makes
+#                           QIcon::fromTheme() return a KIconEngine rather than
+#                           Qt's own -- i.e. it is KDE icon-theme semantics.
+#   WK_GFX_COMPONENT_TYPE   gen/wkgfx_component_type.o, passed as a LINK OPTION
+#   WK_CLIP_COMPONENT_TYPE  gen/wkclipboard_component_type.o, likewise.
+#                           These carry only a `component-type` custom section
+#                           that wasm-component-ld reads to build the
+#                           component's import list; nothing references them,
+#                           so as archive members the linker drops them and the
+#                           result is a component with NO wasi:surface import
+#                           at all.
+set(WK_QPA_LIB "" CACHE FILEPATH "libqwk.a, the wk QPA plugin (plugins/qt/build-qpa.sh)")
+set(WK_SVG_PLUGINS "" CACHE STRING "static qsvg plugin archives")
+set(WK_ICON_ENGINE_PLUGIN "" CACHE FILEPATH "static libKIconEnginePlugin.a")
+set(WK_GFX_COMPONENT_TYPE "" CACHE FILEPATH "gfx-compat gen/wkgfx_component_type.o")
+set(WK_CLIP_COMPONENT_TYPE "" CACHE FILEPATH "clipboard-compat gen/wkclipboard_component_type.o")
+if(WK_QPA_LIB)
+  # FbSupportPrivate is not optional and not obvious: the wk QPA plugin IS
+  # fbconvenience -- QWkScreen derives from QFbScreen, QWkWindow from
+  # QFbWindow, QWkBackingStore from QFbBackingStore, and that is where the
+  # guest-side compositing of N top-level windows into one surface lives.
+  # Without it the link fails with a page of "undefined symbol: QFbScreen::..."
+  # from inside libqwk.a. It is an INTERNAL_MODULE, so it is its own package
+  # rather than a component of Qt6Gui.
+  find_package(Qt6 6.8 REQUIRED COMPONENTS FbSupportPrivate)
+  target_link_libraries(kcalc ${WK_SVG_PLUGINS} "${WK_ICON_ENGINE_PLUGIN}" "${WK_QPA_LIB}" Qt6::FbSupportPrivate)
+endif()
+foreach(_wk_ct "${WK_GFX_COMPONENT_TYPE}" "${WK_CLIP_COMPONENT_TYPE}")
+  if(_wk_ct)
+    target_link_options(kcalc PRIVATE "${_wk_ct}")
+  endif()
+endforeach()
+
 set_target_properties(kcalc PROPERTIES MACOSX_BUNDLE_INFO_PLIST ${CMAKE_CURRENT_SOURCE_DIR}/MacOSXBundleInfo.plist.in)
 
 install(TARGETS kcalc  ${KDE_INSTALL_TARGETS_DEFAULT_ARGS} )
