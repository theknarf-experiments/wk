+#if defined (WK_EXEC)
+/* Express a pipeline stage's plumbing as redirections: `0<&pipe_in' and
+   `1>&pipe_out'. Returns a list whose tail is REST, so the command's own
+   redirections still follow (and so still override). */
+static REDIRECT *
+wk_pipe_redirects (pipe_in, pipe_out, rest)
+     int pipe_in, pipe_out;
+     REDIRECT *rest;
+{
+  REDIRECT *head;
+  REDIRECTEE source, redir;
+
+  head = rest;
+  if (pipe_out != NO_PIPE)
+    {
+      source.dest = 1;
+      redir.dest = pipe_out;
+      head = make_redirection (source, r_duplicating_output, redir, 0);
+      head->next = rest;
     }
+  if (pipe_in != NO_PIPE)
+    {
+      REDIRECT *in;
+
+      source.dest = 0;
+      redir.dest = pipe_in;
+      in = make_redirection (source, r_duplicating_input, redir, 0);
+      in->next = head;
+      head = in;
+    }
+  return head;
 }
 
+/* Free only the nodes wk_pipe_redirects added, stopping at REST — which the
+   command still owns. */
+static void
+wk_free_pipe_redirects (head, rest)
+     REDIRECT *head, *rest;
+{
+  while (head && head != rest)
+    {
+      REDIRECT *next = head->next;
+      head->next = (REDIRECT *)NULL;
+      dispose_redirects (head);
+      head = next;
+    }
+}
+#endif /* WK_EXEC */
