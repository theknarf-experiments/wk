--- a/execute_cmd.c
+++ b/execute_cmd.c
@@ -686,7 +686,71 @@
       pid_t paren_pid;
       int s;
       char *p;
+
+#if defined (WK_EXEC)
+      /* wk: there is no fork() to make the subshell's process with. Run its
+	 text in a second bash through wk:exec, its stdio wired to the pipeline
+	 pipes (or this shell's own). A stage feeding another is streamed and
+	 left running; anything else is waited for and its status reported —
+	 which is what the forked path below would have done. An asynchronous
+	 subshell still needs a background process, so it falls through and
+	 fails as it would without this. */
+      if (asynchronous == 0)
+	{
+	  extern int wk_bash_subshell PARAMS((const char *, const char *, char **, int, int));
+	  char *wk_shell, *wk_tcmd;
+	  int wk_status, wk_in, wk_out;
+
+	  save_line_number = line_number;
+	  if (command->type == cm_subshell)
+	    {
+	      SET_LINE_NUMBER (command->value.Subshell->line);
+	      /* Serialize the *inner* command, not the `( )` wrapper: the second
+		 bash is itself the subshell process, so re-emitting the parens
+		 would make it spawn yet another, recursing to the nesting cap.
+		 (A subshell-level redirection on the `()` itself is not carried;
+		 redirections inside — the common form — are part of the inner
+		 command and preserved.) */
+	      wk_tcmd = make_command_string (command->value.Subshell->command);
+	    }
+	  else
+	    /* A pipelined control structure (while/for/if/{ }) has no wrapper to
+	       drop; its own text is what the stage runs. */
+	    wk_tcmd = make_command_string (command);
+
+	  wk_shell = get_string_value ("BASH");
+	  if (wk_shell == 0 || *wk_shell != '/')
+	    wk_shell = shell_name;
 
+	  maybe_make_export_env ();
+	  wk_in = (pipe_in != NO_PIPE) ? pipe_in : -1;
+	  wk_out = (pipe_out != NO_PIPE) ? pipe_out : -1;
+
+	  wk_status = wk_bash_subshell (wk_shell, wk_tcmd, export_env, wk_in, wk_out);
+
+	  close_pipes (pipe_in, pipe_out);
+	  line_number = save_line_number;
+
+	  /* A non-final pipeline stage: let the last one be waited for. */
+	  if (pipe_out != NO_PIPE)
+	    return (EXECUTION_SUCCESS);
+
+	  invert = (command->flags & CMD_INVERT_RETURN) != 0;
+	  if (invert)
+	    wk_status = (wk_status == EXECUTION_SUCCESS) ? EXECUTION_FAILURE
+						        : EXECUTION_SUCCESS;
+	  last_command_exit_value = wk_status;
+
+	  if ((command->flags & CMD_IGNORE_RETURN) == 0 && invert == 0 &&
+	      exit_immediately_on_error && wk_status != EXECUTION_SUCCESS)
+	    {
+	      run_pending_traps ();
+	      jump_to_top_level (ERREXIT);
+	    }
+	  return (last_command_exit_value);
+	}
+#endif
+
       /* Fork a subshell, turn off the subshell bit, turn off job
 	 control and call execute_command () on the command again. */
       save_line_number = line_number;
