+
+void ReactorTask::run_reactor_once()
+{
+  ACE_Reactor* reactor = 0;
+  {
+    GuardType guard(lock_);
+    if (state_ != STATE_RUNNING) {
+      return;
+    }
+    reactor = reactor_;
+
+    // Drain the command queue here, because nothing else can.
+    //
+    // execute_or_enqueue() runs a command inline only when the caller owns the
+    // reactor AND nothing is being processed AND the queue is empty. Otherwise
+    // it queues the command and wakes the reactor thread with
+    // reactor_->notify(), which the reactor then services in handle_exception().
+    //
+    // There is no reactor thread here, and no notification pipe to wake it with
+    // (ACE_DISABLE_NOTIFY_PIPE_DEFAULT is 1 -- see ace/config-wasi.h), so that
+    // notify goes nowhere. And it is worse than a dropped wakeup: the function
+    // sets reactor_notified_ = true before notifying and only
+    // process_command_queue_i() clears it, so after the first lost
+    // notification NO later enqueue will even try again. The queue stalls
+    // permanently, and the very first command to arrive while another is being
+    // processed takes the whole transport with it.
+    //
+    // That is how it presented: the rtps_udp socket received exactly one
+    // datagram, ever, while the peer sent dozens -- the receive strategy's
+    // RegisterHandler command was sitting in a queue nobody would ever drain.
+    //
+    // Draining from the pump makes the queue behave the way it does with a
+    // reactor thread: commands run promptly, in order, on the thread that owns
+    // the reactor. `processing_` still guards against re-entering it from a
+    // command's own execute().
+    if (!processing_ && !command_queue_.empty()) {
+      if (getenv("WK_DDS_TRACE")) {
+        fprintf(stderr, "[wk] pump draining %zu queued commands\n", command_queue_.size());
+      }
+      process_command_queue_i();
+    }
+  }
+  if (reactor) {
+    static long calls = 0, dispatched = 0;
+    ++calls;
+    // Zero timeout: poll what is ready and return. handle_events() with a
+    // non-zero timeout would block the single thread of the process, which is
+    // exactly what a pump must not do -- the caller may have work of its own
+    // and other registered passes are waiting behind this one.
+    ACE_Time_Value now = ACE_Time_Value::zero;
+    const int n = reactor->handle_events(&now);
+    if (n > 0) dispatched += n;
+    if (getenv("WK_DDS_TRACE") && calls % 2000 == 0) {
+      fprintf(stderr, "[wk] reactor passes=%ld dispatched=%ld\n", calls, dispatched);
