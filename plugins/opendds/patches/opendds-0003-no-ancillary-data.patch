 bool set_socket_multicast_ttl(const ACE_SOCK_Dgram& socket, const unsigned char& ttl)
 {
+#ifdef ACE_WASI
+  // wasm32-wasip2 has no multicast at all: wasi:sockets does not expose the
+  // IP_MULTICAST_* / IPV6_MULTICAST_* options in its interface, so setsockopt
+  // for them cannot succeed on any guest, ever. A multicast TTL is a hint
+  // about how far a MULTICAST send may travel, and this participant will never
+  // send one -- Spdp calls this on its UNICAST socket, unconditionally and
+  // with no configuration to skip it, which is the only reason we are here.
+  //
+  // So report success. This is not the same permission as pretending a GROUP
+  // JOIN succeeded: a participant that believes it joined a group and then
+  // receives nothing is silently broken, whereas one that cannot set a TTL it
+  // will never use has lost nothing. Group joins are left to fail, which is
+  // what forces the unicast SPDP configuration (SpdpSendAddrs) that wk's
+  // fabric actually supports. See plugins/opendds/PORTING.md, "rtps_udp, and
+  // unicast discovery".
+  ACE_UNUSED_ARG(socket);
+  ACE_UNUSED_ARG(ttl);
+  return true;
+#else
   ACE_HANDLE handle = socket.get_handle();
   const void* ttlp = &ttl;
 #if defined(ACE_LINUX) || defined(__linux__) || defined(ACE_HAS_MAC_OSX)
@@ -432,11 +451,38 @@
                      false);
   }
   return true;
+#endif // ACE_WASI
 }
 
