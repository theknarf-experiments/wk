   if (bytes_remaining < 0) {
+    // EWOULDBLOCK is not a broken link, it is "nothing to read right now".
+    //
+    // A reactor may report a socket readable and the read that follows may
+    // still find nothing: POSIX permits it explicitly and Linux's select(2)
+    // documents it. On wasm32-wasip2 it is not an edge case at all -- a UDP
+    // socket there stays reported readable until a receive finds nothing, so
+    // the EMPTY READ is precisely what clears the readiness, and it therefore
+    // happens after every single datagram.
+    //
+    // Treating that as a link failure calls relink() and returns -1, which
+    // makes the reactor REMOVE this handler -- so the transport receives its
+    // first datagram and then goes permanently deaf. That is exactly how it
+    // presented: SEDP sent ~15 datagrams in each direction and each side read
+    // one, so no endpoint ever matched.
+    //
+    // Returning 0 keeps the handler and waits for the next event, which is
+    // what the caller wants on any platform.
+    if (errno == EWOULDBLOCK || errno == EAGAIN) {
+      return 0;
+    }
