diff --git a/src/corelib/io/qstandardpaths_unix.cpp b/src/corelib/io/qstandardpaths_unix.cpp
index 46fb671..5e5b330 100644
--- a/src/corelib/io/qstandardpaths_unix.cpp
+++ b/src/corelib/io/qstandardpaths_unix.cpp
@@ -25,6 +25,21 @@ QT_BEGIN_NAMESPACE
 
 using namespace Qt::StringLiterals;
 
+#ifdef Q_OS_WASI
+// wasi-libc has no geteuid: unistd.h keeps the whole getuid/geteuid/getgid
+// block behind __wasilibc_unmodified_upstream, so the two call sites below
+// ("XDG_RUNTIME_DIR ownership check" and "runtime-<username>" fallback) are
+// COMPILE errors, not link errors.
+//
+// A wasm component has exactly one, anonymous principal, and every file it can
+// see through its preopens is by definition its own. Reporting 0 makes the
+// ownership check in checkXdgRuntimeDir() compare equal against a directory
+// this component just created (wasi's stat fills st_uid with 0), which is the
+// behaviour we want -- the alternative is XDG_RUNTIME_DIR being rejected every
+// time and QStandardPaths::RuntimeLocation always coming back empty.
+static inline uid_t geteuid() noexcept { return 0; }
+#endif
