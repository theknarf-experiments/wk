Subject: network: the BSD-sockets API wasi-libc stops short of

WHAT / WHY

  src/network/socket/qnet_unix_p.h
      wasip2 gives a guest REAL sockets -- socket/bind/listen/accept/connect/
      send/recv/sendto/recvfrom/getaddrinfo all work, which is why
      plugins/fetch and plugins/netserve need no wk-specific code at all. What
      it does not give is the datagram-with-ancillary-data half. wasi-libc's
      <sys/socket.h> hides sendmsg(), recvmsg(), `struct cmsghdr` and every
      CMSG_* macro behind `#ifdef __wasilibc_unmodified_upstream`, with the
      comment "WASI has no sendmsg/recvmsg", and its wasip2 <sys/socket.h>
      also omits SO_BROADCAST, SO_OOBINLINE and MSG_EOR.

      qnativesocketengine_unix.cpp needs all of it ANYWAY, because its three
      datagram functions and two of its socket options sit OUTSIDE
      QT_CONFIG(udpsocket) -- the feature gates QUdpSocket, not the engine. So
      -DFEATURE_udpsocket=OFF does not make the problem go away, and the build
      fails with ~20 errors in one file: "no member named 'sendmsg' in the
      global namespace", "use of undeclared identifier 'CMSG_SPACE'", "member
      access into incomplete type 'struct cmsghdr'".

      The declarations go in qnet_unix_p.h because that is already the
      network module's "what UNIX gives us" header, included by the socket
      engine, by qnetworkinterface_unix_p.h and by qhostinfo_unix.cpp. The
      struct and macros are musl's, byte-for-byte -- the same source
      wasi-libc's own header would have used had the block been enabled.

      Also: <resolv.h> does not exist in the wasi sysroot at all, and this
      header includes it unconditionally for everything that is not VxWorks.
      Nothing in it uses the resolver; res_init()/_res are touched only by
      qhostinfo_unix.cpp under QT_CONFIG(libresolv), which
      plugins/qt/build-qtbase.sh forces off. Name resolution on wk goes
      getaddrinfo() -> wasi:sockets ip-name-lookup -> the fabric's own name
      service, which is how a node reaches a peer BY NODE NAME.

  src/network/socket/qnativesocketengine_unix.cpp
      The other half: sendmsg()/recvmsg() defined over sendto()/recvfrom().
      Single-iovec messages pass straight through; multi-iovec ones gather or
      scatter through one bounce buffer. msg_control is ignored and
      msg_controllen is reported back as 0, so every CMSG_FIRSTHDR loop in
      this file runs zero times; msg_flags comes back 0, which is why
      nativePendingDatagramSize()'s grow-and-retry loop terminates on its
      first pass.

  WHAT THIS DOES AND DOES NOT BUY. It makes QtNetwork compile and link, and
  TCP -- QTcpSocket, QTcpServer, QHostInfo, QNetworkAccessManager -- does not
  touch any of it; that path is proven end to end by the wk-server test
  `qt_network_speaks_to_a_wk_node`. QUdpSocket links but is UNPROVEN: nothing
  drives it, ancillary data is gone (so no IP_PKTINFO destination address, no
  hop limit), and SO_BROADCAST/SO_OOBINLINE will be refused by wasi-libc's
  setsockopt at runtime because neither is a thing wasi:sockets has.

UPSTREAM
  not-as-is. The resolv.h guard is a plain `#elif defined(Q_OS_WASI)` upstream
  would plausibly take. The rest is a libc shim living in a Qt source file,
  which is the wrong home for it: the real fix is sendmsg/recvmsg and the CMSG
  layer in wasi-libc itself (they are implementable over the same
  wasi:sockets primitives used here), after which this whole block deletes.
  Until then it has to live somewhere, and one guarded block in the file that
  needs it beats patching three functions out of the socket engine.

--- a/src/network/socket/qnet_unix_p.h
+++ b/src/network/socket/qnet_unix_p.h
@@ -31,10 +31,81 @@
 #include <arpa/inet.h>
 #if defined(Q_OS_VXWORKS)
 #  include <hostLib.h>
+#elif defined(Q_OS_WASI)
+// No <resolv.h> in the wasi sysroot at all -- there is no resolver library to
+// declare. Nothing in this header uses it: it is here for res_init()/_res,
+// which only qhostinfo_unix.cpp touches and only under QT_CONFIG(libresolv),
+// forced off in plugins/qt/build-qtbase.sh. Name resolution on wk goes through
+// getaddrinfo() -> wasi:sockets ip-name-lookup -> the fabric's own name
+// service, which is how a node reaches a peer by node name.
 #else
 #  include <resolv.h>
 #endif
 
+#ifdef Q_OS_WASI
+// ---------------------------------------------------------------------------
+// The BSD-sockets API wasi-libc stops short of.
+//
+// wasip2 gives a guest real sockets -- socket/bind/listen/accept/connect/
+// send/recv/sendto/recvfrom/getaddrinfo all work over wk's fabric, which is
+// why plugins/fetch and plugins/netserve need no wk-specific code at all. What
+// it does NOT give is the datagram-with-ancillary-data half of the API:
+// <sys/socket.h> puts sendmsg/recvmsg, struct cmsghdr and every CMSG_* macro
+// behind `#ifdef __wasilibc_unmodified_upstream`, i.e. compiles them out, with
+// the comment "WASI has no sendmsg/recvmsg".
+//
+// qnativesocketengine_unix.cpp needs them ANYWAY, because its three datagram
+// functions and the two socket options below sit OUTSIDE QT_CONFIG(udpsocket)
+// -- the feature gates QUdpSocket, not the engine. So the choice is to patch
+// those functions out (and lose the engine's shape) or to supply the missing
+// declarations. This does the latter, in the header the UNIX socket engine
+// already includes for exactly this purpose.
+//
+// The macros and struct are musl's, byte-for-byte -- the same source
+// wasi-libc's own <sys/socket.h> would have used had the block been enabled.
+// The two functions are DEFINED, over sendto/recvfrom, at the top of
+// qnativesocketengine_unix.cpp.
+//
+// Honesty about what this buys: it makes QtNetwork LINK. Ancillary data is
+// dropped (msg_controllen always comes back 0, so every CMSG_FIRSTHDR loop
+// runs zero times) and SO_BROADCAST/SO_OOBINLINE will be refused by
+// wasi-libc's setsockopt at runtime, because neither is a thing wasi:sockets
+// has. TCP -- QTcpSocket, QTcpServer, QNetworkAccessManager -- does not touch
+// any of it.
+struct cmsghdr {
+    socklen_t cmsg_len;
+    int cmsg_level;
+    int cmsg_type;
+};
+
+#define CMSG_ALIGN(len)   (((len) + sizeof(size_t) - 1) & (size_t) ~(sizeof(size_t) - 1))
+#define CMSG_SPACE(len)   (CMSG_ALIGN(len) + CMSG_ALIGN(sizeof(struct cmsghdr)))
+#define CMSG_LEN(len)     (CMSG_ALIGN(sizeof(struct cmsghdr)) + (len))
+#define CMSG_DATA(cmsg)   ((unsigned char *)(((struct cmsghdr *)(cmsg)) + 1))
+#define __CMSG_LEN(cmsg)  (((cmsg)->cmsg_len + sizeof(long) - 1) & ~(long)(sizeof(long) - 1))
+#define __CMSG_NEXT(cmsg) ((unsigned char *)(cmsg) + __CMSG_LEN(cmsg))
+#define __MHDR_END(mhdr)  ((unsigned char *)(mhdr)->msg_control + (mhdr)->msg_controllen)
+#define CMSG_FIRSTHDR(mhdr) \
+    ((size_t)(mhdr)->msg_controllen >= sizeof(struct cmsghdr) \
+         ? (struct cmsghdr *)(mhdr)->msg_control : (struct cmsghdr *)0)
+#define CMSG_NXTHDR(mhdr, cmsg) \
+    ((cmsg)->cmsg_len < sizeof(struct cmsghdr) \
+      || __CMSG_LEN(cmsg) + sizeof(struct cmsghdr) >= __MHDR_END(mhdr) - (unsigned char *)(cmsg) \
+         ? (struct cmsghdr *)0 : (struct cmsghdr *)__CMSG_NEXT(cmsg))
+
+// musl's values. wasi-libc defines the neighbouring SO_* (SO_REUSEADDR 2,
+// SO_ERROR 4, SO_KEEPALIVE 9, ...) from the same table, so these do not
+// collide -- they are simply the entries wasi:sockets cannot honour.
+#define MSG_EOR       0x0080
+#define SO_BROADCAST  6
+#define SO_OOBINLINE  10
+
+extern "C" {
+ssize_t sendmsg(int, const struct msghdr *, int);
+ssize_t recvmsg(int, struct msghdr *, int);
+}
+#endif // Q_OS_WASI
+
 QT_BEGIN_NAMESPACE
 
 // Almost always the same. If not, specify in qplatformdefs.h.
--- a/src/network/socket/qnativesocketengine_unix.cpp
+++ b/src/network/socket/qnativesocketengine_unix.cpp
@@ -34,7 +34,105 @@
 #ifdef Q_OS_BSD4
 #  include <net/if_dl.h>
 #endif
+
+#ifdef Q_OS_WASI
+// sendmsg() and recvmsg() over sendto()/recvfrom(). wasi-libc compiles both
+// out of <sys/socket.h> ("WASI has no sendmsg/recvmsg"); qnet_unix_p.h
+// declares them for this platform and argues why, and this is the other half.
+//
+// wasi:sockets has no scatter/gather, so a multi-iovec message bounces through
+// one buffer; it has no ancillary data, so msg_control is ignored and
+// msg_controllen is reported back as 0; and it never reports MSG_TRUNC, so
+// msg_flags comes back 0 -- which is why nativePendingDatagramSize()'s
+// grow-and-retry loop below terminates on its first pass.
+//
+// UNPROVEN over wk's fabric: QUdpSocket links with this but no test drives it.
+#include <stdlib.h>
+#include <string.h>
+
+extern "C" {
+
+ssize_t sendmsg(int fd, const struct msghdr *msg, int flags)
+{
+    if (!msg || (msg->msg_iovlen > 0 && !msg->msg_iov)) {
+        errno = EINVAL;
+        return -1;
+    }
+    const struct sockaddr *to = static_cast<const struct sockaddr *>(msg->msg_name);
+    const socklen_t tolen = to ? msg->msg_namelen : 0;
+
+    if (msg->msg_iovlen == 1)
+        return ::sendto(fd, msg->msg_iov[0].iov_base, msg->msg_iov[0].iov_len, flags, to, tolen);
+
+    size_t total = 0;
+    for (int i = 0; i < msg->msg_iovlen; ++i)
+        total += msg->msg_iov[i].iov_len;
+    if (total == 0)
+        return ::sendto(fd, "", 0, flags, to, tolen);
+
+    char *bounce = static_cast<char *>(malloc(total));
+    if (!bounce) {
+        errno = ENOMEM;
+        return -1;
+    }
+    size_t off = 0;
+    for (int i = 0; i < msg->msg_iovlen; ++i) {
+        memcpy(bounce + off, msg->msg_iov[i].iov_base, msg->msg_iov[i].iov_len);
+        off += msg->msg_iov[i].iov_len;
+    }
+    const ssize_t sent = ::sendto(fd, bounce, total, flags, to, tolen);
+    const int saved = errno;
+    free(bounce);
+    errno = saved;
+    return sent;
+}
+
+ssize_t recvmsg(int fd, struct msghdr *msg, int flags)
+{
+    if (!msg || (msg->msg_iovlen > 0 && !msg->msg_iov)) {
+        errno = EINVAL;
+        return -1;
+    }
+    struct sockaddr *from = static_cast<struct sockaddr *>(msg->msg_name);
+    socklen_t fromlen = from ? msg->msg_namelen : 0;
+
+    ssize_t got;
+    if (msg->msg_iovlen == 1) {
+        got = ::recvfrom(fd, msg->msg_iov[0].iov_base, msg->msg_iov[0].iov_len, flags,
+                         from, from ? &fromlen : nullptr);
+    } else {
+        size_t total = 0;
+        for (int i = 0; i < msg->msg_iovlen; ++i)
+            total += msg->msg_iov[i].iov_len;
+        char *bounce = static_cast<char *>(malloc(total ? total : 1));
+        if (!bounce) {
+            errno = ENOMEM;
+            return -1;
+        }
+        got = ::recvfrom(fd, bounce, total, flags, from, from ? &fromlen : nullptr);
+        for (int i = 0, off = 0; got > 0 && i < msg->msg_iovlen && off < got; ++i) {
+            const size_t avail = size_t(got - off);
+            const size_t n = avail < msg->msg_iov[i].iov_len ? avail : msg->msg_iov[i].iov_len;
+            memcpy(msg->msg_iov[i].iov_base, bounce + off, n);
+            off += int(n);
+        }
+        const int saved = errno;
+        free(bounce);
+        errno = saved;
+    }
 
+    if (got >= 0) {
+        if (from)
+            msg->msg_namelen = fromlen;
+        msg->msg_controllen = 0;
+        msg->msg_flags = 0;
+    }
+    return got;
+}
+
+} // extern "C"
+#endif // Q_OS_WASI
+
 QT_BEGIN_NAMESPACE
 
