@@ -154,7 +158,23 @@
 protected:
     // Cache for all the QHttpNetworkConnection objects.
     // This is per thread.
+#if QT_CONFIG(thread)
     static QThreadStorage<QNetworkAccessCache *> connections;
+#else
+    // QThreadStorage's out-of-line half lives in qthreadstorage.cpp, which
+    // src/corelib/CMakeLists.txt only compiles under CONDITION QT_FEATURE_thread
+    // -- so the template header compiles and the link fails on
+    // QThreadStorageData. With one thread, thread-local IS global; this is the
+    // same three-call interface over a plain static.
+    struct SingleThreadedCache
+    {
+        QNetworkAccessCache *value = nullptr;
+        bool hasLocalData() const { return value != nullptr; }
+        QNetworkAccessCache *localData() const { return value; }
+        void setLocalData(QNetworkAccessCache *v) { delete value; value = v; }
+    };
+    static SingleThreadedCache connections;
+#endif
 
 };
 
