@@ -293,6 +304,64 @@
                 w.open(filename);
             }
         }
+
+#ifdef __wasi__
+        // --- wk selftest -----------------------------------------------
+        // WK_TFE_SELFTEST=1 makes the app narrate itself on stdout so a
+        // headless harness can check more than a pixel histogram. A frame
+        // that is "not blank" proves almost nothing; these lines prove that
+        // the .torrent actually PARSED (name, info hash, total size and the
+        // file list all come out of BencodeModel), and they publish the
+        // About button's rect in surface coordinates so the harness can aim
+        // a real wasi:surface pointer event at it and watch a second
+        // top-level window appear.
+        //
+        // Repeating rather than one-shot, deliberately: the first top-level
+        // is forced to the full surface by the wk QPA, so an early reading of
+        // any widget rect is the pre-resize one; and a timer that keeps
+        // firing is itself the only evidence that QTimer deadlines survive
+        // being folded into the frame wait.
+        if (qEnvironmentVariableIntValue("WK_TFE_SELFTEST") == 1) {
+            std::printf("platform=%s style=%s families=%lld\n",
+                        qPrintable(QApplication::platformName()),
+                        qPrintable(QApplication::style()->objectName()),
+                        (long long)QFontDatabase::families().size());
+            if (QScreen *s = QApplication::primaryScreen()) {
+                std::printf("screen=%dx%d\n", s->geometry().width(), s->geometry().height());
+            }
+            std::fflush(stdout);
+
+            QTimer *report = new QTimer(&w);
+            QObject::connect(report, &QTimer::timeout, [&w]() {
+                auto text = [&w](const char *name) -> QString {
+                    QLineEdit *e = w.findChild<QLineEdit *>(QString::fromLatin1(name));
+                    return e ? e->text() : QString();
+                };
+                int files = 0;
+                if (QAbstractItemView *v = w.findChild<QAbstractItemView *>(QStringLiteral("viewFiles"))) {
+                    if (v->model()) {
+                        files = v->model()->rowCount();
+                    }
+                }
+                int tops = 0;
+                for (QWidget *tl : QApplication::topLevelWidgets()) {
+                    if (tl->isVisible()) {
+                        ++tops;
+                    }
+                }
+                std::printf("STATE title='%s' name='%s' hash='%s' size='%s' files=%d tops=%d\n",
+                            qPrintable(w.windowTitle()), qPrintable(text("leName")),
+                            qPrintable(text("leHash")), qPrintable(text("leTorrentTotalSize")),
+                            files, tops);
+                if (QWidget *b = w.findChild<QWidget *>(QStringLiteral("btnAbout"))) {
+                    const QRect r(b->mapToGlobal(QPoint(0, 0)), b->size());
+                    std::printf("BTNABOUT %d %d %d %d\n", r.x(), r.y(), r.width(), r.height());
+                }
+                std::fflush(stdout);
+            });
+            report->start(250);
+        }
+#endif
 
