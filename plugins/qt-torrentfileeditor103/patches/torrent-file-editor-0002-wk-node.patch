+// --- wk node ---------------------------------------------------------------
+// wasm has no dlopen, so Qt cannot discover a plugin at runtime: every plugin
+// is linked in as an archive and named here. Without the QWkIntegrationPlugin
+// line QApplication aborts with "no Qt platform plugin could be initialized"
+// and an EMPTY available-plugins list, which reads like a broken Qt build but
+// is a missing symbol reference. The two Svg plugins are what make
+// aboutdlg.ui's :/icons/app.svg (and the window icon) decode at all.
+#ifdef __wasi__
+#include <QtPlugin>
+Q_IMPORT_PLUGIN(QWkIntegrationPlugin)
+Q_IMPORT_PLUGIN(QSvgPlugin)
+Q_IMPORT_PLUGIN(QSvgIconPlugin)
+#endif
+
 // Allow run Qt5 static version https://github.com/tonytheodore/mxe/commit/497669fa44356db0cd8335e2554b7bac12eb88c2
 #if QT_VERSION >= QT_VERSION_CHECK(5, 0, 0) && defined Q_OS_WIN && defined BUILD_STATIC
 #include <QtPlugin>
