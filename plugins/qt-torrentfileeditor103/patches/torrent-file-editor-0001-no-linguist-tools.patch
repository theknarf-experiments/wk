WHAT: drop find_package(Qt6LinguistTools), the .qm compilation, translations.qrc
      and the lupdate/fix_* maintainer targets.
WHY:  upstream's `find_package(Qt6LinguistTools REQUIRED)` is unconditional, and
      lrelease lives in qttools -- a repo plugins/qt does not build for the host
      (its ./host is qtbase + qtdeclarative only). There is no cross-built
      lrelease to borrow either: it is a HOST tool by definition.
      Three separate things break without it, which is why this is four hunks
      and not one:
        * find_package fails outright (REQUIRED);
        * translations.qrc names 25 .qm files that only lrelease produces, and
          rcc errors on a missing entry rather than skipping it;
        * the per-language lupdate_/fix_ custom targets name the Qt6::lupdate
          imported target, so merely DECLARING them is a configure error.
UPSTREAM: not-as-is. Upstream would want this behind an option
      (ENABLE_TRANSLATIONS, defaulting ON) rather than commented out. The
      runtime degradation is bounded and honest: MainWindow enumerates
      :/translations at startup and finds it empty, so the UI is English only.
      Building qttools for the host would remove the need for this patch
      entirely.
--- a/CMakeLists.txt	2026-06-05 13:11:57
+++ b/CMakeLists.txt	2026-08-26 02:16:08
@@ -150,7 +150,9 @@
   if(BUILD_SHARED)
     find_package(Qt6Svg REQUIRED)
   endif()
-  find_package(Qt6LinguistTools REQUIRED)
+  # NO Qt6LinguistTools. lrelease lives in qttools, which the wk port does not
+  # build for the host, and there is no cross-built one to borrow. The
+  # translations are dropped with it (see below); the app runs in English.
   find_package(Qt6Core5Compat REQUIRED)
 
   macro(QT4_ADD_TRANSLATION)
@@ -224,7 +226,11 @@
   endif()
 endmacro()
 
-configure_file(translations.qrc.in translations.qrc COPYONLY)
+# translations.qrc lists 25 .qm files that only lrelease can produce, and rcc
+# fails outright on a missing entry -- so with no LinguistTools the resource
+# cannot be built at all. MainWindow::retranslate() enumerates :/translations
+# at runtime and simply finds it empty.
+#   configure_file(translations.qrc.in translations.qrc COPYONLY)
 
 set(LANGS af ar bn cs de en es fi fr he ko hu id it ja nl pl pt ro ru tr uk vi zh_CN zh_TW)
 
@@ -344,39 +350,21 @@
 endif()
 
 set(RESOURCES
-  ${CMAKE_BINARY_DIR}/translations.qrc
   resources.qrc
 )
 
-add_custom_target(lupdate)
+# The lupdate/fix_* maintainer targets are gone with LinguistTools: every one
+# of them names the Qt6::lupdate imported target, which does not exist without
+# find_package(Qt6LinguistTools), so merely DECLARING them is a configure
+# error. They only regenerate .ts files anyway -- a translator's job, not a
+# build's.
 
-foreach(l ${LANGS})
-  add_custom_target(
-    lupdate_${l}
-    COMMAND Qt${QT_VERSION_MAJOR}::lupdate -no-obsolete -no-recursive ${CMAKE_SOURCE_DIR}  -ts "torrentfileeditor_${l}.ts"
-    WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}/translations"
-    COMMENT "Updating .ts files"
-  )
 
-  add_custom_target(
-    fix_${l}
-    COMMAND "xmllint" "--noblanks" "torrentfileeditor_${l}.ts" "--output" "torrentfileeditor_${l}.ts"
-    COMMAND "perl" "-pi" "-e" "s|<context><name>QLineEdit.*?</context>||g" "torrentfileeditor_${l}.ts"
-    COMMAND "xmllint" "--format" "torrentfileeditor_${l}.ts" "--output" "torrentfileeditor_${l}.ts"
-    WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}/translations"
-    VERBATIM
-    COMMENT "Fix .ts files formating"
-  )
-  add_dependencies(fix_${l} lupdate_${l})
-  add_dependencies(lupdate fix_${l})
-endforeach()
-
-
 if(WIN32)
   list(APPEND RESOURCES "${CMAKE_BINARY_DIR}/qt_translations.qrc")
 endif()
 
-QT4_ADD_TRANSLATION(QM ${TRANSLATIONS})
+# QT4_ADD_TRANSLATION(QM ${TRANSLATIONS})   -- needs lrelease; ${QM} stays empty
 qt4_add_resources(QRC_SOURCES ${RESOURCES})
 qt4_wrap_cpp(MOC_SOURCES ${HEADERS})
 qt4_wrap_ui(UI_SOURCES ${FORMS})
