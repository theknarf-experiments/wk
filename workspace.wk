// vim: set filetype=kdl :
dependencies {
    triangle "plugins/triangle/target/wasm32-wasip1/debug/triangle.wasm" {
        description "spinning webgpu triangle"
    }
    shader "plugins/shader/target/wasm32-wasip1/debug/shader.wasm" {
        description "live WGSL shader; wire a file in to live-code it, MIDI in to react"
    }
    screenview "plugins/screenview/target/wasm32-wasip1/debug/screenview.wasm" {
        description "views frames from a Screen Capture node (wire one in)"
    }
    recorder "plugins/recorder/target/wasm32-wasip1/debug/recorder.wasm" {
        description "records Screen Capture frames to an MJPEG file (wire a file out)"
    }
    paint "plugins/paint/target/wasm32-wasip1/debug/paint.wasm" {
        description "self-driving animated gradient canvas"
    }
    biscuit "plugins/biscuit/target/wasm32-wasip1/debug/biscuit.wasm" {
        description "live Biscuit-token inspector: renders this node's own /run/wk/token, updating as it is attenuated"
    }
    file_demo "plugins/file-demo/target/wasm32-wasip1/debug/file_demo.wasm" {
        description "shows the file node wired into it"
    }
    hellofs "plugins/hellofs/target/wasm32-wasip1/debug/hellofs.wasm" {
        description "a node that IS a filesystem (wk:fs provider) — wire into an app, ls the mount"
    }
    hellofuse "plugins/hellofuse/hellofuse.wasm" {
        description "libfuse's unmodified hello example via the libfuse-compat shim — real FUSE code as a node"
    }
    passfs "plugins/passfs/passfs.wasm" {
        description "libfuse's unmodified passthrough example — re-exports this node's own filesystem to whoever wires it"
    }
    zipfs "plugins/zipfs/zipfs.wasm" {
        description "archive view (miniz): wire a .zip in, the archive's tree mounts wherever this node is wired"
    }
    httpfs "plugins/httpfs/httpfs.wasm" {
        description "network filesystem over the fabric: mounts an HTTP file server by name (httpfs http://filesrv:8080)"
    }
    automergefs "plugins/automergefs/automergefs.wasm" {
        description "a node that IS a synced automerge repo (subduction client): automergefs ws://subduction:8080 automerge:<doc> [service-name]"
    }
    piano "plugins/piano/target/wasm32-wasip1/debug/piano.wasm" {
        description "on-screen keyboard emitting MIDI"
    }
    arp "plugins/arp/target/wasm32-wasip1/debug/arp.wasm" {
        description "arpeggiator: MIDI in, patterns out"
    }
    sequencer "plugins/sequencer/target/wasm32-wasip1/debug/sequencer.wasm" {
        description "step sequencer / piano roll: play a looped pattern, record MIDI in"
    }
    synth "plugins/synth/target/wasm32-wasip1/debug/synth.wasm" {
        description "MIDI synth with tweakable knobs"
    }
    totem "plugins/totem/target/wasm32-wasip1/debug/totem.wasm" {
        description "a spinning 3D crystal (wk:scene) — click it in the 3D view"
    }
    world "plugins/world/target/wasm32-wasip1/debug/world.wasm" {
        description "the surrounding 3D world: wire a .glb in and this node IS the place (wk:scene scenery)"
    }
    bash "docker://plugins/bash/Dockerfile" {
        description "wk-shell: real GNU bash + GNU coreutils (pipes, redirection, $(...))"
    }
    kilo "plugins/kilo/kilo.wasm" {
        description "the kilo text editor"
        args "welcome.txt"
    }
    vim "docker://plugins/vim/Dockerfile" {
        description "the Vim text editor (a wasm container: vim.wasm + its runtime)"
    }
    lua "plugins/lua/lua.wasm" {
        description "Lua interpreter REPL"
    }
    sqlite "plugins/sqlite/sqlite3.wasm" {
        description "sqlite3 shell"
    }
    python "docker://plugins/python/Dockerfile" {
        description "CPython 3.14 (a wasm container: python.wasm + stdlib; sockets work over the fabric)"
    }
    php "docker://plugins/php/Dockerfile" {
        description "PHP 8.2 (a wasm container; php -S built-in webserver over the fabric)"
    }
    wordpress "image://wordpress" {
        description "WordPress (PHP + SQLite), assembled by plugins/wordpress/Dockerfile — build it first with `mise run build`"
    }
    doctools "image://doctools" {
        description "doc-tools: real pandoc + pdfTeX on the wk-shell (plugins/doctools/Dockerfile) — build it first with `mise run build`"
    }
    curl "plugins/curl/curl.wasm" {
        description "GNU curl 8.11.1, cross-compiled to wasm32-wasip2 (real curl over the fabric)"
    }
    fetch "plugins/fetch/fetch.wasm" {
        description "TCP client: fetches host port over the fabric"
        args "example.com" "80"
    }
    netserve "plugins/netserve/netserve.wasm" {
        description "BSD-sockets TCP server on the fabric"
        args "80"
    }
    udpecho "plugins/udpecho/udpecho.wasm" {
        description "UDP echo (server or client mode)"
        args "server" "4242"
    }
    echo6 "plugins/echo6/echo6.wasm" {
        description "IPv6 TCP echo (server or client mode)"
        args "server" "80"
    }
    http_hello "oci://ghcr.io/bytecodealliance/sample-wasi-http-rust/sample-wasi-http-rust:latest" {
        description "sample wasi:http server; serve it on a Port"
    }
    doom "docker://plugins/doom/Dockerfile" {
        description "DOOM (unmodified doomgeneric + Freedoom Phase 1) on a wasi-gfx surface"
    }
    quake "docker://plugins/quake/Dockerfile" {
        description "Quake (unmodified quakegeneric + id 1.06 shareware episode) on a wasi-gfx surface"
    }
    fluidsynth "docker://plugins/fluidsynth/Dockerfile" {
        description "SoundFont synth (FluidLite engine + TimGM6mb.sf2): MIDI in, real instruments out"
    }
    netsurf "docker://plugins/netsurf/Dockerfile" {
        description "NetSurf 3.11 web browser (framebuffer frontend; HTTP+HTTPS over the fabric via wolfSSL-curl; no JS)"
    }
    mupdf "docker://plugins/mupdf/Dockerfile" {
        description "MuPDF PDF reader (wire a PDF in; PgUp/PgDn pages, +/- zoom, scroll pans)"
    }
    libreoffice "image://libreoffice" {
        description "LibreOffice Impress (a wasm container: soffice.bin + its whole install tree; vcl/wk draws it) — build it first with `mise run image` in plugins/libreoffice"
    }
}
workspace "01KXNW9K5HE8SA351748KG6GFA" {
}
