// vim: set filetype=kdl :
// Hardware MIDI into a step sequencer. A physical keyboard drives the on-screen
// piano (which lights the notes and passes them through); the piano feeds a
// sequencer that can record what you play and loop it back; the sequencer drives
// a synth.
//
// The `midiin` node opens the first connected MIDI input device (`wk midi
// devices` lists them; set a name with the node's device field to pick one).
//
// Play the keyboard to hear it live. Hit Record (or R) on the sequencer and play
// — each note lands on the moving playhead, with its length, and passes through
// to the synth. Hit Play (or Space) to loop the pattern. Click empty space to
// draw a note; drag a note to move it, drag its right edge to resize, select and
// press Backspace to delete.
//
// From the repo root:  wk run example/midi.wk
import "../workspace.wk"
workspace "01KZKMAB00000000000000WS01" {
    node "piano" "01KZKMAE00000000000000PN04" {
        pos 444.58355712890625 47.561798095703125
        size 560.0 220.0
    }
    node "synth" "01KZKMAF00000000000000SY05" {
        pos 1029.6160888671875 289.2599182128906
        size 360.0 260.0
        options 0.30000001192092896 2.0 0.0 1800.0 3.0 0.019999999552965164 0.3499999940395355
    }
    node "sequencer" "01KZKMAG00000000000000SQ06" {
        pos 421.06134033203125 299.4991149902344
        size 560.0 320.0
        options 5.0 64.0 1.0 7.0 64.0 1.0 9.0 67.0 2.0 11.0 69.0 2.0 14.0 71.0 2.0
    }
    note "01KZKMAC00000000000000NT02" {
        text "Hardware MIDI -> piano -> sequencer -> synth.\n\nMIDI In opens a physical keyboard\n(a built-in host node). The piano\nlights the notes and passes them on.\n\nOn the sequencer: Record (R) captures\nwhat you play onto the playhead (with\nlength); Play (Space) loops it. Click\nto draw a note, drag to move, drag the\nedge to resize, Backspace to delete."
        pos 40.0 40.0
        size 340.0 250.0
    }
    midiin "" "01KZKMAD00000000000000MD03" {
        pos 60.0 330.0
        size 130.0 44.0
    }
    midi "01KZKMAD00000000000000MD03" "01KZKMAE00000000000000PN04"
    midi "01KZKMAE00000000000000PN04" "01KZKMAG00000000000000SQ06"
    midi "01KZKMAG00000000000000SQ06" "01KZKMAF00000000000000SY05"
}
