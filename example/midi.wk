// vim: set filetype=kdl :
// Hardware MIDI into a step sequencer. A physical keyboard drives the on-screen
// piano (which lights the notes and passes them through); the piano feeds a
// sequencer that can record what you play and loop it back; the sequencer drives
// a synth.
//
// The `midiin` node opens the first connected MIDI input device (`wk midi
// devices` lists the inputs and outputs; set a name with the node's device
// field to pick one). `wk create midiout` adds the other direction: wire the
// sequencer to it and it plays an external synth instead of, or alongside, the
// software one.
//
// Every MIDI message carries the instant it belongs to, on a clock all nodes
// share. The sequencer schedules each note slightly ahead of the beat and the
// synth places it on its audio clock, so the tempo is the tempo rather than the
// frame rate rounded off. The sequencer is also the clock master: it sends MIDI
// clock, start and stop, so external gear can lock to it.
//
// Play the keyboard to hear it live. Hit Record (or R) and play — notes land
// where you played them, at the velocity you played them, with the length you
// held them. Hit Play (or Space) to loop.
//
// On the roll: click empty space to draw a note, drag it to move, drag its right
// edge to resize, Backspace to delete, arrow left/right to nudge, Cmd+Z to undo.
// Drag the BPM and LEN fields up and down to set the tempo and the pattern
// length. Drag in the velocity lane along the bottom to shape the dynamics.
// Arrow up/down scrolls the keyboard an octave at a time.
//
// From the repo root:  wk run example/midi.wk
import "../workspace.wk"
workspace "01KZKMAB00000000000000WS01" {
    node "piano" "01KZKMAE00000000000000PN04" {
        pos 444.58355712890625 47.561798095703125
        size 560.0 220.0
    }
    node "synth" "01KZKMAF00000000000000SY05" {
        pos 1029.6160888671875 289.2599182128906
        size 360.0 260.0
        options 0.30000001192092896 2.0 0.0 1800.0 3.0 0.019999999552965164 0.3499999940395355
    }
    node "sequencer" "01KZKMAG00000000000000SQ06" {
        pos 421.06134033203125 299.4991149902344
        size 720.0 420.0
        options -1.0 1.0 112.0 16.0 \
            0.0 52.0 2.0 112.0 \
            5.0 64.0 1.0 88.0 \
            7.0 64.0 1.0 68.0 \
            8.0 52.0 2.0 100.0 \
            9.0 67.0 2.0 104.0 \
            11.0 69.0 2.0 92.0 \
            14.0 71.0 2.0 120.0
    }
    note "01KZKMAC00000000000000NT02" {
        text "Hardware MIDI -> piano -> sequencer -> synth.\n\nMIDI In opens a physical keyboard\n(a built-in host node). The piano\nlights the notes and passes them on.\n\nEvery message carries the instant it\nbelongs to, so the sequencer keeps the\nclock's time and not the frame rate's.\n\nRecord (R) captures what you play,\nvelocity and length included.\nPlay (Space) loops it.\n\nClick to draw, drag to move, drag the\nedge to resize, Backspace to delete,\narrows to nudge, Cmd+Z to undo.\nDrag BPM and LEN to set the tempo and\nthe bar length; drag the lane at the\nbottom to shape the velocities."
        pos 40.0 40.0
        size 340.0 400.0
    }
    midiin "" "01KZKMAD00000000000000MD03" {
        pos 60.0 330.0
        size 130.0 44.0
    }
    midi "01KZKMAD00000000000000MD03" "01KZKMAE00000000000000PN04"
    midi "01KZKMAE00000000000000PN04" "01KZKMAG00000000000000SQ06"
    midi "01KZKMAG00000000000000SQ06" "01KZKMAF00000000000000SY05"
}
