// vim: set filetype=kdl :
import "../workspace.wk"
workspace "01KXKGD000000000000000WS00" {
    node "netserve" "01KXKGD000000000000000NS01" {
        pos 60.0 340.0
        size 380.0 240.0
        args "8080"
    }
    hostport "01KXKGD000000000000000HP02" {
        port 8080
        pos 532.2421875 395.64453125
        size 130.0 44.0
    }
    network "01KXKGD000000000000000NW03" {
        pos 528.7578125 526.84375
        size 130.0 44.0
    }
    note "01KXKGD000000000000000NT04" {
        text "Networking — the userspace fabric.\n\nnetserve is a BSD-sockets TCP\nserver on a virtual Network\n(isolated, like a Docker bridge).\n\nClick the netserve node's play\nbutton to start it (networked\nnodes stay idle until run). The\nHostPort publishes it to\nlocalhost:8080 — then:\n  curl localhost:8080"
        pos 42.76171875 18.06640625
        size 360.0 300.0
    }
    serve "01KXKGD000000000000000NS01" "01KXKGD000000000000000HP02"
    netlink "01KXKGD000000000000000NS01" "01KXKGD000000000000000NW03"
}
