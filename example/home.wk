// vim: set filetype=kdl :
// wk's home world — a VRChat-style plaza to exist in. The plaza is not built
// into wk: the `world` node below IS the place. It reads example/home.glb out
// of its own filesystem (the bind mount wired into it) and publishes the
// geometry through wk:scene as scenery — so the world arrives the same way
// the totem's crystal does, from a wasm node. Regenerate the .glb with
// `python3 scripts/gen-home-world.py` and it reloads under your feet.
//
// The other nodes carry free 3D poses (`pos3d x y z yaw`) placing them around
// the plaza's centre. Enter with:
//
//   wk run example/home.wk        then  Cmd+K -> "3D View"
//
// The piano is wired to the synth — walk up and play it.
// Build the world node first: cd plugins/world && mise run build
import "../workspace.wk"
workspace "01HQME0000000000000000WS00" {
    node "piano" "01HQME0000000000000000PN01" {
        pos 411.765625 25.94440460205078
        size 560.0 220.0
        pos3d -1.1133918762207031 -0.043125420808792114 -2.394958019256592 0.4351671636104584
    }
    node "paint" "01HQME0000000000000000PT03" {
        pos 466.27734375 316.80078125
        size 360.0 260.0
        pos3d 2.700000047683716 0.15000000596046448 0.8999999761581421 -1.8930000066757202
    }
    node "synth" "01HQME0000000000000000SY02" {
        pos 1010.0 40.0
        size 360.0 260.0
        pos3d 1.2999999523162842 0.10000000149011612 -2.299999952316284 -0.5139999985694885
        options 0.30000001192092896 2.0 0.0 1800.0 3.0 0.019999999552965164 0.3499999940395355
    }
    node "totem" "01HQME0000000000000000TM05" {
        pos 1010.0 320.0
        size 200.0 120.0
        pos3d 0.1311393529176712 -0.3173643946647644 3.482327699661255 2.814711570739746
    }
    // The plaza itself: a node with no panel in 3D (`panel3d #false`), sitting
    // at the world origin, whose only output is the ground you stand on.
    node "world" "01HQME0000000000000000WD06" {
        pos 40.0 340.0
        size 260.0 120.0
        pos3d 0.0 0.0 0.0 0.0
        panel3d #false
    }
    node "vim" "01KZXZB6DYFMS80ZBW479072WT" {
        pos 676.5054931640625 645.9148559570313
        size 360.0 260.0
        pos3d 0.08471228927373886 -0.49646806716918945 -3.010326623916626 -0.08040359616279602
    }
    node "bash" "01KZXZGD1FEBRRGATFJ7Z2VXD0" {
        pos 1042.1175537109375 528.32666015625
        size 360.0 260.0
    }
    bindmount "example/home.glb" "01HQME0000000000000000BM07" {
        pos 40.0 500.0
        size 220.0 120.0
    }
    note "01HQME0000000000000000NT04" {
        text "Welcome home.\n\nThis plaza is a node: `world`,\nwith example/home.glb wired in.\n\nRight-drag: look + WASD fly.\nGrab a card's label to move it\nanywhere; scroll pushes/pulls.\n\nThe piano feeds the synth:\nfocus it and play A W S E D F..."
        pos 40.0 40.0
        size 340.0 250.0
        pos3d 0.0 0.75 -2.9000000953674316 0.0
    }
    // The .glb into the world node: mounted at /home.glb, picked up as the
    // first glTF in its filesystem.
    connection "01HQME0000000000000000BM07" "01HQME0000000000000000WD06"
    midi "01HQME0000000000000000PN01" "01HQME0000000000000000SY02"
}
