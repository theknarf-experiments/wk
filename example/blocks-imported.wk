// vim: set filetype=kdl :
// example/blocks.wk with the `voice` definition moved out into example/voice.wk
// and imported. The tab below — the whole call site — is byte-for-byte what it
// was when the definition sat in the same file: a `group` names its definition,
// and an import is a file join, not a namespace.
//
// From the repo root:  wk run example/blocks-imported.wk
import "voice.wk"
workspace "01KZKMBK00000000000000WS01" {
    node "piano" "01KZKMBK00000000000000PN02" {
        pos 60.0 360.0
        size 560.0 220.0
    }
    note "01KZKMBK00000000000000NT09" {
        text "One definition, two instances.\n\n`voice` is a workspace with\n`tab #false`: an inport wired to\nan arp, wired to a synth.\n\nEach violet node below IS that\nworkspace, running. The piano is\nwired into both through their\n\"notes\" ports — drag from the\npiano's midi dot onto a voice's\ndot to wire another one."
        pos 60.0 60.0
        size 340.0 260.0
    }
    group "voice" "01KZKMBK00000000000000VC03" {
        in "notes" "01KZKMBK00000000000000PN02"
        pos 700.0 60.0
        size 220.0 100.0
    }
    group "voice" "01KZKMBK00000000000000VC04" {
        in "notes" "01KZKMBK00000000000000PN02"
        pos 700.0 260.0
        size 220.0 100.0
    }
}
