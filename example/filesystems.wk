// vim: set filetype=kdl :
// Nodes as filesystems — wk's FUSE (wk:fs), the full tour. Run with:
//
//   wk run example/filesystems.wk
//
// Every wire into an app below is a live mount: the node on the other end
// ANSWERS the filesystem operations. In the bash terminal, try:
//
//   cat /hellofuse/greeting              # unmodified libfuse hello.c — and
//                                        # the file's name/content came from
//                                        # the node's args (fuse_opt_parse)
//   ls -R /zip && cat /zip/readme.md     # a zip browsed in place (miniz)
//   echo hi > /peer/shared-notes.txt     # passfs re-exports ITS files —
//   cat /peer/shared-notes.txt           # ...writable, straight through
//   ls /peer/zipview                     # the SAME zip through TWO daemons:
//                                        # zipfs is mounted into passfs,
//                                        # whose passthrough re-exports it
//   cat /hellofs/counter                 # hellofs synthesizes per open
//   echo yo > /hellofs/pad.txt           # ...then check the kilo node —
//                                        # one provider, two consumers
//   ls /web && cat /web/hello.txt        # a network filesystem: httpfs
//                                        # mounts the `www` node's HTTP
//                                        # server, dialed BY NAME over the
//                                        # fabric (http://www:8000). `www` is
//                                        # what that node is CALLED; `python`
//                                        # is what it runs.
//
// The kilo node edits /hellofs/README.md — a full-screen editor opening,
// editing, and saving THROUGH another node's daemon. www and httpfs are
// networked nodes: if idle, press their play buttons (www first).
//
// Host-enforced read-only (the wire, not the daemon) is a token away:
//   wk -f example/filesystems.wk token attenuate bash \
//       'check if operation($k, $t, $a), $a != "write"'
// makes every mount read-only for bash (/peer writes start failing);
//   wk -f example/filesystems.wk token reset bash        # undo
//
// Also: open Files on the bash node and click into /zip or /peer — provider
// mounts browse live ("served by ..." badges), and selecting a bind wire
// shows its mount path, editable in place.
//
// Build the providers first (each is `mise run build` in its plugin dir):
// hellofuse, passfs, zipfs, httpfs, and hellofs (cargo component build).
// bash/python are docker:// deps from workspace.wk; kilo ships prebuilt.
import "../workspace.wk"
workspace "01KWFSDEM0000000000000WS00" {
    node "hellofuse" "01KWFSDEM0000000000000HF02" {
        pos 80.0 80.0
        size 300.0 160.0
        args "--name=greeting" "--contents=hello from argv\n"
    }
    node "httpfs" "01KWFSDEM0000000000000HT12" {
        pos 1342.670166015625 389.1455993652344
        size 300.0 160.0
        args "http://www:8000"
    }
    node "kilo" "01KWFSDEM0000000000000KE09" {
        pos 700.0 700.0
        size 560.0 340.0
        args "/hellofs/README.md"
    }
    node "hellofs" "01KWFSDEM0000000000000MF05" {
        pos 80.0 740.0
        size 300.0 160.0
    }
    node "passfs" "01KWFSDEM0000000000000PF04" {
        pos 80.0 520.0
        size 300.0 160.0
    }
    node "python" "01KWFSDEM0000000000000PY10" {
        name "www"
        pos 1428.74365234375 -17.591556549072266
        size 360.0 240.0
        args "/app/server.py" "8000"
    }
    node "bash" "01KWFSDEM0000000000000SH01" {
        pos 700.0 300.0
        size 560.0 340.0
    }
    node "zipfs" "01KWFSDEM0000000000000ZF03" {
        pos 80.0 300.0
        size 300.0 160.0
    }
    bindmount "example/demo-archive.zip" "01KWFSDEM0000000000000BM06" {
        pos 420.0 740.0
        size 220.0 120.0
    }
    bindmount "example/httpfs-www" "01KWFSDEM0000000000000BM11" {
        pos 1167.230224609375 -118.85794067382813
        size 220.0 120.0
    }
    volume "shared-notes.txt" "01KWFSDEM0000000000000V107" {
        pos 420.0 520.0
        size 220.0 120.0
    }
    network "01KWFSDEM0000000000000NW13" {
        pos 1802.34375 474.31268310546875
        size 130.0 44.0
    }
    note "01KWFSDEM0000000000000NT08" {
        text "Every wire into an app is a live mount:\nthe node on the other end answers\nopen/read/readdir like a FUSE daemon.\n\nhellofuse + passfs run libfuse's own\nexamples unmodified; hellofuse's file\ncomes from its args (fuse_opt_parse).\n\nThe zip is browsed in place — and\nreachable twice: at /zip, and THROUGH\npassfs at /peer/zipview (two daemons).\n\nhellofs serves bash AND kilo at once:\nkilo edits /hellofs/README.md through\nthe daemon; bash watches it change.\n\nhttpfs mounts the `www` node's HTTP\nserver over the fabric, by name —\n`www` is what it is called, `python`\nis what it runs.\nwww + httpfs are networked: press\ntheir play buttons if idle."
        pos 700.0 40.0
        size 400.0 240.0
    }
    // Feeds: the archive into zipfs, the volume into passfs, the server
    // script into python. And zipfs into passfs — a provider mounted inside
    // another provider, re-exported one level deeper.
    connection "01KWFSDEM0000000000000BM06" "01KWFSDEM0000000000000ZF03"
    connection "01KWFSDEM0000000000000V107" "01KWFSDEM0000000000000PF04"
    connection "01KWFSDEM0000000000000BM11" "01KWFSDEM0000000000000PY10" "/app"
    connection "01KWFSDEM0000000000000ZF03" "01KWFSDEM0000000000000PF04" "/zipview"
    // Provider mounts into the consumers, each at its own path.
    connection "01KWFSDEM0000000000000HF02" "01KWFSDEM0000000000000SH01" "/hellofuse"
    connection "01KWFSDEM0000000000000ZF03" "01KWFSDEM0000000000000SH01" "/zip"
    connection "01KWFSDEM0000000000000PF04" "01KWFSDEM0000000000000SH01" "/peer"
    connection "01KWFSDEM0000000000000MF05" "01KWFSDEM0000000000000SH01" "/hellofs"
    connection "01KWFSDEM0000000000000MF05" "01KWFSDEM0000000000000KE09" "/hellofs"
    connection "01KWFSDEM0000000000000HT12" "01KWFSDEM0000000000000SH01" "/web"
    // The http pair shares a fabric network; httpfs resolves "www" on it.
    netlink "01KWFSDEM0000000000000PY10" "01KWFSDEM0000000000000NW13"
    netlink "01KWFSDEM0000000000000HT12" "01KWFSDEM0000000000000NW13"
}
