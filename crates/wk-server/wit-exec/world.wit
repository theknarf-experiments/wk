package wk:exec;

/// Running another program from inside a node.
///
/// WASI has no `fork`/`exec`: a guest cannot create a process, which is why a
/// shell in a sandbox can only ever be a script engine. wk sits a level above
/// that — the host already instantiates components (that is what a node *is*,
/// and what a Dockerfile `RUN` step does) — so "run a program" is a capability
/// the host can offer rather than a syscall WASI has to grow.
///
/// The program is a wasm component read from the *calling node's own*
/// filesystem, so a base image that ships `/bin/coreutils.wasm` can run it.
/// The child shares the caller's filesystem — writes it makes are visible
/// afterwards, like a real child process on the same mount — and inherits the
/// caller's sandbox: it can reach nothing the caller could not, and its
/// authority is the caller's capability token (the `exec` kind, which
/// attenuation can withdraw).
interface process {
    use wasi:io/streams@0.2.12.{input-stream, output-stream};

    /// What a finished program left behind.
    record output {
        /// The child's exit status (0 = success), as `wasi:cli/exit` reports
        /// it; a trap or a failure to start is an `err` instead.
        exit-code: s32,
        stdout: list<u8>,
        stderr: list<u8>,
    }

    /// Run `path` to completion and collect its result. Blocks until the child
    /// exits — these are `exec` semantics without the `fork`, so the caller
    /// composes pipelines itself by feeding one program's `stdout` into the
    /// next one's `stdin`.
    ///
    /// `path` is resolved in the caller's filesystem. `argv` is the child's
    /// argv *in full*, including `argv[0]` — `execve` semantics, and what
    /// multicall binaries need: GNU coreutils and busybox both dispatch on
    /// `argv[0]`, so running `/bin/coreutils.wasm` with `argv[0] = "ls"` is
    /// how one binary provides a hundred commands. Errors (rather than an `output`) mean the
    /// program could not be run at all: no such file, not a component, the
    /// caller's token forbids `exec`, or too many nested `run`s.
    run: func(
        path: string,
        argv: list<string>,
        env: list<tuple<string, string>>,
        stdin: list<u8>,
    ) -> result<output, string>;

    /// A byte channel between two programs: a bounded buffer, written at one
    /// end and read at the other, which reports end-of-file once every writer
    /// has gone.
    ///
    /// This is what `run` cannot express. With `run` the producer must finish
    /// before the consumer starts, because the consumer's stdin *is* the
    /// producer's collected output — so `seq 1 100000 | head -1` would run to
    /// 100000, and `yes | head` would never finish at all. Handing the same
    /// pipe to two `spawn`s puts both children on it at once and lets the
    /// bytes move as they are written.
    resource pipe {
        constructor();

        /// The reading end, as an ordinary `wasi:io` stream.
        ///
        /// This is what lets a guest have a real `pipe()`: wasi-libc's
        /// descriptor table is a vtable, and a descriptor whose read and write
        /// streams are these is indistinguishable to libc from stdin or a
        /// socket — so `read`, `write`, `poll`, `close` and `dup` all work on
        /// the resulting file descriptor with no further help.
        ///
        /// Each call takes its own counted end; end-of-file is when the last
        /// one is dropped, whether it belonged to a child or to the caller.
        read-end: func() -> input-stream;

        /// The writing end. Dropping the last one is what closes the pipe.
        write-end: func() -> output-stream;
    }

    /// A program that is running now. Dropping the handle detaches it.
    resource child {
        /// Block until it exits, then report its status and whatever output
        /// was captured rather than piped elsewhere.
        wait: func() -> result<output, string>;
    }

    /// Where a spawned child's standard input comes from.
    variant stdin-from {
        /// Nothing at all: it reads end-of-file immediately.
        empty,
        /// These bytes, then end-of-file.
        bytes(list<u8>),
        /// The pipe's reading end.
        pipe-end(borrow<pipe>),
    }

    /// Where a spawned child's standard output or error goes.
    variant stdout-to {
        /// Collected, and handed back by `wait`.
        capture,
        /// The pipe's writing end. It closes when the child exits, which is
        /// what gives whoever reads the pipe its end-of-file.
        pipe-end(borrow<pipe>),
    }

    /// Start a program and return without waiting for it — `spawn` to `run`'s
    /// `system`. Resolution of `path` and `argv` is exactly as for `run`.
    ///
    /// Two children spawned onto the same pipe are a shell pipeline: the
    /// shell's own missing piece, since a pipeline stage cannot be run to
    /// completion before the next one starts.
    spawn: func(
        path: string,
        argv: list<string>,
        env: list<tuple<string, string>>,
        stdin: stdin-from,
        stdout: stdout-to,
        stderr: stdout-to,
    ) -> result<child, string>;
}

/// The host side: wk implements (imports) the process interface for plugins.
world exec-host {
    import process;
}
