plugins/qt-drumstickvpiano2111/tarballs/
plugins/qt-drumstickvpiano2111/src/
plugins/qt-drumstickvpiano2111/build/
plugins/qt-drumstickvpiano2111/gen/
plugins/qt-drumstickvpiano2111/logs/
plugins/qt-drumstickvpiano2111/*.wasm
plugins/qt-drumstickvpiano2111/harness/target/
# A copy of somebody else's font, staged by build.sh from whatever the machine
# has. Qt 6 ships no fonts and a wk node has no host font dir, so the app
# compiles one in as a Qt resource -- but the file itself is not ours to commit.
plugins/qt-drumstickvpiano2111/fonts/

