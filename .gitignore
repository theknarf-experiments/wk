# Created by https://www.toptal.com/developers/gitignore/api/rust,macos
# Edit at https://www.toptal.com/developers/gitignore?templates=rust,macos

### macOS ###
# General
.DS_Store
.AppleDouble
.LSOverride

# Icon must end with two \r
Icon


# Thumbnails
._*

# Files that might appear in the root of a volume
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Directories potentially created on remote AFP share
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

### macOS Patch ###
# iCloud generated files
*.icloud

### Rust ###
# Generated by Cargo
# will have compiled files and executables
debug/
target/


# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# End of https://www.toptal.com/developers/gitignore/api/rust,macos/target

# Generated by wit-bindgen / cargo-component (regenerated on every build)
plugins/*/src/bindings.rs

# Shared terminal shim: wit-bindgen output for wk:tty/control + cached adapter,
# regenerated by each C terminal plugin's build (only wit/ + the shim C is
# tracked).
plugins/tty-compat/gen/

# kilo build artifacts
plugins/kilo/kilo.wasm
plugins/kilo/kilo.core.wasm

# lua build artifacts (source fetched by build.sh, component built from it)
plugins/lua/lua-5.4.7/
plugins/lua/lua.wasm
plugins/lua/lua.core.wasm
plugins/lua/gen/

# sqlite build artifacts (amalgamation fetched by build.sh, component built from it)
plugins/sqlite/sqlite-amalgamation-*/
plugins/sqlite/sqlite3.wasm
plugins/sqlite/sqlite3.core.wasm
plugins/sqlite/gen/

# vim build artifacts (source fetched + auto/config generated by build.sh,
# objects/libs/adapter derived from it; only compat/ sources are tracked)
plugins/vim/vim-src/
plugins/vim/vim.wasm
plugins/vim/vim.core.wasm
plugins/vim/wkobj/
plugins/vim/compat/*.o
plugins/vim/compat/libwktcap.a
plugins/vim/compat/wasi_snapshot_preview1.command.wasm

# python (upstream CPython built from source for wasm32-wasip2 by build.sh; the
# checkout, staging prefix, component, and stdlib tree are all derived — only
# build.sh/Dockerfile/mise.toml/app are tracked)
plugins/python/cpython/
plugins/python/stage/
plugins/python/lib/
plugins/python/python.wasm

# php (upstream PHP built from source for wasm32-wasip2 by build.sh; source +
# fetched upstream patches derived — only build.sh/Dockerfile/mise.toml/patches/
# and the example are tracked)
plugins/php/php-8.2.6/
plugins/php/.patches/
plugins/php/php.wasm
plugins/php/deps/
plugins/php/sqlite-amalgamation-*/

# fetch (networked C client) build artifact
plugins/fetch/fetch.wasm

# stray literal-tilde dir from tools that mis-expand $HOME
/~/

# netserve (TCP server example) build artifact
plugins/netserve/netserve.wasm

# udpecho (UDP echo example) build artifact
plugins/udpecho/udpecho.wasm

# echo6 (IPv6 echo example) build artifact
plugins/echo6/echo6.wasm

# HostMappedFile artifacts: `add_host_mapped_file` currently creates its backing
# file (`host<n>`) relative to the process cwd, so they land at the repo root
# when wk runs from here. Ignore them until that's fixed to resolve against the
# workspace file's directory.
/host[0-9]*

# recorder example output (written at runtime)
example/out.mjpeg

# token-service root signing keys (one per workspace, beside its .wk) — secrets
*.wk.key

# machine-specific) — only setup.sh is tracked


# curl (upstream source fetched + built by build.sh; component is derived)
plugins/curl/curl-*/
plugins/curl/curl.wasm

# coreutils (upstream source fetched + built by build.sh; artifacts derived)
plugins/coreutils/coreutils-*/
plugins/coreutils/coreutils.wasm
plugins/coreutils/compat/*.o

# bash (upstream source fetched + built by build.sh; artifacts derived)
plugins/bash/bash-*/
plugins/bash/bash.wasm
plugins/bash/termutils.wasm
plugins/bash/compat/*.o
plugins/bash/compat/wasi_snapshot_preview1.command.wasm

# grep (upstream source fetched + built by build.sh; artifacts derived)
plugins/grep/grep-*/
plugins/grep/grep.wasm
plugins/grep/compat/*.o

# wk:exec shim: generated bindings + built artifacts
plugins/exec-compat/gen/
plugins/exec-compat/*.wasm
plugins/pipe-compat/*.wasm
plugins/pipe-compat/*.o

# bash: the coreutils + grep copies + its symlink farm are staged by build.sh
plugins/bash/coreutils.wasm
plugins/bash/grep.wasm
plugins/bash/bin/

# doctools (pandoc fetched from its upstream CI deploy + componentized by
# build.sh; the symlink farm is staged; the TeX build tree is derived)
plugins/doctools/pandoc-core.wasm
plugins/doctools/pandoc.wasm
plugins/doctools/pdftex.wasm
plugins/doctools/adapter/
plugins/doctools/bin/
plugins/doctools/tex/
plugins/doctools/texmf/

# qt (upstream Qt 6 fetched + cross-built by build.sh: the tarballs, the
# extracted trees, the native host-tools build, and the wasip2 install prefix
# are all derived — only the build scripts, the toolchain file, the wk QPA
# plugin, patches/ and mise.toml are tracked)
plugins/qt/tarballs/
plugins/qt/src/
plugins/qt/host/
plugins/qt/build-host/
plugins/qt/build-target/
plugins/qt/sysroot/
plugins/qt/logs/
plugins/qt/*.wasm
# A copy of somebody else's font, staged by build-smoke.sh from whatever the
# machine has (DejaVu, Arial, Liberation). Qt 6 ships no fonts and a wk node
# has no host font dir, so the smoke app compiles one in as a Qt resource --
# but the file itself is not ours to commit.
plugins/qt/smoke/fonts/

# qt-torrentfileeditor103 (torrent-file-editor 1.0.3 as a wk node: upstream and
# the two extra Qt repos it needs are FETCHED by build.sh, never vendored;
# ./sysroot is this port's own Qt-module install prefix on top of
# plugins/qt/sysroot. Only build.sh, mise.toml, patches/, harness/ and
# PORTING.md are tracked)
plugins/qt-torrentfileeditor103/tarballs/
plugins/qt-torrentfileeditor103/src/
plugins/qt-torrentfileeditor103/build/
plugins/qt-torrentfileeditor103/sysroot/
plugins/qt-torrentfileeditor103/gen/
plugins/qt-torrentfileeditor103/logs/
plugins/qt-torrentfileeditor103/*.wasm
plugins/qt-torrentfileeditor103/harness/target/
# A copy of somebody else's font, staged by build.sh from whatever the machine
# has. Qt 6 ships no fonts and a wk node has no host font dir, so the app
# compiles one in as a Qt resource -- but the file itself is not ours to commit.
plugins/qt-torrentfileeditor103/fonts/

# qt-slate (Slate, the Qt Quick pixel-art editor, pinned to commit e5cf5b6).
# Upstream Slate + its gif-h submodule + qtdeclarative are FETCHED by build.sh,
# never vendored; the native host Qt (built only so that `qsb` exists), the
# wasip2 qtdeclarative install prefix, the wit-bindgen output and the node
# component are all derived. Only build*.sh, node/, patches/, harness/,
# Dockerfile, mise.toml and README.md are tracked.
plugins/qt-slatepixelarteditore5cf5b6c66f21d4e5a6f7c42f497b1d29115b432/tarballs/
plugins/qt-slatepixelarteditore5cf5b6c66f21d4e5a6f7c42f497b1d29115b432/src/
plugins/qt-slatepixelarteditore5cf5b6c66f21d4e5a6f7c42f497b1d29115b432/host/
plugins/qt-slatepixelarteditore5cf5b6c66f21d4e5a6f7c42f497b1d29115b432/build-host/
plugins/qt-slatepixelarteditore5cf5b6c66f21d4e5a6f7c42f497b1d29115b432/build-target/
plugins/qt-slatepixelarteditore5cf5b6c66f21d4e5a6f7c42f497b1d29115b432/sysroot/
plugins/qt-slatepixelarteditore5cf5b6c66f21d4e5a6f7c42f497b1d29115b432/gen/
plugins/qt-slatepixelarteditore5cf5b6c66f21d4e5a6f7c42f497b1d29115b432/logs/
plugins/qt-slatepixelarteditore5cf5b6c66f21d4e5a6f7c42f497b1d29115b432/*.wasm
plugins/qt-slatepixelarteditore5cf5b6c66f21d4e5a6f7c42f497b1d29115b432/harness/target/
plugins/qt-slatepixelarteditore5cf5b6c66f21d4e5a6f7c42f497b1d29115b432/harness/Cargo.lock
# A copy of somebody else's font, staged by build.sh from whatever the machine
# has. Qt 6 ships no fonts and a wk node has no host font dir, so the component
# compiles one in under :/wkfonts as the platform's default family -- but the
# file itself is not ours to commit.
plugins/qt-slatepixelarteditore5cf5b6c66f21d4e5a6f7c42f497b1d29115b432/node/fonts/
